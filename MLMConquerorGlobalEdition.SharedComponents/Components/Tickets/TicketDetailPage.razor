@inject HttpClient Http
@inject IViewContextService ViewContext
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

@using Microsoft.AspNetCore.Components.Forms
@using MLMConquerorGlobalEdition.SharedComponents.Constants

<BreadcrumbNav Items="@_breadcrumb" />

<LoadingSpinner IsLoading="@_isLoading" />

@if (!_isLoading && _ticket is not null)
{
    <div class="row g-3">

        <!-- ── Left column: ticket info + comments ─────────────────────── -->
        <div class="col-12 col-lg-8">

            <!-- Ticket header card -->
            <div class="card mb-3">
                <div class="card-header d-flex align-items-center justify-content-between py-3 flex-wrap gap-2">
                    <h6 class="card-title mb-0 fw-semibold">
                        @(string.IsNullOrWhiteSpace(_ticket.TicketNumber)
                            ? $"#{(_ticket.Id.Length >= 8 ? _ticket.Id[..8] : _ticket.Id)}"
                            : _ticket.TicketNumber)
                        — @_ticket.Subject
                    </h6>
                    <div class="d-flex gap-2 align-items-center">
                        @if (_ticket.EscalationLevel > 1)
                        {
                            <StatusBadge Status="@EscalationLabel(_ticket.EscalationLevel)" />
                        }
                        <StatusBadge Status="@_ticket.Priority" />
                        <StatusBadge Status="@_ticket.Status" />
                    </div>
                </div>
                <div class="card-body">
                    <p class="mb-3 ticket-body">@((MarkupString)(_ticket.Body ?? string.Empty))</p>
                    <div class="row g-2 text-muted small">
                        <div class="col-12 col-sm-6">
                            @L["TicketDetail.LabelCategory"]: <strong class="text-body">@(string.IsNullOrWhiteSpace(_ticket.CategoryName) ? "—" : _ticket.CategoryName)</strong>
                        </div>
                        <div class="col-12 col-sm-6">
                            @L["TicketDetail.LabelPriority"]: <strong class="text-body">@_ticket.Priority</strong>
                        </div>
                        <div class="col-12 col-sm-6">
                            @L["TicketDetail.LabelAssignedTo"]: <strong class="text-body">@(string.IsNullOrWhiteSpace(_ticket.AssignedToUserId) ? L["TicketDetail.Unassigned"].Value : _ticket.AssignedToUserId)</strong>
                        </div>
                        <div class="col-12 col-sm-6">
                            @L["TicketDetail.LabelCreated"]: <strong class="text-body">
                                @(_ticket.CreationDate == default ? "—" : _ticket.CreationDate.ToString("MMM dd, yyyy HH:mm"))
                            </strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Attachments -->
            <div class="card mb-3">
                <div class="card-header py-3 d-flex align-items-center justify-content-between">
                    <h6 class="card-title mb-0 fw-semibold">
                        @L["TicketDetail.AttachmentsHeader"] (@_attachments.Count)
                    </h6>
                </div>
                <div class="card-body">
                    @if (_attachments.Count == 0)
                    {
                        <div class="text-center py-3 text-muted small">@L["TicketDetail.NoAttachments"]</div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush mb-3">
                            @foreach (var att in _attachments)
                            {
                                <li @key="att.Id" class="list-group-item d-flex align-items-center justify-content-between px-0">
                                    <div class="d-flex align-items-center gap-2 text-truncate">
                                        <i class="@AttachmentIcon(att.ContentType, att.FileName) fs-5 text-secondary"></i>
                                        <a href="@att.DownloadUrl" target="_blank" rel="noopener" class="text-truncate" title="@att.FileName">
                                            @att.FileName
                                        </a>
                                    </div>
                                    <div class="d-flex align-items-center gap-3 small text-muted ms-2">
                                        <span class="text-nowrap">@FormatSize(att.FileSizeBytes)</span>
                                        <span class="d-none d-sm-inline text-nowrap">
                                            @(att.CreationDate == default ? "—" : att.CreationDate.ToString("MMM dd, HH:mm"))
                                        </span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }

                    <!-- Upload control -->
                    <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2">
                        <InputFile OnChange="OnFileSelectedAsync" class="form-control form-control-sm"
                                   accept=".jpg,.jpeg,.png,.gif,.webp,.pdf,.doc,.docx,.txt"
                                   disabled="@_uploading" />
                        @if (_uploading)
                        {
                            <span class="d-flex align-items-center gap-1 small text-muted">
                                <span class="spinner-border spinner-border-sm"></span>
                                @L["TicketDetail.AttachmentUpload"]…
                            </span>
                        }
                    </div>
                    <div class="form-text mt-1">@L["TicketDetail.AttachmentHelp"]</div>

                    @if (!string.IsNullOrEmpty(_attachmentError))
                    {
                        <div class="alert alert-danger py-2 px-3 small mt-2 mb-0">@_attachmentError</div>
                    }
                </div>
            </div>

            <!-- Comments thread -->
            <div class="card">
                <div class="card-header py-3">
                    <h6 class="card-title mb-0 fw-semibold">
                        @string.Format(L["TicketDetail.CommentsHeader"], _comments.Count)
                    </h6>
                </div>
                <div class="card-body p-0">
                    @if (_comments.Count == 0)
                    {
                        <div class="text-center py-4 text-muted small">@L["TicketDetail.NoComments"]</div>
                    }
                    else
                    {
                        @foreach (var c in _comments)
                        {
                            <div @key="c.Id" class="border-bottom p-3 @(c.IsStaff ? "bg-light" : "")">
                                <div class="d-flex justify-content-between align-items-center small text-muted mb-1">
                                    <div>
                                        <strong class="text-body">@(string.IsNullOrWhiteSpace(c.Author) ? c.AuthorId : c.Author)</strong>
                                        @if (c.IsStaff)
                                        {
                                            <span class="badge bg-secondary ms-2">@L["TicketDetail.StaffBadge"]</span>
                                        }
                                    </div>
                                    <span>
                                        @(c.CreationDate == default ? "—" : c.CreationDate.ToString("MMM dd, yyyy HH:mm"))
                                    </span>
                                </div>
                                <p class="mb-0 small">@c.Body</p>
                            </div>
                        }
                    }
                </div>
                <!-- Add comment footer -->
                <div class="card-footer">
                    <textarea class="form-control mb-2"
                              rows="3"
                              placeholder="@L["TicketDetail.CommentPlaceholder"]"
                              @bind="_newComment"></textarea>
                    <button class="btn btn-primary btn-sm"
                            @onclick="AddCommentAsync"
                            disabled="@_savingComment">
                        @if (_savingComment)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        @L["TicketDetail.PostComment"]
                    </button>
                </div>
            </div>
        </div>

        <!-- ── Right column: actions sidebar ──────────────────────────── -->
        <div class="col-12 col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h6 class="fw-semibold mb-3">@L["TicketDetail.ActionsHeader"]</h6>
                    <div class="d-grid gap-2">

                        <!-- Status change (admin only) -->
                        <AdminOnlyWrapper Permission="@Permissions.Ticket.Resolve">
                            <div class="border rounded p-2">
                                <label class="form-label small mb-1 fw-semibold">@L["TicketDetail.StatusLabel"]</label>
                                <div class="d-flex gap-1">
                                    <select class="form-select form-select-sm flex-grow-1"
                                            @bind="_selectedStatus" disabled="@_busyStatus">
                                        <option value="Open">@L["Tickets.StatusOpen"]</option>
                                        <option value="InProgress">@L["Tickets.StatusInProgress"]</option>
                                        <option value="WaitingForUser">@L["TicketDetail.StatusWaitingForUser"]</option>
                                        <option value="Resolved">@L["Tickets.StatusResolved"]</option>
                                        <option value="Closed">@L["Tickets.StatusClosed"]</option>
                                    </select>
                                    <button class="btn btn-sm btn-primary"
                                            @onclick="ChangeStatusAsync"
                                            disabled="@(_busyStatus || _selectedStatus == _ticket.Status)">
                                        @if (_busyStatus)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else
                                        {
                                            <i class="ri-save-line"></i>
                                        }
                                    </button>
                                </div>
                            </div>
                        </AdminOnlyWrapper>

                        <!-- Assign -->
                        <AdminOnlyWrapper Permission="@Permissions.Ticket.Assign">
                            @if (_showAssignForm)
                            {
                                <div class="border rounded p-2 mb-1">
                                    <label class="form-label small mb-1">@L["TicketDetail.AssignLabel"]</label>
                                    <input class="form-control form-control-sm mb-2"
                                           placeholder="@L["TicketDetail.AssignPlaceholder"]"
                                           @bind="_assignTarget" />
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-sm btn-primary flex-grow-1"
                                                @onclick="AssignTicketAsync"
                                                disabled="@_busyAssign">
                                            @if (_busyAssign)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                            }
                                            @L["TicketDetail.AssignConfirm"]
                                        </button>
                                        <button class="btn btn-sm btn-secondary"
                                                @onclick="@(() => _showAssignForm = false)">
                                            @L["TicketDetail.AssignCancel"]
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button class="btn btn-outline-secondary btn-sm"
                                        @onclick="@(() => _showAssignForm = true)">
                                    <i class="ri-user-add-line me-1"></i>@L["TicketDetail.AssignAgent"]
                                </button>
                            }
                        </AdminOnlyWrapper>

                        <!-- Resolve -->
                        <AdminOnlyWrapper Permission="@Permissions.Ticket.Resolve">
                            <button class="btn btn-success btn-sm"
                                    @onclick="@(() => _showResolveModal = true)">
                                <i class="ri-check-double-line me-1"></i>@L["TicketDetail.ResolveTicket"]
                            </button>
                        </AdminOnlyWrapper>

                        <!-- Merge -->
                        <AdminOnlyWrapper Permission="@Permissions.Ticket.Merge">
                            <button class="btn btn-outline-secondary btn-sm">
                                <i class="ri-git-merge-line me-1"></i>@L["TicketDetail.MergeTicket"]
                            </button>
                        </AdminOnlyWrapper>

                        <!-- Escalate dropdown -->
                        <AdminOnlyWrapper Permission="@Permissions.Ticket.EscalateToL2">
                            <div class="dropdown">
                                <button class="btn btn-outline-warning btn-sm dropdown-toggle w-100"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    <i class="ri-arrow-up-line me-1"></i>@L["TicketDetail.Escalate"]
                                </button>
                                <ul class="dropdown-menu w-100">
                                    @if (ViewContext.HasPermission(Permissions.Ticket.EscalateToL2))
                                    {
                                        <li>
                                            <button class="dropdown-item"
                                                    @onclick="@(() => EscalateAsync(2))">
                                                @L["TicketDetail.EscalateLevel2"]
                                            </button>
                                        </li>
                                    }
                                    @if (ViewContext.HasPermission(Permissions.Ticket.EscalateToL3))
                                    {
                                        <li>
                                            <button class="dropdown-item"
                                                    @onclick="@(() => EscalateAsync(3))">
                                                @L["TicketDetail.EscalateLevel3"]
                                            </button>
                                        </li>
                                    }
                                    @if (ViewContext.HasPermission(Permissions.Ticket.EscalateToIT))
                                    {
                                        <li>
                                            <button class="dropdown-item text-danger"
                                                    @onclick="@(() => EscalateAsync(4))">
                                                @L["TicketDetail.EscalateIT"]
                                            </button>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </AdminOnlyWrapper>

                    </div>
                </div>
            </div>
        </div>

    </div>
}

<!-- Resolve confirm modal -->
@if (_showResolveModal)
{
    <ConfirmModal IsVisible="true"
                  Title="@L["TicketDetail.ResolveModalTitle"]"
                  Message="@L["TicketDetail.ResolveModalMessage"]"
                  ConfirmLabel="@L["TicketDetail.ResolveModalConfirm"]"
                  ConfirmColor="success"
                  IsBusy="@_busyResolve"
                  OnConfirm="ResolveTicketAsync"
                  OnCancel="@(() => _showResolveModal = false)" />
}

@code {
    [Parameter, EditorRequired] public string TicketId        { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string MemberProfileId { get; set; } = string.Empty;

    private bool   _isLoading     = true;
    private bool   _savingComment;
    private bool   _showResolveModal;
    private bool   _busyResolve;
    private bool   _showAssignForm;
    private bool   _busyAssign;
    private bool   _busyStatus;
    private bool   _uploading;
    private string _newComment       = string.Empty;
    private string _assignTarget     = string.Empty;
    private string _selectedStatus   = string.Empty;
    private string _attachmentError  = string.Empty;

    /// <summary>Maximum upload size — 10 MB. Mirrors the limit enforced by the API endpoints.</summary>
    private const long MaxAttachmentSizeBytes = 10_000_000;

    private TicketDetailModel? _ticket;
    private List<TicketCommentItem>    _comments    = new();
    private List<TicketAttachmentItem> _attachments = new();

    /// <summary>True when the current viewer has admin permissions for tickets.</summary>
    // Routing context is derived from the URL path, not from permissions: the same
    // shared component is rendered by both AdminWeb (HttpClient → AdminAPI 7002) and
    // BizCenterWeb (HttpClient → BizCenter API 7003). The route segment decides which
    // REST endpoint to hit; permission checks below still gate admin-only UI actions.
    private bool IsAdminContext => Nav.Uri.Contains("/admin/", StringComparison.OrdinalIgnoreCase);
    private bool CanManageTicket => ViewContext.HasPermission(Permissions.Ticket.ViewAll);

    /// <summary>Base path for ticket endpoints — admin users use /admin/tickets, members use /bizcenter/tickets.</summary>
    private string TicketsBasePath => IsAdminContext ? "api/v1/admin/tickets" : "api/v1/bizcenter/tickets";

    private List<BreadcrumbNav.BreadcrumbItem> _breadcrumb => new()
    {
        new(L["TicketDetail.BreadcrumbHome"].Value,    IsAdminContext ? "/admin" : "/dashboard"),
        new(L["TicketDetail.BreadcrumbTickets"].Value, IsAdminContext ? "/admin/tickets" : "/tickets"),
        new($"#{_ticket?.TicketNumber ?? (TicketId.Length >= 8 ? TicketId[..8] : TicketId)}")
    };

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(TicketId)) return;
        await LoadTicketAsync();
    }

    private async Task LoadTicketAsync()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<TicketDetailModel>>(
                $"{TicketsBasePath}/{TicketId}");

            if (response?.Success == true && response.Data is not null)
            {
                _ticket          = response.Data;
                _comments        = response.Data.Comments    ?? new();
                _attachments     = response.Data.Attachments ?? new();
                _selectedStatus  = _ticket.Status;
            }
        }
        catch { /* silently degrade */ }
        finally { _isLoading = false; }
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        var browserFile = e.File;
        if (browserFile is null) return;

        _attachmentError = string.Empty;

        if (browserFile.Size > MaxAttachmentSizeBytes)
        {
            _attachmentError = L["TicketDetail.AttachmentHelp"];
            StateHasChanged();
            return;
        }

        _uploading = true;
        try
        {
            using var content = new MultipartFormDataContent();
            // OpenReadStream uses MaxAttachmentSizeBytes as the upper bound; values
            // above that throw before any bytes hit the wire.
            var stream = browserFile.OpenReadStream(MaxAttachmentSizeBytes);
            var streamContent = new StreamContent(stream);
            if (!string.IsNullOrEmpty(browserFile.ContentType))
            {
                streamContent.Headers.ContentType =
                    new System.Net.Http.Headers.MediaTypeHeaderValue(browserFile.ContentType);
            }

            // Field name "file" must match the controllers' [FromForm] IFormFile parameter.
            content.Add(streamContent, "file", browserFile.Name);

            var response = await Http.PostAsync($"{TicketsBasePath}/{TicketId}/attachments", content);

            if (response.IsSuccessStatusCode)
            {
                await LoadTicketAsync();
            }
            else
            {
                _attachmentError = L["TicketDetail.AttachmentHelp"];
            }
        }
        catch (Exception ex)
        {
            _attachmentError = ex.Message;
        }
        finally
        {
            _uploading = false;
        }
    }

    private static string FormatSize(long bytes)
    {
        if (bytes <= 0) return "0 B";
        string[] units = { "B", "KB", "MB", "GB" };
        var unit = 0;
        double size = bytes;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }
        return unit == 0
            ? $"{(long)size} {units[unit]}"
            : $"{size:0.#} {units[unit]}";
    }

    private static string AttachmentIcon(string contentType, string fileName)
    {
        var ct = (contentType ?? string.Empty).ToLowerInvariant();
        if (ct.StartsWith("image/")) return "ri-image-line";
        if (ct == "application/pdf") return "ri-file-pdf-line";
        if (ct.Contains("word") || ct.Contains("msword") || ct.Contains("officedocument")) return "ri-file-word-line";
        if (ct.StartsWith("text/")) return "ri-file-text-line";

        var ext = System.IO.Path.GetExtension(fileName ?? string.Empty).ToLowerInvariant();
        return ext switch
        {
            ".pdf"                                => "ri-file-pdf-line",
            ".doc" or ".docx"                     => "ri-file-word-line",
            ".txt"                                => "ri-file-text-line",
            ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" => "ri-image-line",
            _                                     => "ri-attachment-line"
        };
    }

    private async Task AddCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(_newComment)) return;
        _savingComment = true;
        try
        {
            await Http.PostAsJsonAsync($"{TicketsBasePath}/{TicketId}/comments",
                new { Content = _newComment });
            _newComment = string.Empty;
            await LoadTicketAsync();
        }
        catch { /* silently degrade */ }
        finally { _savingComment = false; }
    }

    private async Task ChangeStatusAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedStatus) || _ticket is null || _selectedStatus == _ticket.Status) return;
        if (!CanManageTicket) return;

        _busyStatus = true;
        try
        {
            // PUT /api/v1/admin/tickets/{ticketId} accepts { Status, Priority }
            await Http.PutAsJsonAsync($"api/v1/admin/tickets/{TicketId}",
                new { Status = ParseStatus(_selectedStatus) });
            await LoadTicketAsync();
        }
        catch { /* silently degrade */ }
        finally { _busyStatus = false; }
    }

    private static int? ParseStatus(string status) => status switch
    {
        "Open"           => 1,
        "InProgress"     => 2,
        "WaitingForUser" => 3,
        "Resolved"       => 4,
        "Closed"         => 5,
        _                => null
    };

    private async Task EscalateAsync(int level)
    {
        try { await Http.PostAsJsonAsync($"api/v1/admin/tickets/{TicketId}/assign", new { EscalationLevel = level }); }
        catch { /* silently degrade */ }
    }

    private async Task ResolveTicketAsync()
    {
        _busyResolve = true;
        try
        {
            await Http.PostAsJsonAsync($"api/v1/admin/tickets/{TicketId}/resolve", new { });
            _showResolveModal = false;
            await LoadTicketAsync();
        }
        catch { /* silently degrade */ }
        finally { _busyResolve = false; }
    }

    private async Task AssignTicketAsync()
    {
        if (string.IsNullOrWhiteSpace(_assignTarget)) return;
        _busyAssign = true;
        try
        {
            await Http.PostAsJsonAsync($"api/v1/admin/tickets/{TicketId}/assign",
                new { AssignedToUserId = _assignTarget });
            _assignTarget   = string.Empty;
            _showAssignForm = false;
            await LoadTicketAsync();
        }
        catch { /* silently degrade */ }
        finally { _busyAssign = false; }
    }

    private string EscalationLabel(int level) => level switch
    {
        1 => L["TicketDetail.EscalationLevel1"],
        2 => L["TicketDetail.EscalationLevel2"],
        3 => L["TicketDetail.EscalationLevel3"],
        4 => L["TicketDetail.EscalationIT"],
        _ => string.Format(L["TicketDetail.EscalationOther"], level)
    };

    // ── Data models that match backend payloads ───────────────────────────────
    // BizCenter:  TicketDetailDto (TicketDto + Comments)
    // Admin:      AdminTicketDetailDto (AdminTicketDto + Comments)
    // Both share these property names so the component can deserialize either.
    private class ApiResponse<T> { public bool Success { get; set; } public T? Data { get; set; } }

    private class TicketDetailModel
    {
        public string   Id               { get; set; } = string.Empty;
        public string   TicketNumber     { get; set; } = string.Empty;
        public string   Subject          { get; set; } = string.Empty;
        public string?  Body             { get; set; }
        public string   Status           { get; set; } = string.Empty;
        public string   Priority         { get; set; } = string.Empty;
        public string?  CategoryName     { get; set; }
        public string?  AssignedToUserId { get; set; }
        public int      EscalationLevel  { get; set; }
        public DateTime CreationDate     { get; set; }
        public List<TicketCommentItem>?    Comments    { get; set; }
        public List<TicketAttachmentItem>? Attachments { get; set; }
    }

    private class TicketCommentItem
    {
        public long     Id           { get; set; }
        public string   AuthorId     { get; set; } = string.Empty;
        public string   Author       { get; set; } = string.Empty;
        public string   Body         { get; set; } = string.Empty;
        public bool     IsStaff      { get; set; }
        public DateTime CreationDate { get; set; }
    }

    private class TicketAttachmentItem
    {
        public long     Id            { get; set; }
        public string   FileName      { get; set; } = string.Empty;
        public long     FileSizeBytes { get; set; }
        public string   ContentType   { get; set; } = string.Empty;
        public string   DownloadUrl   { get; set; } = string.Empty;
        public DateTime CreationDate  { get; set; }
        public string   UploadedBy    { get; set; } = string.Empty;
    }
}
