@inject HttpClient Http
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<div class="card">
    <div class="card-header py-3">
        <h6 class="card-title mb-0 fw-semibold">@L["Ranks.HistoryTitle"]</h6>
    </div>
    <div class="card-body p-0">
        @if (_downloadError)
        {
            <div class="alert alert-danger m-3 mb-0">@L["Ranks.CertificateDownloadFailed"]</div>
        }
        <LoadingSpinner IsLoading="@_isLoading" />
        @if (!_isLoading)
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead>
                        <tr>
                            <th>@L["Ranks.ColAchievedDate"]</th>
                            <th>@L["Ranks.ColRank"]</th>
                            <th>@L["Ranks.ColPreviousRank"]</th>
                            <th>@L["Ranks.ColCertificate"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!_items.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">@L["Common.NoDataAvailable"]</td></tr>
                        }
                        @foreach (var r in _items)
                        {
                            <tr>
                                <td>@r.AchievedAt.ToString("MMM dd, yyyy")</td>
                                <td><span class="badge bg-warning text-dark">@r.RankName</span></td>
                                <td>@(string.IsNullOrEmpty(r.PreviousRankName) ? "—" : r.PreviousRankName)</td>
                                <td>
                                    @* El API genera el certificado al pedirlo si todavía no existe. *@
                                    <button class="btn btn-sm btn-outline-primary" disabled="@(_downloading == r.Id)"
                                            @onclick="() => DownloadAsync(r.Id)">
                                        @if (_downloading == r.Id)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                        }
                                        else
                                        {
                                            <i class="ri-file-pdf-line me-1"></i>
                                        }
                                        @L["Common.Download"]
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_total > _pageSize)
            {
                var totalPages = (int)Math.Ceiling((double)_total / _pageSize);
                <div class="d-flex justify-content-center py-3">
                    <nav aria-label="@L["Ranks.HistoryPaginationAria"]">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(_page <= 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(_page - 1)" aria-label="@L["Common.Previous"]">&#x2039;</button>
                            </li>
                            @for (var pg = 1; pg <= totalPages; pg++)
                            {
                                var p = pg;
                                <li class="page-item @(p == _page ? "active" : "")">
                                    <button class="page-link" @onclick="() => ChangePage(p)">@p</button>
                                </li>
                            }
                            <li class="page-item @(_page >= totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(_page + 1)" aria-label="@L["Common.Next"]">&#x203A;</button>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string MemberProfileId { get; set; } = string.Empty;
    [Parameter] public string ApiBaseUrl { get; set; } = "api/v1/bizcenter";

    private bool    _isLoading = true;
    private bool    _downloadError;
    private string? _downloading;
    private int     _page = 1, _pageSize = 10, _total;
    private List<RankHistoryDto> _items = new();

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(MemberProfileId)) return;
        await LoadPageAsync(1);
    }

    private async Task ChangePage(int page) => await LoadPageAsync(page);

    private async Task LoadPageAsync(int page)
    {
        _page = page;
        _isLoading = true;
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<PagedData<RankHistoryDto>>>(
                $"{ApiBaseUrl}/ranks/history?page={page}&pageSize={_pageSize}");
            if (response?.Success == true && response.Data is not null)
            {
                _items = response.Data.Items;
                _total = response.Data.TotalCount;
            }
        }
        catch { /* sin datos: la tabla dice que no hay */ }
        finally { _isLoading = false; }
    }

    /// <summary>
    /// El certificado se pide por el HttpClient (lleva el token; un enlace directo no lo llevaría) y se
    /// entrega al navegador con el módulo compartido <c>download.js</c> (sirve en cualquier portal).
    /// </summary>
    public const string DownloadModule = "./_content/MLMConquerorGlobalEdition.SharedComponents/js/download.js";

    private async Task DownloadAsync(string rankHistoryId)
    {
        _downloading = rankHistoryId;
        _downloadError = false;
        try
        {
            var response = await Http.GetAsync($"{ApiBaseUrl}/ranks/{rankHistoryId}/certificate");
            if (!response.IsSuccessStatusCode) { _downloadError = true; return; }
            var bytes = await response.Content.ReadAsByteArrayAsync();
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", DownloadModule);
            await module.InvokeVoidAsync("downloadFile", $"certificate-{rankHistoryId}.pdf", "application/pdf",
                Convert.ToBase64String(bytes));
        }
        catch { _downloadError = true; }
        finally { _downloading = null; }
    }

    // ── Contrato con el API (BizCenter RankHistoryDto en PagedResult) ──
    private class ApiResponse<T> { public bool Success { get; set; } public T? Data { get; set; } }
    private class PagedData<T>   { public List<T> Items { get; set; } = new(); public int TotalCount { get; set; } }

    private class RankHistoryDto
    {
        public string   Id               { get; set; } = string.Empty;
        public string   RankName         { get; set; } = string.Empty;
        public string?  PreviousRankName { get; set; }
        public DateTime AchievedAt       { get; set; }
    }
}
