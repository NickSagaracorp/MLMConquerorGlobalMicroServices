@inject HttpClient Http
@inject IViewContextService ViewContext
@inject IStringLocalizer<SharedResources> L

@using MLMConquerorGlobalEdition.SharedComponents.Constants

@if (!ViewContext.IsInAnyRole(AppRoles.Ambassador) && !ViewContext.IsAdminContext)
{
    <div class="alert alert-warning">@L["Ranks.OnlyForAmbassadors"]</div>
    return;
}

@if (ShowBreadcrumb)
{
    <BreadcrumbNav Items="@_breadcrumb" />
}

<LoadingSpinner IsLoading="@_isLoading" />

@if (!_isLoading && _rank is null)
{
    <div class="alert alert-danger">@L["Ranks.LoadFailed"]</div>
}

@if (!_isLoading && _rank is not null)
{
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-4">
            <StatCard Title="@L["Ranks.CurrentRank"]" Value="@Nombre(_rank.CurrentRankName)"
                      Icon="ri-medal-line" Color="warning" />
        </div>
        <div class="col-12 col-sm-4">
            <StatCard Title="@L["Ranks.NextRank"]" Value="@Nombre(_rank.NextRankName)"
                      Icon="ri-arrow-up-circle-line" Color="primary" />
        </div>
        <div class="col-12 col-sm-4">
            <StatCard Title="@L["Ranks.LifetimeRank"]" Value="@Nombre(_rank.LifetimeRankName)"
                      Icon="ri-trophy-line" Color="success" />
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header py-3">
            <h6 class="card-title mb-0 fw-semibold">@L["Ranks.ProgressTitle"]</h6>
        </div>
        <div class="card-body">
            @if (_requirements.Count == 0)
            {
                <p class="text-muted mb-0">@L["Ranks.TopRankReached"]</p>
            }
            @foreach (var req in _requirements)
            {
                var pct = (int)Math.Min(100m, req.Current * 100m / req.Required);
                <div class="mb-3">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="fw-medium">@req.Label</span>
                        <span class="text-muted">@req.Current.ToString("N0") / @req.Required.ToString("N0")</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-primary" role="progressbar"
                             style="width: @(pct)%;"
                             aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="text-end small text-muted mt-1">@(pct)%</div>
                </div>
            }
        </div>
    </div>

    @if (ShowHistory)
    {
        <RankHistoryTable MemberProfileId="@MemberProfileId" ApiBaseUrl="@ApiBaseUrl" />
    }
}

@code {
    [Parameter, EditorRequired] public string MemberProfileId { get; set; } = string.Empty;

    /// <summary>Raíz del API: el BizCenter usa el miembro del token; el admin, la ruta del miembro
    /// (<c>api/v1/admin/members/{id}</c>).</summary>
    [Parameter] public string ApiBaseUrl     { get; set; } = "api/v1/bizcenter";
    [Parameter] public bool   ShowBreadcrumb { get; set; } = true;

    /// <summary>El historial y la descarga de certificados solo existen bajo la raíz del BizCenter.</summary>
    [Parameter] public bool   ShowHistory    { get; set; } = true;

    private bool _isLoading = true;
    private RankDashboardDto? _rank;
    private List<RequirementRow> _requirements = new();

    private List<BreadcrumbNav.BreadcrumbItem> _breadcrumb => new()
    {
        new(L["Ranks.BreadcrumbHome"].Value, "/dashboard"),
        new(L["Nav.Ranks"].Value)
    };

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(MemberProfileId)) return;
        _isLoading = true;
        _rank = null;

        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<RankDashboardDto>>($"{ApiBaseUrl}/ranks/dashboard");
            if (response?.Success == true && response.Data is not null)
            {
                _rank = response.Data;
                _requirements = Requisitos(_rank);
            }
        }
        catch { /* se muestra Ranks.LoadFailed */ }
        finally { _isLoading = false; }
    }

    /// <summary>
    /// Las barras van contra el próximo rango: puntos elegibles (el servidor ya los topa en el umbral)
    /// sobre el umbral. Una dimensión con umbral 0 no aplica a ese rango; sin próximo rango no hay barras.
    /// </summary>
    private List<RequirementRow> Requisitos(RankDashboardDto d)
    {
        if (!TieneNombre(d.NextRankName)) return new();
        var filas = new List<RequirementRow>();
        if (d.NextRankDualTeamPoints > 0)
            filas.Add(new(L["Ranks.DualTeamPoints"].Value, d.NextRankEligibleDualTeamPoints, d.NextRankDualTeamPoints));
        if (d.NextRankEnrollmentPoints > 0)
            filas.Add(new(L["Ranks.EnrollmentPoints"].Value, d.NextRankEligibleEnrollmentPoints, d.NextRankEnrollmentPoints));
        return filas;
    }

    // El admin devuelve "—" cuando no hay rango; el BizCenter, null.
    private static bool TieneNombre(string? nombre) => !string.IsNullOrWhiteSpace(nombre) && nombre != "—";
    private static string Nombre(string? nombre) => TieneNombre(nombre) ? nombre! : "—";

    // ── Contrato con el API (BizCenter RankDashboardDto / AdminMemberRanksController.RankDashboardDto) ──
    private class ApiResponse<T> { public bool Success { get; set; } public T? Data { get; set; } }

    private class RankDashboardDto
    {
        public string? CurrentRankName                  { get; set; }
        public string? NextRankName                     { get; set; }
        public string? LifetimeRankName                 { get; set; }
        public int     NextRankDualTeamPoints           { get; set; }
        public int     NextRankEnrollmentPoints         { get; set; }
        public int     NextRankEligibleDualTeamPoints   { get; set; }
        public int     NextRankEligibleEnrollmentPoints { get; set; }
    }

    private record RequirementRow(string Label, int Current, int Required);
}
