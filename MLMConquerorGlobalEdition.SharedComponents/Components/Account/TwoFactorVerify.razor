@* Formulario del segundo factor: pide el código de 6 dígitos y lo postea.

   No trae tarjeta ni fondo: eso lo pone la página que lo monta, que es la que conoce el
   aspecto de su portal. Aquí solo va el bloque del formulario, para que BizCenter y
   Administración compartan comportamiento sin compartir maquetación.

   El reto (ChallengeToken) no aparece por ninguna parte: viaja en una cookie HttpOnly que
   pone el manejador del POST. Este componente nunca lo ve ni lo necesita — tampoco en modo
   interactivo, donde no hay cookie y el reto se lo queda la página que hizo el login.

   DOS MODOS DE ENVÍO, UN SOLO CUERPO: sin OnSubmit postea a FormAction como siempre; con OnSubmit
   entrega el código sin recargar. Ver AccountForm.razor. El reenvío es un formulario aparte y
   tiene su propia devolución, OnResend, por la misma razón: son dos acciones distintas y cada una
   cambia de modo por su cuenta. *@

@inherits AccountFormComponentBase
@inject IStringLocalizer<SharedResources> L

<div class="two-factor-verify">

    <h5 class="mb-1">@L["TwoFactor.Title"]</h5>
    <p class="mb-1">@L["TwoFactor.Subtitle"]</p>

    @* Con el autenticador no hay destino que enseñar: el código no se envía a ningún sitio,
       lo genera la aplicación del propio teléfono. *@
    @if (IsAuthenticator)
    {
        <p class="text-muted small mb-3">@L["TwoFactor.UseAuthenticator"]</p>
    }
    else if (!string.IsNullOrWhiteSpace(MaskedTarget))
    {
        <p class="text-muted small mb-3">@string.Format((string)L["TwoFactor.SentTo"], MaskedTarget)</p>
    }
    else if (IsSms)
    {
        @* Sin destino conocido y con SMS, la frase se queda en el canal: es lo único que se
           puede afirmar con certeza y sigue siendo útil para saber dónde mirar. Con correo sin
           destino no se dice nada: la línea de arriba ya explica qué hay que hacer, y nombrar
           un buzón que no se sabe cuál es no ayuda a encontrarlo. *@
        <p class="text-muted small mb-3">@L["TwoFactor.SentToPhone"]</p>
    }

    @if (Resent)
    {
        <div class="alert alert-info" role="status">@L["TwoFactor.Resent"]</div>
    }

    @if (!string.IsNullOrWhiteSpace(ShownErrorCode))
    {
        <div class="alert alert-danger" role="alert">@L[TwoFactorMessages.ErrorKeyFor(ShownErrorCode)]</div>
    }

    <AccountForm Action="@FormAction" OnSubmit="@Submit">
        <div class="mb-3">
            <label class="form-label" for="two-factor-code">@L["TwoFactor.CodeLabel"]</label>
            @* inputmode="numeric" saca el teclado numérico en el móvil en lugar del alfabético.
               autocomplete="one-time-code" es lo que hace que el sistema operativo ofrezca
               rellenar el código que acaba de llegar por SMS sin copiarlo a mano. Los dos
               juntos se llevan casi toda la fricción de esta pantalla. *@
            <input @bind="Model.Code"
                   @bind:event="oninput"
                   id="two-factor-code"
                   name="Code"
                   type="text"
                   class="form-control"
                   inputmode="numeric"
                   autocomplete="one-time-code"
                   maxlength="6"
                   pattern="[0-9]{6}"
                   placeholder="@L["TwoFactor.CodePlaceholder"]"
                   required
                   autofocus />
            <small class="text-muted">@L["TwoFactor.CodeHint"]</small>
        </div>
        <button type="submit" class="btn btn-warning w-100 fw-semibold" disabled="@Submitting">@L["TwoFactor.Submit"]</button>
    </AccountForm>

    @* El botón de reenviar no existe para el autenticador: no hay nada que reenviar y pulsarlo
       gastaría cupo de emisiones sin llegar a enviar nada. *@
    @if (ShowResend)
    {
        <AccountForm Action="@ResendAction" OnSubmit="@Resend" class="mt-3 mb-0">
            <p class="mb-0 small">
                @L["TwoFactor.NoCodeQuestion"]
                <button type="submit" class="btn btn-link p-0 align-baseline text-decoration-none" disabled="@Submitting">
                    @L["TwoFactor.Resend"]
                </button>
            </p>
        </AccountForm>
    }

    @if (!string.IsNullOrWhiteSpace(CancelUrl))
    {
        <p class="mt-3 mb-0 small">
            <a href="@CancelUrl" class="text-decoration-none">@L["TwoFactor.Cancel"]</a>
        </p>
    }
</div>

@code {
    /// <summary>Ruta a la que postea el código. La pone el portal: cada uno tiene la suya.
    /// No hace falta con OnSubmit.</summary>
    [Parameter]
    public string? FormAction { get; set; }

    /// <summary>
    /// Envío interactivo del código. Sin asignar, el formulario postea a <see cref="FormAction"/>.
    /// </summary>
    [Parameter]
    public EventCallback<CodeFormModel> OnSubmit { get; set; }

    /// <summary>
    /// Ruta del reenvío. Si viene vacía no se ofrece reenviar, igual que con el autenticador.
    /// </summary>
    [Parameter]
    public string? ResendAction { get; set; }

    /// <summary>
    /// Reenvío interactivo. Asignarla también ofrece el botón de reenviar, igual que hace
    /// <see cref="ResendAction"/> en modo formulario: sin una de las dos no hay nada que pulsar.
    /// </summary>
    [Parameter]
    public EventCallback OnResend { get; set; }

    /// <summary>Canal del reto: <c>Email</c>, <c>Sms</c> o <c>Authenticator</c>.</summary>
    [Parameter]
    public string? Channel { get; set; }

    /// <summary>A dónde fue el código, ya enmascarado por la API. Vacío con el autenticador.</summary>
    [Parameter]
    public string? MaskedTarget { get; set; }

    /// <summary>Se acaba de reenviar un código.</summary>
    [Parameter]
    public bool Resent { get; set; }

    /// <summary>Enlace de salida hacia el login. Si viene vacío no se pinta.</summary>
    [Parameter]
    public string? CancelUrl { get; set; }

    /// <summary>Lo que hay escrito ahora mismo en el campo. Solo se usa en modo interactivo.</summary>
    private CodeFormModel Model { get; } = new();

    /// <summary>
    /// Se entrega una COPIA y no <see cref="Model"/>: la página se queda con lo que había cuando
    /// se pulsó el botón, y no con una referencia viva que siga cambiando mientras espera a la API.
    /// </summary>
    private EventCallback Submit => SubmitFor(
        OnSubmit, () => new CodeFormModel { Code = Model.Code });

    private EventCallback Resend => SubmitFor(OnResend);

    private bool IsAuthenticator => TwoFactorMessages.IsAuthenticator(Channel);

    private bool IsSms => TwoFactorMessages.IsSms(Channel);

    /// <summary>
    /// Se ofrece reenviar si hay por dónde hacerlo, sea la ruta del POST o la devolución
    /// interactiva. Con el autenticador nunca.
    /// </summary>
    private bool ShowResend =>
        !IsAuthenticator && (!string.IsNullOrWhiteSpace(ResendAction) || OnResend.HasDelegate);
}
