@* Página de aterrizaje tras cambiar la contraseña con éxito. Estática, con enlace al login. *@

@inject IStringLocalizer<SharedResources> L

<div class="reset-password-confirmation">

    <h5 class="mb-1">@L["ResetPasswordConfirmation.Title"]</h5>

    <div class="alert alert-success" role="status">@L["ResetPassword.SuccessMessage"]</div>

    @if (!string.IsNullOrWhiteSpace(LoginUrl))
    {
        <a href="@LoginUrl" class="btn btn-primary w-100 fw-semibold">@L["ResetPassword.GoToLogin"]</a>
    }
</div>

@code {
    /// <summary>Enlace de vuelta al login. Si viene vacío no se pinta el botón.</summary>
    [Parameter]
    public string? LoginUrl { get; set; }
}
