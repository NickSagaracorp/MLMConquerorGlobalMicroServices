@namespace MLMConquerorGlobalEdition.SharedComponents.Components.Account.StepUp
@using System.Globalization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@using MLMConquerorGlobalEdition.SharedComponents.Components.Account
@using MLMConquerorGlobalEdition.SharedComponents.Resources
@using MLMConquerorGlobalEdition.SharedKernel.Security
@implements IDisposable
@inject IServiceProvider Services
@inject IStringLocalizer<SharedResources> L

@* El z-index 1080 (por encima del 1055 de cualquier .modal de Bootstrap) es deliberado: este
   diálogo se abre DESDE otros modales (p. ej. el de edición de la wallet) y, sin él, quedaba detrás
   de su telón y no se podía usar. Aquí el propio contenedor es el telón. *@
@* Modal de confirmación por código. Un componente lo monta una vez y llama a RequireAsync cuando
   la API responde STEP_UP_REQUIRED; devuelve el permiso, o null si la persona cancela. *@
@if (_open)
{
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" style="z-index:1080;background:rgba(0,0,0,.5)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@L["StepUp.Title"]</h5>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">@L["StepUp.Why"]</p>
                    @if (_challenge is not null)
                    {
                        <p class="stepup-target">
                            @(TwoFactorMessages.IsAuthenticator(_challenge.Channel)
                                ? L["StepUp.AuthenticatorPrompt"].Value
                                : L["StepUp.SentTo", _challenge.MaskedTarget].Value)
                        </p>
                        <label class="form-label" for="stepup-code">@L["StepUp.CodeLabel"]</label>
                        <input id="stepup-code" class="form-control" inputmode="numeric" autocomplete="one-time-code"
                               maxlength="6" @bind="_code" @bind:event="oninput" disabled="@_busy" />
                    }
                    @if (_errorKey is not null)
                    {
                        <div class="alert alert-danger mt-3 mb-0 stepup-error" role="alert">@L[_errorKey, _errorArgs].Value</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link me-auto stepup-resend" @onclick="ResendAsync" disabled="@(_busy || _unavailable)">@L["StepUp.Resend"]</button>
                    @* Cancelar nunca se deshabilita: con una petición en vuelo tiene que poder cerrarse. *@
                    <button type="button" class="btn btn-outline-secondary stepup-cancel" @onclick="Cancel">@L["StepUp.Cancel"]</button>
                    <button type="button" class="btn btn-primary stepup-confirm" @onclick="ConfirmAsync"
                            disabled="@(_busy || _challenge is null || string.IsNullOrWhiteSpace(_code))">@L["StepUp.Confirm"]</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _open, _busy, _unavailable;
    private string? _operationKey, _code, _errorKey;
    private object[] _errorArgs = [];
    private StepUpChallenge? _challenge;
    private TaskCompletionSource<string?>? _pending;

    // Cada apertura es una "sesión". Una respuesta que llega después de cancelar, de reabrir o de
    // destruir el componente pertenece a una sesión vieja y se descarta: sin esto, un código de
    // una apertura anterior podría pintarse (o completar la espera) en la siguiente.
    private int _session;
    private bool _disposed;

    /// <summary>Abre el modal, manda el código y espera. Devuelve el permiso o null si se cancela.</summary>
    public async Task<string?> RequireAsync(string operationKey)
    {
        // Si alguien reabre con una espera viva, la anterior termina cancelada y no colgada.
        _pending?.TrySetResult(null);

        // El cliente se pide aquí y no por @inject: no todos los anfitriones lo registran (AdminWeb
        // y las apps MAUI montan el mismo panel de wallets, y la API de administración no pide
        // step-up). Sin cliente, un step-up pedido no se puede confirmar: se cancela, no revienta.
        if (_disposed) return null;

        var session = ++_session;
        // RunContinuationsAsynchronously: quien completa la espera (un clic) no debe ejecutar de
        // forma síncrona el código del llamador dentro del manejador del evento.
        var tcs = _pending = new TaskCompletionSource<string?>(TaskCreationOptions.RunContinuationsAsynchronously);
        _operationKey = operationKey;
        _challenge = null; _code = null; ClearError(); _busy = false;
        _open = true;
        if (Services.GetService<IStepUpClient>() is null)
        {
            // Sin cliente la persona no puede confirmar nada, pero tampoco puede quedarse sin
            // saberlo: el modal se abre con el aviso y se cierra con Cancelar (devuelve null).
            _unavailable = true;
            _errorKey = "StepUp.Unavailable";
            StateHasChanged();
            return await tcs.Task;
        }
        _unavailable = false;
        await RequestAsync(session);
        return await tcs.Task;
    }

    private Task ResendAsync() => RequestAsync(_session);

    private async Task RequestAsync(int session)
    {
        var client = Services.GetRequiredService<IStepUpClient>();
        _busy = true; ClearError(); _code = null; StateHasChanged();
        try
        {
            var r = await client.RequestChallengeAsync(_operationKey!);
            if (session != _session || _disposed) return;
            if (r.Success) _challenge = r.Data;
            else SetError(r.ErrorCode, r.Message);
        }
        catch (Exception) when (session == _session && !_disposed)
        {
            // Que el cliente lance no puede dejar el modal congelado: error genérico y a reintentar.
            SetError(null, null);
        }
        finally
        {
            if (session == _session && !_disposed) { _busy = false; StateHasChanged(); }
        }
    }

    private async Task ConfirmAsync()
    {
        var session = _session;
        var client = Services.GetRequiredService<IStepUpClient>();
        _busy = true; ClearError(); StateHasChanged();
        try
        {
            var r = await client.VerifyAsync(_operationKey!, _challenge!.ChallengeToken, _code!.Trim());
            if (session != _session || _disposed) return;
            if (r.Success && !string.IsNullOrEmpty(r.Data))
            {
                var pending = _pending;
                Close();
                pending?.TrySetResult(r.Data);
                return;
            }
            SetError(r.ErrorCode, r.Message);
        }
        catch (Exception) when (session == _session && !_disposed)
        {
            SetError(null, null);
        }
        finally
        {
            // Solo si la sesión sigue siendo esta: si ya se cerró o reabrió, el estado es de otra.
            if (session == _session && !_disposed) { _busy = false; StateHasChanged(); }
        }
    }

    private void Cancel()
    {
        var pending = _pending;
        Close();
        pending?.TrySetResult(null);
    }

    private void Close()
    {
        _session++; // invalida lo que siga en vuelo
        _open = false; _busy = false; _challenge = null; _code = null; ClearError();
        StateHasChanged();
    }

    private void ClearError() { _errorKey = null; _errorArgs = []; }

    private void SetError(string? errorCode, string? message)
    {
        _errorKey = StepUpMessages.ErrorKeyFor(errorCode);
        _errorArgs = [];

        // La espera tras un cambio de factor es el único error que trae un dato (hasta cuándo):
        // con la fecha la persona sabe cuándo volver; sin ella, el texto genérico.
        if (string.Equals(errorCode, StepUpGrant.CooldownErrorCode, StringComparison.OrdinalIgnoreCase)
            && StepUpClient.TryParseCooldownUntil(message) is { } until)
        {
            _errorKey = "StepUp.Cooldown";
            _errorArgs = [until.ToString("f", CultureInfo.CurrentCulture)];
        }
    }

    public void Dispose()
    {
        // Si el componente se destruye con la espera viva (cambio de página, circuito caído), el
        // llamador no puede quedarse esperando para siempre: termina como cancelado.
        _disposed = true;
        _session++;
        _pending?.TrySetResult(null);
    }
}
