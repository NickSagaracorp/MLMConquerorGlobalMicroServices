@* Página de aterrizaje tras enviar el formulario de "he olvidado mi contraseña".

   Estática a propósito: no hay nada que decidir aquí, solo enseñar el mismo mensaje ambiguo
   sin importar si la cuenta existía o no. No repite la dirección que se escribió —eso
   obligaría a habérsela pasado por la URL, y ya es un dato de más para una pantalla que no
   tiene que confirmar nada sobre esa cuenta. *@

@inject IStringLocalizer<SharedResources> L

<div class="forgot-password-confirmation">

    <h5 class="mb-1">@L["ForgotPasswordConfirmation.Title"]</h5>

    <div class="alert alert-success" role="status">@L["ForgotPassword.SuccessMessage"]</div>

    @if (!string.IsNullOrWhiteSpace(LoginUrl))
    {
        <a href="@LoginUrl" class="btn btn-outline-primary w-100 fw-semibold">@L["ForgotPassword.BackToLogin"]</a>
    }
</div>

@code {
    /// <summary>Enlace de vuelta al login. Si viene vacío no se pinta el botón.</summary>
    [Parameter]
    public string? LoginUrl { get; set; }
}
