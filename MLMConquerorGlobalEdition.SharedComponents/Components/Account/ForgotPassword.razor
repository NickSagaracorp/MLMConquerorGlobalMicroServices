@* Formulario de "he olvidado mi contraseña": un correo y un botón.

   Igual que TwoFactorVerify, no trae tarjeta ni fondo: la maquetación la pone la página que
   lo monta. El backend responde 200 tanto si la cuenta existe como si no —así evita que
   alguien use este formulario para averiguar qué direcciones están registradas— y este
   componente no hace nada que rompa esa cautela: nunca dice "te hemos enviado un correo",
   porque eso ya sería confirmar que la cuenta existe. El mensaje de verdad, el ambiguo, vive
   en ForgotPasswordConfirmation, la página a la que redirige el POST. *@

@inject IStringLocalizer<SharedResources> L

<div class="forgot-password">

    <h5 class="mb-1">@L["ForgotPassword.Title"]</h5>
    <p class="mb-3">@L["ForgotPassword.Subtitle"]</p>

    @if (!string.IsNullOrWhiteSpace(ErrorCode))
    {
        <div class="alert alert-danger" role="alert">@L[AccountMessages.ErrorKeyFor(ErrorCode)]</div>
    }

    <form method="post" action="@FormAction">
        <div class="mb-3">
            <label class="form-label" for="forgot-password-email">@L["ForgotPassword.EmailLabel"]</label>
            <input id="forgot-password-email"
                   name="Email"
                   type="email"
                   class="form-control"
                   autocomplete="email"
                   placeholder="@L["ForgotPassword.EmailPlaceholder"]"
                   required
                   autofocus />
        </div>
        <button type="submit" class="btn btn-primary w-100 fw-semibold">@L["ForgotPassword.SendButton"]</button>
    </form>

    @if (!string.IsNullOrWhiteSpace(CancelUrl))
    {
        <p class="mt-3 mb-0 small">
            <a href="@CancelUrl" class="text-decoration-none">@L["ForgotPassword.BackToLogin"]</a>
        </p>
    }
</div>

@code {
    /// <summary>Ruta a la que postea el correo. La pone el portal.</summary>
    [Parameter, EditorRequired]
    public string FormAction { get; set; } = string.Empty;

    /// <summary>Código de error de la API, tal cual llega por query string.</summary>
    [Parameter]
    public string? ErrorCode { get; set; }

    /// <summary>Enlace de salida hacia el login. Si viene vacío no se pinta.</summary>
    [Parameter]
    public string? CancelUrl { get; set; }
}
