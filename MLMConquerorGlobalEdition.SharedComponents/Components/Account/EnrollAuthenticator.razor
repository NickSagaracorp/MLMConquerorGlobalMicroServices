@* Alta de la aplicación autenticadora: QR, clave en claro y el primer código.

   Igual que TwoFactorVerify, no trae tarjeta ni fondo: la maquetación la pone la página.
   El EnrollmentToken vive en una cookie HttpOnly y no aparece aquí. En modo interactivo no hay
   cookie: el token se lo queda la página desde que abrió el enrolamiento, y este componente sigue
   sin verlo.

   DOS MODOS DE ENVÍO, UN SOLO CUERPO: sin OnSubmit postea a FormAction como siempre; con OnSubmit
   entrega el primer código sin recargar. Ver AccountForm.razor. *@

@inherits AccountFormComponentBase
@inject IStringLocalizer<SharedResources> L

<div class="enroll-authenticator">

    <p class="mb-2">@L["Enroll.Title"]</p>

    @* Quien nunca ha usado una aplicación de estas no sabe qué es el cuadrado que tiene
       delante. Los tres pasos van antes del QR, no después. *@
    <p class="text-muted small mb-3">@L["Enroll.Intro"]</p>

    @if (!string.IsNullOrWhiteSpace(ShownErrorCode))
    {
        @* Sin aviso de "clave nueva": BeginAsync es idempotente mientras el enrolamiento sigue
           abierto, así que al volver de un código fallido el QR es el mismo que el usuario ya
           escaneó y no hay nada que rehacer. *@
        <div class="alert alert-danger" role="alert">@L[TwoFactorMessages.ErrorKeyFor(ShownErrorCode)]</div>
    }

    @if (!string.IsNullOrWhiteSpace(QrCodePngDataUri))
    {
        <div class="text-center mb-3">
            <img src="@QrCodePngDataUri"
                 class="img-fluid bg-white p-2 rounded"
                 style="max-width:220px"
                 alt="@L["Enroll.QrAlt"]" />
        </div>
    }

    @* La clave va en claro y sin nada que pulsar. Quien no puede escanear —cámara rota,
       aplicación en otro dispositivo, lector de pantalla— la necesita para escribirla a mano,
       y esconderla tras un "mostrar clave" convierte el camino alternativo en un obstáculo. *@
    @if (!string.IsNullOrWhiteSpace(SharedKey))
    {
        <div class="mb-3">
            <label class="form-label" for="enroll-shared-key">@L["Enroll.ManualKey"]</label>
            <code id="enroll-shared-key" class="d-block user-select-all text-break p-2 rounded bg-dark-subtle">
                @SharedKey
            </code>
        </div>
    }

    <AccountForm Action="@FormAction" OnSubmit="@Submit">
        <div class="mb-3">
            <label class="form-label" for="enroll-code">@L["TwoFactor.CodeLabel"]</label>
            @* Mismos atributos que en la verificación: teclado numérico en el móvil y
               autorrelleno del código de un solo uso. *@
            <input @bind="Model.Code"
                   @bind:event="oninput"
                   id="enroll-code"
                   name="Code"
                   type="text"
                   class="form-control"
                   inputmode="numeric"
                   autocomplete="one-time-code"
                   maxlength="6"
                   pattern="[0-9]{6}"
                   placeholder="@L["TwoFactor.CodePlaceholder"]"
                   required
                   autofocus />
            <small class="text-muted">@L["TwoFactor.CodeHint"]</small>
        </div>
        <button type="submit" class="btn btn-warning w-100 fw-semibold" disabled="@Submitting">@L["Enroll.Submit"]</button>
    </AccountForm>

    @* Cambia cómo entra a su cuenta a partir de ahora. Avisarlo después de activarlo llega
       tarde: el momento de decidir si tiene el teléfono a mano es este. *@
    <p class="text-muted small mt-3 mb-0">@L["Enroll.Notice"]</p>

    @if (!string.IsNullOrWhiteSpace(CancelUrl))
    {
        <p class="mt-2 mb-0 small">
            <a href="@CancelUrl" class="text-decoration-none">@L["TwoFactor.Cancel"]</a>
        </p>
    }
</div>

@code {
    /// <summary>Ruta a la que postea el primer código de la aplicación. No hace falta con OnSubmit.</summary>
    [Parameter]
    public string? FormAction { get; set; }

    /// <summary>
    /// Envío interactivo: recibe los seis dígitos. Sin asignar, el formulario postea a
    /// <see cref="FormAction"/>.
    /// </summary>
    [Parameter]
    public EventCallback<CodeFormModel> OnSubmit { get; set; }

    /// <summary>PNG del QR en data-URI, tal cual lo devuelve la API.</summary>
    [Parameter]
    public string? QrCodePngDataUri { get; set; }

    /// <summary>Secreto en base32, para entrada manual.</summary>
    [Parameter]
    public string? SharedKey { get; set; }

    /// <summary>Enlace de salida hacia el login. Si viene vacío no se pinta.</summary>
    [Parameter]
    public string? CancelUrl { get; set; }

    /// <summary>Lo que hay escrito ahora mismo en el campo. Solo se usa en modo interactivo.</summary>
    private CodeFormModel Model { get; } = new();

    /// <summary>
    /// Se entrega una COPIA y no <see cref="Model"/>: la página se queda con lo que había cuando
    /// se pulsó el botón, y no con una referencia viva que siga cambiando mientras espera a la API.
    /// </summary>
    private EventCallback Submit => SubmitFor(
        OnSubmit, () => new CodeFormModel { Code = Model.Code });
}
