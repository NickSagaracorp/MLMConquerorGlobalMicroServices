@* Cambio de contraseña de una cuenta que ya tiene una: la actual, la nueva y su confirmación.
   Postea a PUT /api/v1/auth/change-password a través de la ruta que ponga el portal.

   Los requisitos se enseñan ANTES de escribir, con las mismas claves que ResetPassword creó en
   la tarea anterior — no unas nuevas con el mismo texto — para que las dos pantallas digan
   exactamente lo mismo ante la misma política. Son los de SignupAPI/Program.cs: mínimo 8
   caracteres, una mayúscula, un dígito, y también una minúscula aunque Program.cs no la toque
   —Identity la exige por defecto (RequireLowercase sigue en true)— tal como quedó documentado
   en ResetPassword.razor.

   autocomplete="current-password" en la actual y "new-password" en las otras dos: es lo que
   hace que el gestor de contraseñas del navegador ofrezca la guardada para la primera casilla y
   proponga una nueva, sin reutilizar la vieja, para las otras dos.

   DOS MODOS DE ENVÍO, UN SOLO CUERPO: sin OnSubmit postea a FormAction como siempre; con OnSubmit
   entrega las tres casillas sin recargar. Ver AccountForm.razor. Que la nueva y su confirmación
   coincidan se comprueba aquí en los dos modos, con el mismo código PASSWORD_CHANGE_FAILED que
   usa el manejador del POST. *@

@inherits AccountFormComponentBase
@inject IStringLocalizer<SharedResources> L

<div class="change-password">

    <h5 class="mb-3">@L["Credentials.ChangePassword"]</h5>

    <p class="small text-muted mb-1">@L["ResetPassword.RequirementsIntro"]</p>
    <ul class="small text-muted mb-3">
        <li>@L["ResetPassword.RequirementLength"]</li>
        <li>@L["ResetPassword.RequirementUppercase"]</li>
        <li>@L["ResetPassword.RequirementLowercase"]</li>
        <li>@L["ResetPassword.RequirementDigit"]</li>
    </ul>

    @if (!string.IsNullOrWhiteSpace(ShownErrorCode))
    {
        <div class="alert alert-danger" role="alert">@L[AccountMessages.ErrorKeyFor(ShownErrorCode)]</div>
    }

    <AccountForm Action="@FormAction" OnSubmit="@Submit">
        <div class="mb-3">
            <label class="form-label" for="change-password-current">@L["Credentials.CurrentPassword"]</label>
            <input @bind="Model.CurrentPassword"
                   @bind:event="oninput"
                   id="change-password-current"
                   name="CurrentPassword"
                   type="password"
                   class="form-control"
                   autocomplete="current-password"
                   placeholder="@L["Login.PasswordPlaceholder"]"
                   required
                   autofocus />
        </div>
        <div class="mb-3">
            <label class="form-label" for="change-password-new">@L["ResetPassword.NewPasswordLabel"]</label>
            <input @bind="Model.NewPassword"
                   @bind:event="oninput"
                   id="change-password-new"
                   name="NewPassword"
                   type="password"
                   class="form-control"
                   autocomplete="new-password"
                   placeholder="@L["ResetPassword.NewPasswordPlaceholder"]"
                   required
                   minlength="8" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="change-password-confirm">@L["ResetPassword.ConfirmPasswordLabel"]</label>
            <input @bind="Model.ConfirmPassword"
                   @bind:event="oninput"
                   id="change-password-confirm"
                   name="ConfirmPassword"
                   type="password"
                   class="form-control"
                   autocomplete="new-password"
                   placeholder="@L["ResetPassword.ConfirmPasswordPlaceholder"]"
                   required
                   minlength="8" />
        </div>
        <button type="submit" class="btn btn-primary w-100 fw-semibold" disabled="@Submitting">@L["Credentials.UpdatePassword"]</button>
    </AccountForm>

    @if (!string.IsNullOrWhiteSpace(CancelUrl))
    {
        <p class="mt-3 mb-0 small">
            <a href="@CancelUrl" class="text-decoration-none">@L["Common.Cancel"]</a>
        </p>
    }
</div>

@code {
    /// <summary>Ruta a la que postea el formulario. La pone el portal, que la traduce a
    /// PUT /api/v1/auth/change-password. No hace falta con OnSubmit.</summary>
    [Parameter]
    public string? FormAction { get; set; }

    /// <summary>
    /// Envío interactivo: recibe las tres casillas, ya comprobado que las dos nuevas coinciden.
    /// Sin asignar, el formulario postea a <see cref="FormAction"/>.
    /// </summary>
    [Parameter]
    public EventCallback<ChangePasswordFormModel> OnSubmit { get; set; }

    /// <summary>Enlace de salida hacia la cuenta. Si viene vacío no se pinta.</summary>
    [Parameter]
    public string? CancelUrl { get; set; }

    /// <summary>Lo que hay escrito ahora mismo. Solo se usa en modo interactivo.</summary>
    private ChangePasswordFormModel Model { get; } = new();

    /// <summary>
    /// Se entrega una COPIA y no <see cref="Model"/>: la página se queda con lo que había cuando
    /// se pulsó el botón, y no con una referencia viva que siga cambiando mientras espera a la API.
    /// </summary>
    private EventCallback Submit => SubmitFor(
        OnSubmit,
        () => new ChangePasswordFormModel
        {
            CurrentPassword = Model.CurrentPassword,
            NewPassword     = Model.NewPassword,
            ConfirmPassword = Model.ConfirmPassword
        },
        () => PasswordsMismatch(Model.NewPassword, Model.ConfirmPassword) ? "PASSWORD_CHANGE_FAILED" : null);
}
