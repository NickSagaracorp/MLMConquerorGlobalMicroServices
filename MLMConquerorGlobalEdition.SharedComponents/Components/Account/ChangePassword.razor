@* Cambio de contraseña de una cuenta que ya tiene una: la actual, la nueva y su confirmación.
   Postea a PUT /api/v1/auth/change-password a través de la ruta que ponga el portal.

   Los requisitos se enseñan ANTES de escribir, con las mismas claves que ResetPassword creó en
   la tarea anterior — no unas nuevas con el mismo texto — para que las dos pantallas digan
   exactamente lo mismo ante la misma política. Son los de SignupAPI/Program.cs: mínimo 8
   caracteres, una mayúscula, un dígito, y también una minúscula aunque Program.cs no la toque
   —Identity la exige por defecto (RequireLowercase sigue en true)— tal como quedó documentado
   en ResetPassword.razor.

   autocomplete="current-password" en la actual y "new-password" en las otras dos: es lo que
   hace que el gestor de contraseñas del navegador ofrezca la guardada para la primera casilla y
   proponga una nueva, sin reutilizar la vieja, para las otras dos. *@

@inject IStringLocalizer<SharedResources> L

<div class="change-password">

    <h5 class="mb-3">@L["Credentials.ChangePassword"]</h5>

    <p class="small text-muted mb-1">@L["ResetPassword.RequirementsIntro"]</p>
    <ul class="small text-muted mb-3">
        <li>@L["ResetPassword.RequirementLength"]</li>
        <li>@L["ResetPassword.RequirementUppercase"]</li>
        <li>@L["ResetPassword.RequirementLowercase"]</li>
        <li>@L["ResetPassword.RequirementDigit"]</li>
    </ul>

    @if (!string.IsNullOrWhiteSpace(ErrorCode))
    {
        <div class="alert alert-danger" role="alert">@L[AccountMessages.ErrorKeyFor(ErrorCode)]</div>
    }

    <form method="post" action="@FormAction">
        <div class="mb-3">
            <label class="form-label" for="change-password-current">@L["Credentials.CurrentPassword"]</label>
            <input id="change-password-current"
                   name="CurrentPassword"
                   type="password"
                   class="form-control"
                   autocomplete="current-password"
                   placeholder="@L["Login.PasswordPlaceholder"]"
                   required
                   autofocus />
        </div>
        <div class="mb-3">
            <label class="form-label" for="change-password-new">@L["ResetPassword.NewPasswordLabel"]</label>
            <input id="change-password-new"
                   name="NewPassword"
                   type="password"
                   class="form-control"
                   autocomplete="new-password"
                   placeholder="@L["ResetPassword.NewPasswordPlaceholder"]"
                   required
                   minlength="8" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="change-password-confirm">@L["ResetPassword.ConfirmPasswordLabel"]</label>
            <input id="change-password-confirm"
                   name="ConfirmPassword"
                   type="password"
                   class="form-control"
                   autocomplete="new-password"
                   placeholder="@L["ResetPassword.ConfirmPasswordPlaceholder"]"
                   required
                   minlength="8" />
        </div>
        <button type="submit" class="btn btn-primary w-100 fw-semibold">@L["Credentials.UpdatePassword"]</button>
    </form>

    @if (!string.IsNullOrWhiteSpace(CancelUrl))
    {
        <p class="mt-3 mb-0 small">
            <a href="@CancelUrl" class="text-decoration-none">@L["Common.Cancel"]</a>
        </p>
    }
</div>

@code {
    /// <summary>Ruta a la que postea el formulario. La pone el portal, que la traduce a
    /// PUT /api/v1/auth/change-password.</summary>
    [Parameter, EditorRequired]
    public string FormAction { get; set; } = string.Empty;

    /// <summary>Código de error de la API, tal cual llega por query string.</summary>
    [Parameter]
    public string? ErrorCode { get; set; }

    /// <summary>Enlace de salida hacia la cuenta. Si viene vacío no se pinta.</summary>
    [Parameter]
    public string? CancelUrl { get; set; }
}
