@* Formulario de cambio de contraseña tras pulsar el enlace del correo.

   El enlace llega como {base}/auth/confirm-email?userId=…&token=… para la confirmación de
   correo (Tarea 1), y el de recuperación sigue el mismo patrón: userId + token, no email +
   token. Por eso los parámetros se llaman UserId y Token, y no Email: así la página que
   monte este componente puede leer la query string tal cual y pasarla sin traducir nombres.

   Los requisitos de contraseña se enseñan ANTES de escribir, como lista, no como error tras
   un fallo: adivinar la política a base de intentos fallidos es la peor manera de aprenderla.
   Reflejan exactamente lo que exige SignupAPI/Program.cs — incluida la minúscula, que
   Identity exige por defecto (RequireLowercase no se sobreescribe ahí, así que sigue en
   true) aunque no se mencione en ningún sitio a simple vista.

   Y desde esta tarea, también el CARÁCTER ESPECIAL. La lista tenía cuatro líneas y el
   validador de la API exigía cinco cosas —ValidationPatterns.PasswordPattern pide
   (?=.*[^A-Za-z0-9])—, así que quien cumplía al pie de la letra lo que leía se llevaba un
   rechazo del servidor sin saber por qué. La línea de la lista y la condición de
   AccountFormComponentBase.PasswordFailsPolicy se cambian siempre juntas: cualquiera de las
   dos a solas vuelve a abrir el mismo hueco, por el lado contrario.

   DOS MODOS DE ENVÍO, UN SOLO CUERPO: sin OnSubmit postea a FormAction como siempre; con OnSubmit
   entrega userId, token y la contraseña nueva sin recargar. Ver AccountForm.razor. Que las dos
   casillas coincidan se comprueba aquí en los dos modos —el navegador no sabe hacerlo— y con el
   mismo código PASSWORD_RESET_FAILED que usa el manejador del POST, para que el usuario lea el
   mismo mensaje venga por donde venga. *@

@inherits AccountFormComponentBase
@inject IStringLocalizer<SharedResources> L

<div class="reset-password">

    @if (IsMissingLinkData)
    {
        <div class="alert alert-danger mb-3" role="alert">@L["ResetPassword.InvalidLink"]</div>

        @if (!string.IsNullOrWhiteSpace(RequestNewLinkUrl))
        {
            <a href="@RequestNewLinkUrl" class="btn btn-outline-primary w-100 fw-semibold">@L["ResetPassword.RequestNew"]</a>
        }
    }
    else
    {
        <h5 class="mb-1">@L["ResetPassword.Title"]</h5>
        <p class="mb-3">@L["ResetPassword.Subtitle"]</p>

        <p class="small text-muted mb-1">@L["ResetPassword.RequirementsIntro"]</p>
        <ul class="small text-muted mb-3">
            <li>@L["ResetPassword.RequirementLength"]</li>
            <li>@L["ResetPassword.RequirementUppercase"]</li>
            <li>@L["ResetPassword.RequirementLowercase"]</li>
            <li>@L["ResetPassword.RequirementDigit"]</li>
            <li>@L["ResetPassword.RequirementSpecial"]</li>
        </ul>

        @if (!string.IsNullOrWhiteSpace(ShownErrorCode))
        {
            <div class="alert alert-danger" role="alert">@L[AccountMessages.ErrorKeyFor(ShownErrorCode)]</div>
        }

        <AccountForm Action="@FormAction" OnSubmit="@Submit">
            @* Sin @@bind: no los toca el usuario, salen de los parámetros y en modo interactivo
               se leen de ahí directamente al montar la carga. *@
            <input type="hidden" name="UserId" value="@UserId" />
            <input type="hidden" name="Token" value="@Token" />

            <div class="mb-3">
                <label class="form-label" for="reset-password-new">@L["ResetPassword.NewPasswordLabel"]</label>
                <input @bind="Model.NewPassword"
                       @bind:event="oninput"
                       id="reset-password-new"
                       name="NewPassword"
                       type="password"
                       class="form-control"
                       autocomplete="new-password"
                       placeholder="@L["ResetPassword.NewPasswordPlaceholder"]"
                       required
                       minlength="8"
                       autofocus />
            </div>
            <div class="mb-3">
                <label class="form-label" for="reset-password-confirm">@L["ResetPassword.ConfirmPasswordLabel"]</label>
                <input @bind="Model.ConfirmPassword"
                       @bind:event="oninput"
                       id="reset-password-confirm"
                       name="ConfirmPassword"
                       type="password"
                       class="form-control"
                       autocomplete="new-password"
                       placeholder="@L["ResetPassword.ConfirmPasswordPlaceholder"]"
                       required
                       minlength="8" />
            </div>
            <button type="submit" class="btn btn-primary w-100 fw-semibold" disabled="@Submitting">@L["ResetPassword.SubmitButton"]</button>
        </AccountForm>

        @if (!string.IsNullOrWhiteSpace(CancelUrl))
        {
            <p class="mt-3 mb-0 small">
                <a href="@CancelUrl" class="text-decoration-none">@L["ResetPassword.BackToLogin"]</a>
            </p>
        }
    }
</div>

@code {
    /// <summary>Identificador del usuario, tal cual llega en el enlace del correo.</summary>
    [Parameter]
    public string? UserId { get; set; }

    /// <summary>Token de recuperación, tal cual llega en el enlace del correo.</summary>
    [Parameter]
    public string? Token { get; set; }

    /// <summary>Ruta a la que postea la nueva contraseña. La pone el portal. No hace falta con OnSubmit.</summary>
    [Parameter]
    public string? FormAction { get; set; }

    /// <summary>
    /// Envío interactivo: recibe el enlace y las dos contraseñas, ya comprobado que coinciden.
    /// Sin asignar, el formulario postea a <see cref="FormAction"/>.
    /// </summary>
    [Parameter]
    public EventCallback<ResetPasswordFormModel> OnSubmit { get; set; }

    /// <summary>Ruta para pedir un enlace nuevo cuando el actual falta o no sirve.</summary>
    [Parameter]
    public string? RequestNewLinkUrl { get; set; }

    /// <summary>Enlace de salida hacia el login. Si viene vacío no se pinta.</summary>
    [Parameter]
    public string? CancelUrl { get; set; }

    /// <summary>Lo que hay escrito ahora mismo en las dos casillas. Solo se usa en modo interactivo.</summary>
    private ResetPasswordFormModel Model { get; } = new();

    /// <summary>
    /// Se entrega una COPIA y no <see cref="Model"/>: la página se queda con lo que había cuando
    /// se pulsó el botón, y no con una referencia viva que siga cambiando mientras espera a la API.
    /// </summary>
    private EventCallback Submit => SubmitFor(
        OnSubmit,
        () => new ResetPasswordFormModel
        {
            UserId          = UserId ?? string.Empty,
            Token           = Token ?? string.Empty,
            NewPassword     = Model.NewPassword,
            ConfirmPassword = Model.ConfirmPassword
        },
        () => NewPasswordProblem(Model.NewPassword, Model.ConfirmPassword, "PASSWORD_RESET_FAILED"));

    /// <summary>
    /// Sin userId o sin token no hay nada que enviar: es un enlace roto o tecleado a mano, y
    /// pintar el formulario solo llevaría a un POST que la API rechazará igual.
    /// </summary>
    private bool IsMissingLinkData =>
        string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Token);
}
