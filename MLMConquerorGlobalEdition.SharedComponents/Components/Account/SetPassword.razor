@* Fija la primera contraseña de una cuenta que no tiene ninguna: solo la nueva y su
   confirmación, sin la actual, porque no existe. Postea a POST /api/v1/auth/set-password a
   través de la ruta que ponga el portal.

   IMPORTANTE PARA QUIEN MONTE ESTA PANTALLA (Tareas 8 y 9): este componente no comprueba nada
   por su cuenta, así que quien lo monte tiene que leer HasPassword de account-status ANTES de
   enseñarla. Si HasPassword es true, la cuenta ya tiene contraseña y el destino correcto es
   ChangePassword, no esta pantalla — SetPasswordHandler la rechaza con PASSWORD_ALREADY_SET
   (ver SignupAPI/Features/Auth/Commands/SetPassword/SetPasswordHandler.cs), así que ofrecer
   este formulario a quien ya tiene contraseña es ofrecer una operación que va a fallar siempre.
   Hoy, además, ninguna cuenta llega aquí sin contraseña —no hay logins externos todavía—, así
   que en la práctica esta pantalla solo tiene sentido el día que se acepte iniciar sesión con
   Google o Microsoft.

   Mismos requisitos y mismas claves que ChangePassword y ResetPassword: mínimo 8 caracteres,
   una mayúscula, una minúscula y un dígito. Ver ResetPassword.razor para por qué la minúscula
   cuenta aunque SignupAPI/Program.cs no la mencione. *@

@inject IStringLocalizer<SharedResources> L

<div class="set-password">

    <h5 class="mb-1">@L["SetPassword.Title"]</h5>
    <p class="mb-3">@L["SetPassword.Subtitle"]</p>

    <p class="small text-muted mb-1">@L["ResetPassword.RequirementsIntro"]</p>
    <ul class="small text-muted mb-3">
        <li>@L["ResetPassword.RequirementLength"]</li>
        <li>@L["ResetPassword.RequirementUppercase"]</li>
        <li>@L["ResetPassword.RequirementLowercase"]</li>
        <li>@L["ResetPassword.RequirementDigit"]</li>
    </ul>

    @if (!string.IsNullOrWhiteSpace(ErrorCode))
    {
        <div class="alert alert-danger" role="alert">@L[AccountMessages.ErrorKeyFor(ErrorCode)]</div>
    }

    <form method="post" action="@FormAction">
        <div class="mb-3">
            <label class="form-label" for="set-password-new">@L["ResetPassword.NewPasswordLabel"]</label>
            <input id="set-password-new"
                   name="NewPassword"
                   type="password"
                   class="form-control"
                   autocomplete="new-password"
                   placeholder="@L["ResetPassword.NewPasswordPlaceholder"]"
                   required
                   minlength="8"
                   autofocus />
        </div>
        <div class="mb-3">
            <label class="form-label" for="set-password-confirm">@L["ResetPassword.ConfirmPasswordLabel"]</label>
            <input id="set-password-confirm"
                   name="ConfirmPassword"
                   type="password"
                   class="form-control"
                   autocomplete="new-password"
                   placeholder="@L["ResetPassword.ConfirmPasswordPlaceholder"]"
                   required
                   minlength="8" />
        </div>
        <button type="submit" class="btn btn-primary w-100 fw-semibold">@L["SetPassword.SubmitButton"]</button>
    </form>

    @if (!string.IsNullOrWhiteSpace(CancelUrl))
    {
        <p class="mt-3 mb-0 small">
            <a href="@CancelUrl" class="text-decoration-none">@L["Common.Cancel"]</a>
        </p>
    }
</div>

@code {
    /// <summary>Ruta a la que postea el formulario. La pone el portal, que la traduce a
    /// POST /api/v1/auth/set-password.</summary>
    [Parameter, EditorRequired]
    public string FormAction { get; set; } = string.Empty;

    /// <summary>Código de error de la API, tal cual llega por query string.</summary>
    [Parameter]
    public string? ErrorCode { get; set; }

    /// <summary>Enlace de salida hacia la cuenta. Si viene vacío no se pinta.</summary>
    [Parameter]
    public string? CancelUrl { get; set; }
}
