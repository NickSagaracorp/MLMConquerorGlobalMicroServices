@code {
    /// <summary>
    /// Highlights a leaf menu item only when the current URL's path equals
    /// the href exactly (case-insensitive, ignoring trailing slash and
    /// query/fragment). The previous Contains() check let any prefix match,
    /// so "/admin/events/contests" lit up both "Contests" AND its parent's
    /// "Corporate Events" link. Section-level expansion is handled
    /// separately by IsSection() so the visual hierarchy still holds.
    /// </summary>
    private string IsActive(string href)
    {
        var path = new Uri(Nav.Uri, UriKind.Absolute).AbsolutePath.TrimEnd('/');
        var target = href.TrimEnd('/');
        return string.Equals(path, target, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;
    }

    /// <summary>
    /// Section-level matcher used to keep a parent group expanded while the
    /// user is anywhere inside it. Prefix-style on purpose — that's the
    /// whole point of "section".
    /// </summary>
    private bool IsSection(params string[] segments)
        => segments.Any(s => Nav.Uri.Contains(s, StringComparison.OrdinalIgnoreCase));
}
