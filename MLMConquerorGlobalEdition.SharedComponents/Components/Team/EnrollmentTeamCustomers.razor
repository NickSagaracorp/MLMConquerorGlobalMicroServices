@inject HttpClient Http
@inject IViewContextService ViewContext
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using MLMConquerorGlobalEdition.SharedComponents.Resources
@using MLMConquerorGlobalEdition.SharedComponents.Components.Grid
@using Syncfusion.Blazor
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Data

@if (ShowBreadcrumb) { <BreadcrumbNav Items="@_breadcrumb" /> }

<div class="card bg-white border-0 rounded-3 mb-4">
    <div class="card-body p-0">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 p-3">
            <div class="d-flex align-items-center gap-2">
                <SfTextBox Placeholder="@L["Team.CustomersSearchPlaceholder"]"
                           @bind-Value="_search"
                           CssClass="form-control form-control-sm"
                           style="min-width:240px" />
                <button class="btn btn-primary btn-sm" @onclick="SearchAsync">
                    <i class="ri-search-line me-1"></i>@L["Common.Search"]
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="ClearAsync">
                    <i class="ri-refresh-line"></i>
                </button>
            </div>
        </div>

        @* Server-side grid: search / column filters / sort / paging ALL travel  *@
        @* to the server via ServerGridAdaptor, so they span EVERY customer — not *@
        @* just the current page.                                                 *@
        <SfGrid TValue="CustomerDto" @ref="_grid"
                AllowPaging="true" AllowSorting="true" AllowResizing="true"
                AllowFiltering="true" GridLines="GridLine.Horizontal">
            <SfDataManager Adaptor="Adaptors.CustomAdaptor">
                <ServerGridAdaptor TValue="CustomerDto"
                                   Http="Http"
                                   Endpoint="@($"{ApiBaseUrl}/customers/grid")"
                                   AccessTokenProvider="GetTokenAsync" />
            </SfDataManager>
            <GridPageSettings PageSize="20" PageSizes="@(new int[]{20,50,100})" />
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
            <GridColumns>

                <GridColumn Field="@nameof(CustomerDto.EnrollDate)" HeaderText="@L["Reports.JoinDate"]"
                            Width="115" TextAlign="TextAlign.Center" Format="MM/dd/yyyy" Type="ColumnType.Date">
                    <Template>@(((CustomerDto)context).EnrollDate.ToString("MM/dd/yyyy"))</Template>
                </GridColumn>

                <GridColumn Field="@nameof(CustomerDto.MemberId)" HeaderText="@L["Reports.Id"]" Width="120" Type="ColumnType.String">
                    <Template><code class="text-primary">@(((CustomerDto)context).MemberId)</code></Template>
                </GridColumn>

                <GridColumn Field="@nameof(CustomerDto.FullName)" HeaderText="@L["Reports.Name"]" Width="160" Type="ColumnType.String">
                    <Template>@(((CustomerDto)context).FullName)</Template>
                </GridColumn>

                <GridColumn Field="@nameof(CustomerDto.Email)" HeaderText="@L["Reports.Email"]" Width="200" Type="ColumnType.String">
                    <Template>@(((CustomerDto)context).Email)</Template>
                </GridColumn>

                <GridColumn Field="@nameof(CustomerDto.Phone)" HeaderText="@L["Reports.Phone"]" Width="140" Type="ColumnType.String">
                    <Template>@(((CustomerDto)context).Phone ?? "—")</Template>
                </GridColumn>

                <GridColumn Field="@nameof(CustomerDto.Level)" HeaderText="@L["Reports.Level"]" Width="80" TextAlign="TextAlign.Center" Type="ColumnType.Integer">
                    <Template><span class="badge bg-secondary">L@(((CustomerDto)context).Level)</span></Template>
                </GridColumn>

                <GridColumn Field="@nameof(CustomerDto.Country)" HeaderText="@L["Reports.Country"]" Width="100" Type="ColumnType.String">
                    <Template>@(((CustomerDto)context).Country)</Template>
                </GridColumn>

                <GridColumn Field="@nameof(CustomerDto.SponsorFullName)" HeaderText="@L["Reports.Sponsor"]" Width="150" Type="ColumnType.String">
                    <Template>
                        @{ var c = (CustomerDto)context; }
                        @(c.SponsorFullName ?? c.SponsorMemberId ?? "—")
                    </Template>
                </GridColumn>

                <GridColumn Field="@nameof(CustomerDto.AccountStatus)" HeaderText="@L["Reports.BizStatus"]" Width="110" TextAlign="TextAlign.Center" Type="ColumnType.String">
                    <Template><StatusBadge Status="@(((CustomerDto)context).AccountStatus)" /></Template>
                </GridColumn>

                <GridColumn Field="@nameof(CustomerDto.MembershipStatus)" HeaderText="@L["Reports.MembershipStatus"]" Width="140" TextAlign="TextAlign.Center" Type="ColumnType.String">
                    <Template><StatusBadge Status="@(((CustomerDto)context).MembershipStatus)" /></Template>
                </GridColumn>

                <GridColumn Field="@nameof(CustomerDto.MembershipLevel)" HeaderText="@L["Reports.Membership"]" Width="200" Type="ColumnType.String">
                    <Template>@(((CustomerDto)context).MembershipLevel ?? "—")</Template>
                </GridColumn>

                <GridColumn Field="@nameof(CustomerDto.PersonalPoints)" HeaderText="@L["Reports.Points"]" Width="100" TextAlign="TextAlign.Right" Type="ColumnType.Integer">
                    <Template>@(((CustomerDto)context).PersonalPoints.ToString("N0"))</Template>
                </GridColumn>

                @if (ViewContext.IsAdminContext)
                {
                    <GridColumn HeaderText="" Width="80" TextAlign="TextAlign.Center"
                                AllowSorting="false" AllowFiltering="false">
                        <Template>
                            <button class="btn btn-xs btn-outline-secondary"
                                    @onclick="@(() => Nav.NavigateTo($"/admin/members/{((CustomerDto)context).MemberId}"))"
                                    title="@L["Team.ViewInAdmin"]">
                                <i class="ri-eye-line"></i>
                            </button>
                        </Template>
                    </GridColumn>
                }

            </GridColumns>
        </SfGrid>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string MemberProfileId { get; set; } = string.Empty;
    [Parameter] public string ApiBaseUrl     { get; set; } = "api/v1/bizcenter/team/enrollment";
    [Parameter] public bool   ShowBreadcrumb { get; set; } = true;

    private SfGrid<CustomerDto>? _grid;
    private string? _search;

    // JWT lives as an "access_token" claim on the ClaimsPrincipal. Resolved from the cascading
    // AuthenticationState (reliable inside Syncfusion's ReadAsync context) and handed to the
    // adaptor so it attaches Authorization: Bearer per request — sidestepping the 401 seen when
    // the host's auth DelegatingHandler provider fallback returns no token in this context.
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private async Task<string?> GetTokenAsync()
    {
        if (AuthState is null) return null;
        var state = await AuthState;
        return state.User.FindFirst("access_token")?.Value;
    }

    private List<BreadcrumbNav.BreadcrumbItem> _breadcrumb => new()
    {
        new(L["Nav.Dashboard"], "/dashboard"),
        new(L["Sidebar.EnrollmentTeam"]),
        new(L["Sidebar.Customers"])
    };

    /// <summary>
    /// "Search" button. Drives Syncfusion's built-in search, which fires a server read
    /// with the term in <c>dm.Search</c>; the adaptor maps it to <c>GridDataRequest.Search</c>,
    /// so it spans every customer rather than just the current page.
    /// </summary>
    private async Task SearchAsync()
    {
        if (_grid is not null) await _grid.SearchAsync(_search ?? string.Empty);
    }

    /// <summary>"Clear" — reset the search box and re-read the grid.</summary>
    private async Task ClearAsync()
    {
        _search = null;
        if (_grid is not null) await _grid.SearchAsync(string.Empty);
    }

    public class CustomerDto
    {
        public string   MemberId         { get; set; } = string.Empty;
        public string   FullName         { get; set; } = string.Empty;
        public string   Email            { get; set; } = string.Empty;
        public string?  Phone            { get; set; }
        public string   Country          { get; set; } = string.Empty;
        public int      Level            { get; set; }
        public DateTime EnrollDate       { get; set; }
        public string?  SponsorMemberId  { get; set; }
        public string?  SponsorFullName  { get; set; }
        public string   AccountStatus    { get; set; } = string.Empty;
        public string   MembershipStatus { get; set; } = string.Empty;
        public string?  MembershipLevel  { get; set; }
        public int      PersonalPoints   { get; set; }
    }
}
