<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- bUnit: renderiza de verdad los componentes de Account para comprobar sus DOS modos de
         envío. No estaba en el repo; entra por este proyecto porque es el que ya referencia
         SharedComponents y donde viven las pruebas de invariante de esa biblioteca.

         Que arrastre Microsoft.AspNetCore.Components.WebAssembly no afecta a
         SharedComponentsNoServerHostingTests: aquella prueba recorre el cierre transitivo del
         ensamblado de SharedComponents, no el de este proyecto de pruebas. -->
    <PackageReference Include="bunit" Version="2.9.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.2.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
    <Using Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MLMConquerorGlobalEdition.BizCenter\MLMConquerorGlobalEdition.BizCenter.csproj" />
    <ProjectReference Include="..\MLMConquerorGlobalEdition.SharedComponents\MLMConquerorGlobalEdition.SharedComponents.csproj" />
    <!-- La mitad de servidor de SharedComponents: AuthEndpoints, AccountEndpoints y las cookies de
         reto. Entra aquí porque este es el proyecto donde ya viven las pruebas de esa biblioteca, y
         porque el arreglo del 500 del login se comprueba llamando al manejador de verdad.

         Arrastra <FrameworkReference Include="Microsoft.AspNetCore.App" />, y eso NO afecta a
         SharedComponentsNoServerHostingTests ni a ClientCoreNoAspNetCoreTests: las dos recorren el
         cierre transitivo del ensamblado que vigilan, no el de este proyecto de pruebas. -->
    <ProjectReference Include="..\MLMConquerorGlobalEdition.SharedComponents.Server\MLMConquerorGlobalEdition.SharedComponents.Server.csproj" />
    <!-- Explícita, aunque llegue transitivamente por SharedComponents: ClientCoreNoAspNetCoreTests
         vigila este ensamblado en concreto y la referencia no puede depender de que un tercero
         siga apuntándole. -->
    <ProjectReference Include="..\MLMConquerorGlobalEdition.ClientCore\MLMConquerorGlobalEdition.ClientCore.csproj" />
    <ProjectReference Include="..\MLMConquerorGlobalEdition.SharedKernel\MLMConquerorGlobalEdition.SharedKernel.csproj" />
    <ProjectReference Include="..\MLMConquerorGlobalEdition.Repository\MLMConquerorGlobalEdition.Repository.csproj" />
  </ItemGroup>

</Project>
