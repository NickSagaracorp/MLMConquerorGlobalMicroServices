# Copiar a .env.servidor (que no se sube al repositorio) y llenar. Nada de esto es secreto:
# los secretos estan en AWS Secrets Manager y cada servicio los lee con su certificado.
ENTORNO=staging
AWS_REGION=us-east-1
CUENTA=123456789012
TRUST_ANCHOR_ARN=arn:aws:rolesanywhere:us-east-1:123456789012:trust-anchor/...
PROFILE_ARN=arn:aws:rolesanywhere:us-east-1:123456789012:profile/...
REGISTRO=123456789012.dkr.ecr.us-east-1.amazonaws.com/mlmconqueror
VERSION=1.0.0
# Llave publica JWT del entorno (base64 DER), la de deploy/aws/llaves-publicas/. No es secreta.
JWT_PUBLIC=
URL_ADMIN=https://admin.mlmconqueror.com
URL_APP=https://app.mlmconqueror.com
URL_SIGNUP=https://signup.mlmconqueror.com
URL_AUTH_API=https://auth-api.mlmconqueror.com
URL_CERTIFICADOS=https://rank.mlmconqueror.com
URL_RECIBOS=https://admin-api.mlmconqueror.com
