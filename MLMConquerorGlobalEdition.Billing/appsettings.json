{
  // Cifrado de las CREDENCIALES DE GATEWAY (PayQuicker, i-Payout, ...).
  //
  // El key ring vive en la tabla DataProtectionKeys de la misma base que AdminAPI y Billing
  // ya comparten, y esas llaves están envueltas con este certificado X.509. Son dos factores
  // separados: un backup de la base NO alcanza para descifrar sin la clave privada.
  //
  // Ambos servicios deben usar EL MISMO certificado. En producción se prefiere Thumbprint
  // (almacén de Windows, la clave privada nunca toca el disco de la app); Path es la
  // alternativa por archivo PFX. En Development, si el PFX no existe se genera uno solo.
  //
  // Documentación para IT: artículo de KB "gateway-credential-encryption".
  "DataProtection": {
    "Certificate": {
      "Thumbprint": "",
      "Path": "%LOCALAPPDATA%/MLMConqueror/DataProtection/gateway-credentials-dev.pfx",
      "Password": ""
    }
  },

  "ConnectionStrings": {
    //"DefaultConnection": "Server=mwrlivemssql-newproddb-restored.cmkxxw3gscaw.us-east-1.rds.amazonaws.com,1433;Database=MLMConquerorGlobalEditionDb;User Id=MLMConquerorGlobalEdition_user;Password=StrongPassword!2026;TrustServerCertificate=True;MultipleActiveResultSets=true;Encrypt=True;",
    "DefaultConnection": "Server=.;Database=MLMConquerorGlobalEditionDb;integrated security=true;TrustServerCertificate=True;MultipleActiveResultSets=true;Encrypt=True;",
    // Program.cs registra los recurring jobs durante el arranque, así que esta cadena TIENE
    // que ser alcanzable o el servicio no levanta. Igual que BizCenter/SignupAPI/Signups,
    // HangFire vive en la misma base que la app.
    // En prod sobreescribir con la variable de entorno ConnectionStrings__HangFire.
    //"HangFire": "Server=mwrlivemssql-newproddb-restored.cmkxxw3gscaw.us-east-1.rds.amazonaws.com,1433;Database=MLMConquerorGlobalEditionHangFire;User Id=MLMConquerorGlobalEdition_user;Password=StrongPassword!2026;TrustServerCertificate=True;MultipleActiveResultSets=true;Encrypt=True;",
    "HangFire": "Server=.;Database=MLMConquerorGlobalEditionDb;integrated security=true;TrustServerCertificate=True;MultipleActiveResultSets=true;Encrypt=True;",
    "Redis": "REPLACE_WITH_ELASTICACHE_ENDPOINT:6379"
  },
  "Jwt": {
    "PublicKeyBase64": "",
    "Issuer": "MLMConquerorGlobalEdition",
    "Audience": "MLMConquerorGlobalEdition.Clients"
  },
  "Stripe": {
    "SecretKey": "sk_test_REPLACE_ME"
  },
  "Firebase": {
    "CredentialsFilePath": "",
    "ProjectId": "REPLACE_WITH_FIREBASE_PROJECT_ID"
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      { "Endpoint": "*", "Period": "1s", "Limit": 10 },
      { "Endpoint": "post:/api/v1/billing/charge", "Period": "1m", "Limit": 5 },
      { "Endpoint": "post:/api/v1/billing/wallets/payout", "Period": "1m", "Limit": 3 }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
