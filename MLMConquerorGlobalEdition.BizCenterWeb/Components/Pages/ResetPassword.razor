@page "/reset-password"
@page "/auth/reset-password"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout MLMConquerorGlobalEdition.SharedComponents.Components.Layout.BlankLayout
@using MLMConquerorGlobalEdition.ClientCore
@using MLMConquerorGlobalEdition.SharedComponents.Components.Account
@using Microsoft.Extensions.Localization
@using MLMConquerorGlobalEdition.SharedComponents.Resources
@inject AuthApiGateway Api
@inject IStringLocalizer<SharedResources> L

@* Cambio de contraseña con el enlace del correo, en el centro de negocios.

   DOS RUTAS, Y LA SEGUNDA ARREGLA UN CAMINO ROTO. ForgotPasswordHandler construye el enlace como
   {PortalBaseUrl}/auth/reset-password?userId=…&token=… para todo el que tenga MemberProfile — es
   decir, para los miembros de ESTE portal— y aquí solo existía /reset-password. Un miembro que
   pedía recuperar su contraseña recibía un enlace que en este portal no llevaba a ninguna parte.
   /reset-password se conserva por los enlaces viejos que sigan circulando.

   Y POR ESO SE ACEPTAN DOS NOMBRES PARA EL IDENTIFICADOR: `userId`, que es el que trae el enlace de
   hoy, y `email`, que traía el de antes. ResetPasswordRequest admite los dos y prefiere userId, así
   que esta pantalla reenvía el que venga. Es lo mismo que hace AccountResetPassword en
   administración.

   MODO INTERACTIVO, como estaba: este portal no monta todavía la superficie de cuenta compartida,
   así que no tiene /account/reset-password al que postear, y el acierto se enseña aquí mismo en vez
   de en una pantalla aparte.

   La llamada va por AuthApiGateway.ResetPasswordAsync: una sola escritura de la ruta, el sobre
   desenvuelto una vez y un servicio caído devuelto como código en vez de como excepción. *@

<PageTitle>@L["PageTitle.ResetPassword"]</PageTitle>

<GateShell>
    @if (_done)
    {
        <div class="alert alert-success mb-3">@L["ResetPassword.SuccessMessage"]</div>
        <a href="/login" class="btn btn-primary fw-semibold w-100">@L["ResetPassword.GoToLogin"]</a>
    }
    else
    {
        @* Nombre completo: el componente se llama igual que esta página y la etiqueta corta sería
           ambigua. Mismo caso que Login.razor y ForgotPassword.razor. *@
        <MLMConquerorGlobalEdition.SharedComponents.Components.Account.ResetPassword
            UserId="@Identificador"
            Token="@Token"
            OnSubmit="RestablecerAsync"
            ErrorCode="@_errorCode"
            RequestNewLinkUrl="/forgot-password"
            CancelUrl="/login" />
    }
</GateShell>

@code {
    /// <summary>Identificador tal cual viene en el enlace del correo de hoy.</summary>
    [SupplyParameterFromQuery]
    public string? UserId { get; set; }

    /// <summary>El que traía el enlace anterior. Solo se usa si no viene <see cref="UserId"/>.</summary>
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private bool    _done;
    private string? _errorCode;

    /// <summary>El identificador que se manda, con userId por delante.</summary>
    private string? Identificador => string.IsNullOrWhiteSpace(UserId) ? Email : UserId;

    /// <summary>
    /// El componente ya comprobó lo que el navegador no puede: que las dos casillas coincidan y que
    /// la contraseña cumpla la lista de requisitos que tiene encima. Aquí solo queda la llamada.
    /// </summary>
    private async Task RestablecerAsync(ResetPasswordFormModel modelo)
    {
        _errorCode = null;

        var resultado = await Api.ResetPasswordAsync(
            modelo.UserId, modelo.Token, modelo.NewPassword);

        if (resultado.Success)
            _done = true;
        else
            _errorCode = resultado.ErrorCodeOr("PASSWORD_RESET_FAILED");
    }
}
