@page "/account/password"
@attribute [Authorize]
@using MLMConquerorGlobalEdition.SharedComponents.Components.Account
@using Microsoft.Extensions.Localization
@using MLMConquerorGlobalEdition.SharedComponents.Resources
@inject AccountPageData PageData
@inject IStringLocalizer<SharedResources> L

@* Contraseña de la cuenta: cambiarla, o fijarla si no hay ninguna.

   ESTA ES AHORA LA ÚNICA PANTALLA DEL PORTAL QUE CAMBIA LA CONTRASEÑA. Antes había otra dentro de
   /profile —la mitad de contraseña de CredentialsForm—, que era una segunda implementación con
   menos comprobaciones: no comparaba la confirmación, no enseñaba la política y aplastaba todos
   los errores de la API a un solo mensaje. Se quitó, y lo único que aquella hacía de más —anotar
   el cambio en el historial de credenciales— se subió al camino compartido antes de quitarla
   (SignupAPI/ChangePasswordHandler). La pestaña "Cuenta" del perfil enlaza aquí.

   CUÁL DE LAS DOS LO DECIDE HasPassword, y solo eso. SetPassword no comprueba nada por su cuenta,
   y ofrecérselo a quien ya tiene contraseña es ofrecer una operación que SetPasswordHandler
   rechaza siempre con PASSWORD_ALREADY_SET. Hoy ninguna cuenta llega aquí sin contraseña —no hay
   logins externos todavía—, así que en la práctica siempre se pinta ChangePassword; la rama existe
   para el día que se acepte entrar con Google o Microsoft.

   Una sola llamada a account-status, igual que el resto del área. *@

<PageTitle>@(_status?.HasPassword == false ? L["SetPassword.Title"] : L["Credentials.ChangePassword"])</PageTitle>

<AccountShell ActiveSection="@AccountLayout.PasswordSection"
              Unavailable="@(_status is null)"
              ErrorCode="@PageData.StatusErrorCode">
    @if (_status is not null)
    {
        @if (_status.HasPassword)
        {
            <ChangePassword FormAction="/account/change-password"
                            ErrorCode="@Error"
                            CancelUrl="/account" />
        }
        else
        {
            <SetPassword FormAction="/account/set-password"
                         ErrorCode="@Error"
                         CancelUrl="/account" />
        }
    }
</AccountShell>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    private AccountPageData.AccountStatus? _status;

    protected override async Task OnInitializedAsync() =>
        _status = await PageData.GetStatusAsync();
}
