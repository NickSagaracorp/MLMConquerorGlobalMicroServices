@page "/account/security"
@attribute [Authorize]
@using MLMConquerorGlobalEdition.SharedComponents.Components.Account
@using Microsoft.Extensions.Localization
@using MLMConquerorGlobalEdition.SharedComponents.Resources
@inject AccountPageData PageData
@inject IStringLocalizer<SharedResources> L

@* Panel del segundo factor del miembro: qué tiene puesto y qué canales tienen destino.

   LOS CANALES LLEGAN DEL SERVIDOR TAL CUAL. AvailableChannels es lo que devuelve account-status y
   no se recalcula aquí: la regla que los decide (correo siempre; SMS solo con teléfono confirmado;
   autenticador solo con enrolamiento confirmado) vive en GetAccountStatusHandler, que es quien
   conoce el estado real. Reproducirla en el portal solo abriría la puerta a que las dos copias
   divergieran y se le ofreciera al miembro un canal sin destino.

   RequiredByRole se resuelve comparando los roles del token con Auth:TwoFactor:MandatoryRoles, que
   es exactamente lo que hace LoginHandler para decidir si fuerza el enrolamiento. Hoy esa lista no
   incluye ningún rol de miembro, así que aquí sale false y el botón de desactivar se ofrece; el día
   que se incluya alguno, el botón desaparece solo y con su motivo escrito.

   Apagarlo NO ocurre desde el primer clic: el enlace vuelve a esta misma ruta con
   ?confirm=disable-2fa y es esa segunda pasada la que pinta el aviso y el botón que sí actúa.

   LO QUE NO SE OFRECE TODAVÍA: activar o volver a enrolar el autenticador desde una sesión ya
   iniciada. La API tiene las rutas —POST /api/v1/auth/account/two-factor/enroll/begin y
   /enroll/confirm, las dos con [Authorize]— pero falta la pantalla del QR y el endpoint que
   confirma el código, así que EnrollUrl y ReEnrollConfirmUrl van sin valor y el componente, que
   trata una ruta ausente como "esta acción no se ofrece", no pinta botones que llevarían a un 404.
   Mismo estado que en administración. *@

<PageTitle>@L["TwoFactorPanel.Title"]</PageTitle>

<AccountShell ActiveSection="@AccountLayout.SecuritySection"
              Unavailable="@(_status is null)"
              ErrorCode="@PageData.StatusErrorCode">
    @if (_status is not null)
    {
        <TwoFactorPanel TwoFactorEnabled="@_status.TwoFactorEnabled"
                        PreferredChannel="@_status.PreferredTwoFactorChannel"
                        AvailableChannels="@_status.AvailableChannels"
                        EnrolledAt="@_status.TwoFactorEnrolledAt"
                        RequiredByRole="@_requiredByRole"
                        PhoneSetupUrl="@PhoneSetupUrl"
                        ChangeChannelAction="/account/two-factor/channel"
                        DisableConfirmUrl="/account/security?confirm=disable-2fa"
                        ConfirmDisable="@(Confirm == DisableConfirmation)"
                        DisableAction="/account/two-factor/disable"
                        CancelDisableUrl="/account/security"
                        ErrorCode="@Error" />
    }
</AccountShell>

@code {
    /// <summary>Marca de la query que activa la pantalla de confirmación de la baja del 2FA.</summary>
    private const string DisableConfirmation = "disable-2fa";

    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    /// <summary>Qué acción está pidiendo confirmación. Ver <see cref="DisableConfirmation"/>.</summary>
    [SupplyParameterFromQuery]
    public string? Confirm { get; set; }

    private AccountPageData.AccountStatus? _status;
    private bool _requiredByRole;

    protected override async Task OnInitializedAsync()
    {
        _status         = await PageData.GetStatusAsync();
        _requiredByRole = PageData.TwoFactorRequiredByRole();
    }

    /// <summary>
    /// A dónde va el enlace "configurar" del canal SMS. Lo elige esta página porque es la que
    /// conoce el estado del teléfono: con un número ya dado de alta pero sin confirmar, mandar al
    /// alta otra vez haría teclearlo de nuevo sin necesidad.
    /// </summary>
    private string PhoneSetupUrl =>
        _status is { HasPhone: true, PhoneConfirmed: false }
            ? "/account/phone/confirm"
            : "/account/phone";
}
