@page "/forgot-password/sent"
@layout MLMConquerorGlobalEdition.SharedComponents.Components.Layout.BlankLayout
@using MLMConquerorGlobalEdition.SharedComponents.Components.Account
@using Microsoft.Extensions.Localization
@using MLMConquerorGlobalEdition.SharedComponents.Resources
@inject IStringLocalizer<SharedResources> L

@* Aterrizaje tras pedir el correo de recuperación. Enseña el mismo mensaje ambiguo exista o no la
   cuenta, que es lo que impide usar aquel formulario para averiguar qué direcciones están
   registradas. No recibe la dirección por la URL a propósito: es un dato de más en una pantalla que
   no tiene que confirmar nada sobre esa cuenta. *@

<PageTitle>@L["ForgotPasswordConfirmation.Title"]</PageTitle>

<GateShell>
    <ForgotPasswordConfirmation LoginUrl="/login" />
</GateShell>
