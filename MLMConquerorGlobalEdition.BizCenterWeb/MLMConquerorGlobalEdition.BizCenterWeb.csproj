<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.5" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.9.0" />
    <PackageReference Include="Syncfusion.Blazor.Core" Version="33.1.44" />
    <PackageReference Include="Syncfusion.Blazor.Grid" Version="33.1.44" />
    <PackageReference Include="Syncfusion.Blazor.Navigations" Version="33.1.44" />
    <PackageReference Include="Syncfusion.Blazor.Buttons" Version="33.1.44" />
    <PackageReference Include="Syncfusion.Blazor.Inputs" Version="33.1.44" />
    <PackageReference Include="Syncfusion.Blazor.Popups" Version="33.1.44" />
    <PackageReference Include="Syncfusion.Blazor.Spinner" Version="33.1.44" />
    <PackageReference Include="Syncfusion.Blazor.Calendars" Version="33.1.44" />
    <PackageReference Include="Syncfusion.Blazor.Themes" Version="33.1.44" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MLMConquerorGlobalEdition.BizCenterWeb.Client\MLMConquerorGlobalEdition.BizCenterWeb.Client.csproj" />
    <ProjectReference Include="..\MLMConquerorGlobalEdition.SharedComponents\MLMConquerorGlobalEdition.SharedComponents.csproj" />
    <!-- La mitad de servidor de SharedComponents: el cableado del área de cuenta (manejadores de
         formulario, cookies de reto, lectura del HttpContext). Vive aparte porque las dos MAUI
         comparten los componentes pero no pueden ejecutar nada de esto. -->
    <ProjectReference Include="..\MLMConquerorGlobalEdition.SharedComponents.Server\MLMConquerorGlobalEdition.SharedComponents.Server.csproj" />
    <ProjectReference Include="..\MLMConquerorGlobalEdition.SharedKernel\MLMConquerorGlobalEdition.SharedKernel.csproj" />
  </ItemGroup>
</Project>
