{
  "SecretosAws": {
    "//": "Secretos que este servicio lee de AWS Secrets Manager al arrancar (mlmconqueror/{Entorno}/{secreto}). En staging y prod el entorno se cambia con la variable SecretosAws__Entorno.",
    "Habilitado": true,
    "Entorno": "local",
    "Region": "us-east-1",
    "Secretos": [ "datos", "sharedapicenter", "firebase" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=MLMConquerorGlobalEditionDb;integrated security=true;TrustServerCertificate=True;MultipleActiveResultSets=true;Encrypt=True;",
    "Redis": "REPLACE_WITH_ELASTICACHE_ENDPOINT:6379"
  },
  "Firebase": {
    "CredentialsFilePath": "",
    "ProjectId": "REPLACE_WITH_FIREBASE_PROJECT_ID"
  },
  // La sección Jwt se fue con la autenticación que nunca protegió nada aquí. Ver el bloque de
  // Program.cs: cero endpoints con [Authorize], llave HMAC contra un sistema que firma con RSA, y
  // un secreto que era el literal de sustituir antes de desplegar.
  "ExternalApi": {
    "ApiKey": ""
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      { "Endpoint": "*", "Period": "1s", "Limit": 20 },
      { "Endpoint": "post:/api/v1/webhooks/*", "Period": "1m", "Limit": 60 }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
