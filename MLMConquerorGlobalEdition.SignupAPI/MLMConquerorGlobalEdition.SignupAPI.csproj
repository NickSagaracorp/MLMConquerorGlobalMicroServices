<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CS0436: top-level Program type collision when referencing another Web project assembly; benign -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>

    <!--
      LA LLAVE PRIVADA DE FIRMA NO VIVE EN UN ARCHIVO DEL PROYECTO.

      Estaba byte a byte en appsettings.Development.json, aqui y en el otro firmante. Ese archivo
      esta excluido de git (.gitignore linea 99, appsettings.*.json) y nunca se commiteo, asi que
      la llave no llego al historial; pero seguia en texto plano dentro del arbol de trabajo, se
      copiaba a bin/Debug en cada compilacion, y bastaba un add forzado a git, un zip de la
      carpeta o un respaldo del disco para sacarla. El secreto que firma las credenciales de
      la casa no
      tiene por que estar en el directorio del codigo.

      Ahora va en el almacen de secretos de usuario (dotnet user-secrets), que guarda el JSON
      fuera del repositorio, en %APPDATA%/Microsoft/UserSecrets/{UserSecretsId}/secrets.json.
      WebApplication.CreateBuilder lo carga solo, y solo en Development.

      EL MISMO UserSecretsId EN LOS DOS FIRMANTES, A PROPOSITO. AdminAPI y SignupAPI tienen que
      firmar con LA MISMA llave o los tokens de uno no valen en el otro; compartir el almacen
      convierte esa invariante en algo estructural en vez de en una nota que hay que recordar.
      Los cinco servicios que solo verifican no llevan esto: la llave publica no es secreta y
      sigue en appsettings.json.

      Como se configura una maquina nueva: docs/deployment/llaves-jwt-en-desarrollo.md
    -->
    <UserSecretsId>mlmconqueror-jwt-signers</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MLMConquerorGlobalEdition.Domain\MLMConquerorGlobalEdition.Domain.csproj" />
    <ProjectReference Include="..\MLMConquerorGlobalEdition.SharedKernel\MLMConquerorGlobalEdition.SharedKernel.csproj" />
    <ProjectReference Include="..\MLMConquerorGlobalEdition.SharedKernel.Server\MLMConquerorGlobalEdition.SharedKernel.Server.csproj" />
    <ProjectReference Include="..\MLMConquerorGlobalEdition.Repository\MLMConquerorGlobalEdition.Repository.csproj" />
    <ProjectReference Include="..\MLMConquerorGlobalEdition.Billing\MLMConquerorGlobalEdition.Billing.csproj" />
    <ProjectReference Include="..\MLMConquerorGlobalEdition.Notifications\MLMConquerorGlobalEdition.Notifications.csproj" />
    <ProjectReference Include="..\MLMConquerorGlobalEdition.Authn\MLMConquerorGlobalEdition.Authn.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="3.7.413.6" />
    <PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.19" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.19" />
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Global usings — available across all .cs files in this project -->
    <Using Include="MLMConquerorGlobalEdition.SharedKernel.Interfaces" />
  </ItemGroup>

</Project>
