{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=MLMConquerorGlobalEditionDb;integrated security=true;TrustServerCertificate=True;MultipleActiveResultSets=true;Encrypt=True;",
    "HangFire": "Server=.;Database=MLMConquerorGlobalEditionDb;integrated security=true;TrustServerCertificate=True;MultipleActiveResultSets=true;Encrypt=True;",
    "Redis": "localhost:6379"
  },
  "Hangfire": {
    "WorkerCount": 5
  },
  "Firebase": {
    "CredentialsFilePath": "",
    "ProjectId": "REPLACE_WITH_FIREBASE_PROJECT_ID"
  },
  "RootAmbassador": {
    "Email": "REPLACE_WITH_ENV_VAR_ROOT_AMBASSADOR_EMAIL",
    "FirstName": "Corporate",
    "LastName": "Root",
    "Password": "REPLACE_WITH_ENV_VAR_ROOT_AMBASSADOR_PASSWORD"
  },
  "Jwt": {
    "PrivateKeyBase64": "",
    "PublicKeyBase64": "",
    "Issuer": "MLMConquerorGlobalEdition",
    "Audience": "MLMConquerorGlobalEdition.Clients",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7147",
      "https://localhost:7002",
      "https://localhost:7004"
    ]
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "POST:/api/v1/auth/login",
        "Period": "1m",
        "Limit": 5
      },
      {
        "//": "OJO CON EL NOMBRE: la ruta es /auth/refresh. Esta regla decia /auth/refresh-token, que no existe, asi que nunca caso con nada y el refresco caia en la regla general de 60/min.",
        "//2": "EL LIMITE ES POR IP Y LOS PORTALES LLAMAN SERVIDOR A SERVIDOR: son UNA IP para todos sus usuarios, no una por persona. Con tokens de 15 min, los refrescos por minuto son aproximadamente el numero de sesiones vivas dividido entre 15 (5.000 sesiones = ~333/min). Diez habria tirado el portal entero.",
        "//3": "En produccion lo correcto es meter las IP de los portales en IpRateLimiting:IpWhitelist, que la libreria ya lee sin tocar codigo. Este limite es la red de seguridad mientras esas IP no esten declaradas.",
        "Endpoint": "POST:/api/v1/auth/refresh",
        "Period": "1m",
        "Limit": 600
      },
      {
        "Endpoint": "POST:/api/v1/auth/forgot-password",
        "Period": "1h",
        "Limit": 3
      },
      {
        "Endpoint": "POST:/api/v1/auth/email/send-confirmation",
        "Period": "1h",
        "Limit": 3
      },
      {
        "Endpoint": "*:/api/v1/signups/ambassador",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "*:/api/v1/signups/member",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "POST:/api/v1/signups/validate-token",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 60
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "Auth": {
    "TwoFactor": {
      "MandatoryRoles": []
    },
    "//EmailLinkLifetimeMinutes": "Cuanto vive un ENLACE de correo: confirmacion de direccion y recuperacion de contrasena. Antes era el dia entero por defecto de Identity. Esta MISMA cifra es la que el correo le anuncia al usuario ({{ExpiresInMinutes}}); las dos salen de SharedKernel.Server/Configuration/EmailLinkLifetime.cs, asi que no pueden divergir. No confundir con TwoFactor:ChallengeLifetimeMinutes, que es otro mecanismo.",
    "EmailLinkLifetimeMinutes": 15,
    "PortalBaseUrl": "https://localhost:7004",
    "AdminPortalBaseUrl": "https://localhost:7001"
  },
  "Notifications": {
    "Email": { "Provider": "Null", "Ses": { "Region": "us-east-1", "FromAddress": "", "FromName": "MLM Conqueror" } },
    "Sms":   { "Provider": "Null", "Twilio": { "AccountSid": "", "AuthToken": "", "FromNumber": "" } }
  }
}