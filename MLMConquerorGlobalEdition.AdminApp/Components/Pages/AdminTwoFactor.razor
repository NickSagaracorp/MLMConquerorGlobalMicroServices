@page "/admin/two-factor"
@layout MLMConquerorGlobalEdition.SharedComponents.Components.Layout.BlankLayout
@using MLMConquerorGlobalEdition.ClientCore
@inject AdminJwtAuthStateProvider AuthProvider
@inject AuthApiGateway Api
@inject AdminLoginChallenge Challenge
@inject NavigationManager Navigation
@inject AdminViewContextInitializer ViewContextInitializer

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-logo">
            <h2>MLM Conqueror</h2>
            <p class="text-muted text-danger fw-semibold">Verificación en dos pasos</p>
        </div>

        <p class="text-muted small">
            @if (Challenge.Channel == "Authenticator")
            {
                <text>Escribe el código de seis dígitos que muestra tu aplicación autenticadora.</text>
            }
            else if (!string.IsNullOrWhiteSpace(Challenge.MaskedTarget))
            {
                <text>Enviamos un código de seis dígitos a <strong>@Challenge.MaskedTarget</strong>.</text>
            }
            else
            {
                <text>Escribe el código de seis dígitos que acabas de recibir.</text>
            }
        </p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }
        @if (_resent)
        {
            <div class="alert alert-success">Te enviamos un código nuevo.</div>
        }

        <EditForm Model="_model" OnValidSubmit="HandleVerify">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label">Código</label>
                <InputText class="form-control text-center fs-4" @bind-Value="_model.Code"
                           inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="000000" />
                <ValidationMessage For="() => _model.Code" />
            </div>
            <button type="submit" class="btn btn-danger w-100" disabled="@_busy">
                @if (_busy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                Verificar
            </button>
        </EditForm>

        <div class="mt-3 text-center">
            @if (Challenge.Channel != "Authenticator")
            {
                <button type="button" class="btn btn-link btn-sm" disabled="@_busy" @onclick="HandleResend">
                    Enviar otro código
                </button>
            }
            <button type="button" class="btn btn-link btn-sm text-muted" @onclick="BackToLogin">
                Volver a empezar
            </button>
        </div>
    </div>
</div>

<style>
    .login-wrapper { display: flex; justify-content: center; align-items: center; min-height: 100vh; background: #1a1a2e; }
    .login-card { background: white; padding: 2rem; border-radius: 12px; box-shadow: 0 4px 32px rgba(0,0,0,.3); width: 100%; max-width: 420px; }
    .login-logo { text-align: center; margin-bottom: 1.5rem; }
</style>

@*
    El segundo paso de la ÚNICA puerta. Sin esta pantalla, una cuenta de administración con segundo
    factor no podía entrar en esta aplicación: el login devuelve un reto y ningún token, y no había
    dónde canjearlo.

    EL RETO NO PASA POR EL FORMULARIO. Lo guarda AdminLoginChallenge en memoria desde que lo emitió
    el login; lo único que aporta el usuario es el código. Es el mismo reparto que en los portales
    web, donde el reto viaja en una cookie HttpOnly que la pantalla no puede leer.

    UN RETO RECHAZADO NO SIEMPRE SE PUEDE REINTENTAR. CODE_INVALID deja seguir probando; CODE_EXPIRED
    y TOO_MANY_ATTEMPTS matan el reto en la API, así que aquí se limpia y se manda al usuario a
    empezar de nuevo en vez de dejarlo escribiendo códigos contra un reto muerto.
*@
@code {
    private CodeModel _model = new();
    private bool _busy;
    private bool _resent;
    private string _error = string.Empty;

    protected override void OnInitialized()
    {
        // Sin reto pendiente no hay nada que verificar: se llegó aquí por la URL o tras reiniciar.
        if (!Challenge.IsPending)
            Navigation.NavigateTo("/admin/login");
    }

    private async Task HandleVerify()
    {
        _busy   = true;
        _resent = false;
        _error  = string.Empty;

        var challengeToken = Challenge.ChallengeToken;
        if (string.IsNullOrWhiteSpace(challengeToken))
        {
            BackToLogin();
            return;
        }

        var (outcome, refreshToken) = await Api.VerifyTwoFactorForTokensAsync(challengeToken!, _model.Code);

        if (!outcome.Success || outcome.Data is null)
        {
            var code = outcome.ErrorCode;
            _error   = MessageFor(code);
            _busy    = false;

            if (IsChallengeDead(code))
            {
                Challenge.Clear();
                Navigation.NavigateTo("/admin/login");
            }
            return;
        }

        Challenge.Clear();
        await AuthProvider.NotifyLoginAsync(outcome.Data.AccessToken, refreshToken);
        await ViewContextInitializer.InitializeAsync();
        _busy = false;
        Navigation.NavigateTo("/admin");
    }

    private async Task HandleResend()
    {
        _busy   = true;
        _resent = false;
        _error  = string.Empty;

        var challengeToken = Challenge.ChallengeToken;
        if (string.IsNullOrWhiteSpace(challengeToken))
        {
            BackToLogin();
            return;
        }

        var outcome = await Api.ResendTwoFactorAsync(challengeToken!);
        _busy = false;

        if (!outcome.Success || outcome.Data is null)
        {
            _error = MessageFor(outcome.ErrorCode);
            if (IsChallengeDead(outcome.ErrorCode))
            {
                Challenge.Clear();
                Navigation.NavigateTo("/admin/login");
            }
            return;
        }

        // La API emite un reto NUEVO: quedarse con el viejo condena el siguiente canje.
        if (!string.IsNullOrWhiteSpace(outcome.Data.ChallengeToken))
            Challenge.Renew(outcome.Data.ChallengeToken!, outcome.Data.MaskedTarget, outcome.Data.Channel);

        _model.Code = string.Empty;
        _resent     = true;
    }

    private void BackToLogin()
    {
        Challenge.Clear();
        _busy = false;
        Navigation.NavigateTo("/admin/login");
    }

    private static bool IsChallengeDead(string? errorCode) =>
        errorCode is "CODE_EXPIRED" or "TOO_MANY_ATTEMPTS" or "INVALID_CHALLENGE"
                  or AuthApiGateway.SessionExpired;

    private static string MessageFor(string? errorCode) => errorCode switch
    {
        "CODE_INVALID"        => "El código no es correcto. Vuelve a intentarlo.",
        "CODE_EXPIRED"        => "El código caducó. Vuelve a iniciar sesión para pedir uno nuevo.",
        "TOO_MANY_ATTEMPTS"   => "Demasiados intentos con este código. Vuelve a iniciar sesión.",
        "TOO_MANY_REQUESTS"   => "Demasiadas peticiones. Espera un momento antes de volver a probar.",
        "CHANNEL_UNAVAILABLE" => "No se pudo enviar el código por el canal configurado.",
        AuthApiGateway.Unreachable => "No se pudo contactar con el servicio de autenticación.",
        _                     => "No se pudo verificar el código."
    };

    private class CodeModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.RegularExpression(
            @"^\d{6}$", ErrorMessage = "El código son seis dígitos.")]
        public string Code { get; set; } = string.Empty;
    }
}
