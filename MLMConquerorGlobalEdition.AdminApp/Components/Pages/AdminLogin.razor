@page "/admin/login"
@layout MLMConquerorGlobalEdition.SharedComponents.Components.Layout.BlankLayout
@using MLMConquerorGlobalEdition.ClientCore
@inject AdminJwtAuthStateProvider AuthProvider
@inject AuthApiGateway Api
@inject AdminLoginChallenge Challenge
@inject NavigationManager Navigation
@inject AdminViewContextInitializer ViewContextInitializer

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-logo">
            <h2>MLM Conqueror</h2>
            <p class="text-muted text-danger fw-semibold">Admin Portal</p>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }

        <EditForm Model="_model" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label">Email</label>
                <InputText class="form-control" @bind-Value="_model.Email" type="email" placeholder="admin@company.com" />
                <ValidationMessage For="() => _model.Email" />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <InputText class="form-control" @bind-Value="_model.Password" type="password" placeholder="••••••••" />
                <ValidationMessage For="() => _model.Password" />
            </div>
            <button type="submit" class="btn btn-danger w-100" disabled="@_busy">
                @if (_busy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                Sign In to Admin
            </button>
        </EditForm>
    </div>
</div>

<style>
    .login-wrapper { display: flex; justify-content: center; align-items: center; min-height: 100vh; background: #1a1a2e; }
    .login-card { background: white; padding: 2rem; border-radius: 12px; box-shadow: 0 4px 32px rgba(0,0,0,.3); width: 100%; max-width: 420px; }
    .login-logo { text-align: center; margin-bottom: 1.5rem; }
</style>

@*
    LA PUERTA ES SignupAPI, NO AdminAPI.

    Esta pantalla posteaba a `api/v1/auth/login` de AdminAPI, que comprobaba la contraseña, leía los
    roles y devolvía un token de acceso COMPLETO CON ESOS ROLES sin mencionar el segundo factor en
    ninguna línea. Era una segunda puerta al panel entero: quien tuviera la contraseña de un
    administrador entraba sin más. Ese controlador ya no existe, y esta pantalla entra por donde
    entran los dos portales web.

    HAY QUE RAMIFICAR ANTES DE MIRAR EL TOKEN. En las dos ramas de reto —enrolamiento y segundo
    factor— AccessToken viene vacío a propósito. Leerlo como si fuera un JWT es lo que hacía que
    unas credenciales buenas terminaran en "credenciales inválidas".
*@
@code {
    private LoginModel _model = new();
    private bool _busy;
    private string _error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo("/admin");
    }

    private async Task HandleLogin()
    {
        _busy  = true;
        _error = string.Empty;
        Challenge.Clear();

        var (outcome, refreshToken) = await Api.LoginForTokensAsync(_model.Email, _model.Password);

        if (!outcome.Success || outcome.Data is null)
        {
            _error = MessageFor(outcome.ErrorCode);
            _busy  = false;
            return;
        }

        var tokens = outcome.Data;

        // 1) El rol exige segundo factor y la cuenta no lo tiene configurado. La API entrega un
        //    token de enrolamiento y NINGÚN token de acceso, así que aquí no hay nada que hacer:
        //    falta la pantalla del QR. Ver el informe — es trabajo de interfaz pendiente.
        if (tokens.RequiresEnrollment)
        {
            _error = "Esta cuenta tiene que configurar su aplicación autenticadora antes de entrar, " +
                     "y esta aplicación todavía no tiene esa pantalla. Hazlo desde el portal web de " +
                     "administración y vuelve a intentarlo aquí.";
            _busy  = false;
            return;
        }

        // 2) Segundo factor pendiente: el código va en otra pantalla. El reto no se enseña ni se
        //    escribe, queda guardado en memoria hasta que se canjee.
        if (tokens.RequiresTwoFactor)
        {
            if (string.IsNullOrWhiteSpace(tokens.ChallengeToken))
            {
                _error = MessageFor("INVALID_CREDENTIALS");
                _busy  = false;
                return;
            }

            Challenge.Start(tokens.ChallengeToken!, tokens.MaskedTarget, tokens.Channel);
            _busy = false;
            Navigation.NavigateTo("/admin/two-factor");
            return;
        }

        // 3) Cuenta sin segundo factor: la API ya entregó la sesión.
        await AuthProvider.NotifyLoginAsync(tokens.AccessToken, refreshToken);
        await ViewContextInitializer.InitializeAsync();
        _busy = false;
        Navigation.NavigateTo("/admin");
    }

    /// <summary>
    /// El texto lo decide la pantalla; la API solo manda el código. Credenciales malas y cuenta
    /// bloqueada se cuentan distinto porque la salida del usuario es distinta: una se arregla
    /// escribiendo bien y la otra esperando.
    /// </summary>
    private static string MessageFor(string? errorCode) => errorCode switch
    {
        "ACCOUNT_LOCKED"       => "Cuenta bloqueada temporalmente por intentos fallidos. Prueba en unos minutos.",
        "TOO_MANY_REQUESTS"    => "Demasiados intentos. Espera un momento antes de volver a probar.",
        AuthApiGateway.Unreachable => "No se pudo contactar con el servicio de autenticación.",
        _                      => "Correo o contraseña incorrectos."
    };

    private class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = string.Empty;
    }
}
