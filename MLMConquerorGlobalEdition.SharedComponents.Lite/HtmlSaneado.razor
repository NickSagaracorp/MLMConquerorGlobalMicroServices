@using MLMConquerorGlobalEdition.SharedKernel.Security
@*
    El único sitio de los portales y del alta que pinta HTML que viene de la base (descripciones de
    productos y de concursos). Pasa siempre por HtmlSeguro, la misma política con la que AdminAPI lo
    limpia al guardarlo: lo que se guardó antes de esa limpieza, o por otro camino, tampoco ejecuta
    nada aquí. Para texto plano no se usa: se pinta con @@ normal.
*@
@((MarkupString)_limpio)

@code {
    [Parameter] public string? Html { get; set; }

    private string _limpio = string.Empty;
    private string? _ultimo;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Html, _ultimo))
        {
            _ultimo = Html;
            _limpio = HtmlSeguro.Limpiar(Html);
        }
    }
}
