@using MLMConquerorGlobalEdition.SharedComponents.Components.Account
@using Microsoft.Extensions.Localization
@using MLMConquerorGlobalEdition.SharedComponents.Resources
@inject IStringLocalizer<SharedResources> L

@* Las cuatro rutas del área de cuenta de administración, escritas UNA vez.

   AccountLayout no trae ninguna ruta escrita dentro a propósito: las recibe como parámetro
   porque administración cuelga de /admin/account/... y el portal de miembros usa otra raíz. Eso
   deja el problema de que las seis páginas de aquí tendrían que repetir las mismas cuatro
   direcciones, y con seis copias basta que una se quede atrás cuando una ruta cambie para que el
   menú lateral lleve a un 404 desde una sola de las secciones — que es justo el fallo más difícil
   de ver, porque desde las otras cinco sigue funcionando.

   También centraliza la degradación: cuando account-status no se puede leer, todas las páginas
   de gestión enseñan lo mismo —la navegación, para poder irse a otra sección, y un aviso en
   lugar del contenido— en vez de reventar con una referencia nula. *@

<AccountLayout ActiveSection="@ActiveSection"
               ProfileUrl="/admin/account"
               PasswordUrl="/admin/account/password"
               SecurityUrl="/admin/account/security"
               PersonalDataUrl="/admin/account/personal-data">
    @if (Unavailable)
    {
        <div class="alert alert-danger" role="alert">
            @L[AccountMessages.ErrorKeyFor(ErrorCode)]
        </div>
    }
    else
    {
        @ChildContent
    }
</AccountLayout>

@code {
    /// <summary>
    /// Sección activa. Usa las constantes de <see cref="AccountLayout"/>
    /// (<c>ProfileSection</c>, <c>PasswordSection</c>…), no literales: un error de tecleo dejaría
    /// el menú sin marcar nada y sin fallar.
    /// </summary>
    [Parameter, EditorRequired]
    public string ActiveSection { get; set; } = string.Empty;

    /// <summary>
    /// No se pudieron cargar los datos de la cuenta. Enseña el aviso en lugar del contenido.
    /// </summary>
    [Parameter]
    public bool Unavailable { get; set; }

    /// <summary>Por qué no se pudieron cargar, para que el aviso diga algo concreto.</summary>
    [Parameter]
    public string? ErrorCode { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }
}
