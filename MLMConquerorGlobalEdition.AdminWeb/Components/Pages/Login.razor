@page "/admin/login"
@layout MLMConquerorGlobalEdition.SharedComponents.Components.Layout.BlankLayout
@using MLMConquerorGlobalEdition.SharedComponents.Resources
@inject Microsoft.Extensions.Localization.IStringLocalizer<MLMConquerorGlobalEdition.SharedComponents.Resources.SharedResources> L

<div class="login-wrapper-admin">
    <div class="login-card-admin">
        <div class="login-logo">
            <h2 class="text-white">MLM Conqueror</h2>
            <p class="text-muted">Administration Portal</p>
        </div>

        @* Qué códigos entiende esta pantalla y con qué aviso lo dice cada uno vive en
           LoginErrorMessages, compartido con el login del centro de negocios. Estaba escrito aquí
           como una cadena de @if con los textos en inglés a fuego, y así fue como
           SERVICE_UNAVAILABLE —que la puerta ya emitía cuando SignupAPI no responde— se quedó sin
           traducir en los dos portales: el usuario veía el formulario otra vez, sin un solo aviso. *@
        @if (LoginErrorMessages.For(Error) is { } loginError)
        {
            <div class="alert @loginError.AlertClass">@L[loginError.ResourceKey]</div>
        }

        <form method="post" action="/account/login">
            <div class="mb-3">
                <label class="form-label text-light">Email</label>
                <input name="Email" type="email" class="form-control" required autocomplete="username" />
            </div>
            <div class="mb-3">
                <label class="form-label text-light">Password</label>
                <input name="Password" type="password" class="form-control" required autocomplete="current-password" />
            </div>
            <button type="submit" class="btn btn-warning w-100 fw-semibold">
                Sign In to Admin
            </button>
        </form>
    </div>
</div>

@* Las clases .login-wrapper-admin / .login-card-admin / .login-logo viven en wwwroot/app.css:
   las comparten esta página, /admin/login-2fa y /admin/enroll-authenticator. *@

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }
}
