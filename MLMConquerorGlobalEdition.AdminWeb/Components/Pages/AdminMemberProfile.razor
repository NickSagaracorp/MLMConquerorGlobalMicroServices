@page "/admin/members/{MemberId}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HttpClient Http
@inject NavigationManager Nav
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime Js

@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs

<PageTitle>Member Profile — Admin</PageTitle>

<BreadcrumbNav Items="@(new List<BreadcrumbNav.BreadcrumbItem> { new("Admin Dashboard", "/admin"), new("Members", "/admin/members"), new(@MemberId) })" />

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (_member is null)
{
    <div class="alert alert-danger">Member not found.</div>
}
else
{
    @* Admin-only action strip — Tree/Genealogy/Impersonate links live here so they
       are reachable from any tab. The header banner with name + avatar + status now
       comes from <UserProfilePage>'s ProfileHeaderCard inside the Profile tab; on
       other tabs the breadcrumb plus this strip carry the context. *@
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="fw-semibold">@_member.FirstName @_member.LastName</span>
                <code class="ms-2">@_member.MemberId</code>
                <span class="badge bg-secondary ms-2">@_member.MemberType</span>
                <span class="badge @StatusBadge(_member.Status) ms-1">@_member.Status</span>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <a href="/admin/network/binary-tree?memberId=@MemberId" class="btn btn-outline-primary btn-sm">
                    <i class="ri-share-circle-line me-1"></i>Binary Tree
                </a>
                <a href="/admin/network/genealogy?memberId=@MemberId" class="btn btn-outline-primary btn-sm">
                    <i class="ri-node-tree me-1"></i>Genealogy
                </a>
                <button class="btn btn-outline-danger btn-sm" @onclick="ToggleImpersonate">
                    <i class="ri-spy-line me-1"></i>Impersonate
                </button>
            </div>
        </div>
    </div>

    <!-- Horizontal tab nav — pill style matching BizCenter UserProfilePage -->
    <ul class="nav nav-pills profile-top-tabs mb-4 d-flex flex-wrap gap-2" role="tablist">
        @foreach (var tab in _tabs)
        {
            var tk = tab.Key;
            <li class="nav-item">
                <button class="nav-link @(_activeTab == tk ? "active" : "")"
                        @onclick="() => OnTabClick(tk)" type="button">
                    <i class="@tab.Icon me-1"></i>@tab.Label
                </button>
            </li>
        }
    </ul>

    <!-- Tab content -->
    @if (_activeTab == "profile")
    {
        @*
            Same component the ambassador sees at /profile. Drives URL flips to
            api/v1/admin/members/{MemberId}/... via ProfileApiBase cascade so the
            admin reads/writes the selected member without an impersonation step.
            Sensitive entry points (password, email, 2FA, replicate-site, photo
            upload) are auto-hidden when ViewContext.IsAdminContext is true.
        *@
        <UserProfilePage MemberProfileId="@MemberId" />

        @* Network/Income stat strip — admin-only context that the shared profile
           component does not surface. Keep visible alongside the unified UI so
           support staff still see at-a-glance team metrics on this page. *@
        <div class="row g-4 mt-1">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h5 class="fw-semibold border-bottom pb-3 mb-3">Network Stats</h5>
                        <dl class="row mb-0">
                            <dt class="col-7 text-muted">Dual Team Pts</dt>
                            <dd class="col-5 fw-semibold">@_member.DualTeamPoints</dd>
                            <dt class="col-7 text-muted">Dual Team Size</dt>
                            <dd class="col-5 fw-semibold">@_member.DualTeamSize</dd>
                            <dt class="col-7 text-muted">Enroll Pts</dt>
                            <dd class="col-5 fw-semibold">@_member.EnrollmentPoints</dd>
                            <dt class="col-7 text-muted">Enroll Team Size</dt>
                            <dd class="col-5 fw-semibold">@_member.EnrollmentTeamSize</dd>
                            <dt class="col-7 text-muted">Current Rank</dt>
                            <dd class="col-5 fw-semibold">
                                @if (!string.IsNullOrEmpty(_member.CurrentRank))
                                {
                                    <span class="badge bg-info text-dark">@_member.CurrentRank</span>
                                }
                                else { <span class="text-muted">—</span> }
                            </dd>
                            <dt class="col-7 text-muted">Lifetime Rank</dt>
                            <dd class="col-5 fw-semibold">
                                @if (!string.IsNullOrEmpty(_member.LifetimeRank))
                                {
                                    <span class="badge bg-primary">@_member.LifetimeRank</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h5 class="fw-semibold border-bottom pb-3 mb-3">Income</h5>
                        <dl class="row mb-0">
                            <dt class="col-7 text-muted">Current Month</dt>
                            <dd class="col-5 fw-semibold text-success">$@_member.CurrentMonthIncome.ToString("F2")</dd>
                            <dt class="col-7 text-muted">Current Year</dt>
                            <dd class="col-5 fw-semibold text-success">$@_member.CurrentYearIncome.ToString("F2")</dd>
                            <dt class="col-7 text-muted">Sponsor</dt>
                            <dd class="col-5 fw-semibold">
                                @if (!string.IsNullOrWhiteSpace(_member.SponsorMemberId))
                                {
                                    <a href="/admin/members/@_member.SponsorMemberId" target="_blank" rel="noopener" class="text-primary text-decoration-none">
                                        @(string.IsNullOrWhiteSpace(_member.SponsorFullName) ? _member.SponsorMemberId : _member.SponsorFullName)
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </dd>
                            <dt class="col-7 text-muted">Dual Team Upline</dt>
                            <dd class="col-5 fw-semibold">
                                @if (!string.IsNullOrWhiteSpace(_member.DualTeamUplineMemberId))
                                {
                                    <a href="/admin/members/@_member.DualTeamUplineMemberId" target="_blank" rel="noopener" class="text-primary text-decoration-none">
                                        @(string.IsNullOrWhiteSpace(_member.DualTeamUplineFullName) ? _member.DualTeamUplineMemberId : _member.DualTeamUplineFullName)
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (_activeTab == "status")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h5 class="fw-semibold border-bottom pb-3 mb-4">Change Member Status</h5>
                <div class="row g-3" style="max-width:400px;">
                    <div class="col-12">
                        <label class="form-label fw-semibold">New Status</label>
                        <select class="form-select" @bind="_newStatus">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                            <option value="Suspended">Suspended</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Reason</label>
                        <input class="form-control" @bind="_statusReason" placeholder="Reason for status change" />
                    </div>
                    <div class="col-12">
                        <button class="btn btn-primary" @onclick="SaveStatus" disabled="@_savingStatus">
                            @if (_savingStatus) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Update Status
                        </button>
                        @if (_statusMsg is not null)
                        {
                            <span class="ms-3 @(_statusError ? "text-danger" : "text-success") small">@_statusMsg</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else if (_activeTab == "enrollment")
    {
        <!-- Enrollment Team sub-tabs -->
        <ul class="nav nav-pills profile-sub-tabs mb-4 d-flex flex-wrap gap-2" role="tablist">
            <li class="nav-item">
                <button class="nav-link @(_enrollSub == "myteam" ? "active" : "")"
                        @onclick='() => _enrollSub = "myteam"' type="button">
                    <i class="ri-group-line me-1"></i>My Team
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_enrollSub == "branches" ? "active" : "")"
                        @onclick='() => _enrollSub = "branches"' type="button">
                    <i class="ri-git-branch-line me-1"></i>Branches
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_enrollSub == "customers" ? "active" : "")"
                        @onclick='() => _enrollSub = "customers"' type="button">
                    <i class="ri-user-heart-line me-1"></i>Customers
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_enrollSub == "visualizer" ? "active" : "")"
                        @onclick='() => _enrollSub = "visualizer"' type="button">
                    <i class="ri-organization-chart me-1"></i>Visualizer
                </button>
            </li>
        </ul>

        @if (_enrollSub == "myteam")
        {
            <EnrollmentTeamMyTeam    MemberProfileId="@MemberId"
                                     ApiBaseUrl="@($"api/v1/admin/members/{MemberId}/team/enrollment")"
                                     ShowBreadcrumb="false" />
        }
        else if (_enrollSub == "branches")
        {
            <EnrollmentTeamBranches  MemberProfileId="@MemberId"
                                     ApiBaseUrl="@($"api/v1/admin/members/{MemberId}/team/enrollment")"
                                     ShowBreadcrumb="false" />
        }
        else if (_enrollSub == "customers")
        {
            <EnrollmentTeamCustomers MemberProfileId="@MemberId"
                                     ApiBaseUrl="@($"api/v1/admin/members/{MemberId}/team/enrollment")"
                                     ShowBreadcrumb="false" />
        }
        else if (_enrollSub == "visualizer")
        {
            <EnrollmentVisualizer    MemberProfileId="@MemberId"
                                     ApiBaseUrl="@($"api/v1/admin/members/{MemberId}/team/enrollment/visualizer")"
                                     ShowBreadcrumb="false" />
        }
    }

    else if (_activeTab == "commissions")
    {
        <!-- Commission sub-tabs -->
        <ul class="nav nav-pills profile-sub-tabs mb-4 d-flex flex-wrap gap-2" role="tablist">
            <li class="nav-item">
                <button class="nav-link @(_commSub == "overview" ? "active" : "")"
                        @onclick='() => _commSub = "overview"' type="button">
                    <i class="ri-money-dollar-circle-line me-1"></i>Overview
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_commSub == "faststart" ? "active" : "")"
                        @onclick='() => _commSub = "faststart"' type="button">
                    <i class="ri-trophy-line me-1"></i>Fast Start
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_commSub == "presidential" ? "active" : "")"
                        @onclick='() => _commSub = "presidential"' type="button">
                    <i class="ri-award-line me-1"></i>Presidential
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_commSub == "boost" ? "active" : "")"
                        @onclick='() => _commSub = "boost"' type="button">
                    <i class="ri-medal-line me-1"></i>Boost
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_commSub == "carbonus" ? "active" : "")"
                        @onclick='() => _commSub = "carbonus"' type="button">
                    <i class="ri-car-line me-1"></i>Car Bonus
                </button>
            </li>
        </ul>

        @if (_commSub == "overview")
        {
            <CommissionsDashboard MemberProfileId="@MemberId"
                                  ApiBaseUrl="@($"api/v1/admin/members/{MemberId}/commissions")"
                                  ShowBreadcrumb="false"
                                  IsAdminView="true" />
        }
        else if (_commSub == "faststart")
        {
            <FastStartBonusReport MemberProfileId="@MemberId"
                                  ApiBaseUrl="@($"api/v1/admin/members/{MemberId}/commissions")"
                                  ShowBreadcrumb="false" />
        }
        else if (_commSub == "presidential")
        {
            <PresidentialBonusReport MemberProfileId="@MemberId"
                                     ApiBaseUrl="@($"api/v1/admin/members/{MemberId}/commissions")"
                                     ShowBreadcrumb="false" />
        }
        else if (_commSub == "boost")
        {
            <BoostBonusReport MemberProfileId="@MemberId"
                              ApiBaseUrl="@($"api/v1/admin/members/{MemberId}/commissions")"
                              ShowBreadcrumb="false" />
        }
        else if (_commSub == "carbonus")
        {
            <CarBonusReport MemberProfileId="@MemberId"
                            ApiBaseUrl="@($"api/v1/admin/members/{MemberId}/commissions")"
                            TeamApiBaseUrl="@($"api/v1/admin/members/{MemberId}/team")"
                            ShowBreadcrumb="false" />
        }
    }
    else if (_activeTab == "ranks")
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h5 class="fw-semibold border-bottom pb-3 mb-4">Set Lifetime Rank</h5>
                <div class="row g-3" style="max-width:440px;">
                    <div class="col-12">
                        <label class="form-label fw-semibold">Current Rank</label>
                        <p class="mb-1">
                            @if (!string.IsNullOrEmpty(_member?.CurrentRank))
                            {
                                <span class="badge bg-info text-dark fs-13">@_member.CurrentRank</span>
                            }
                            else { <span class="text-muted">— No rank assigned</span> }
                        </p>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Lifetime Rank (Highest Ever)</label>
                        <p class="mb-1">
                            @if (!string.IsNullOrEmpty(_member?.LifetimeRank))
                            {
                                <span class="badge bg-primary fs-13">@_member.LifetimeRank</span>
                            }
                            else { <span class="text-muted">— No rank assigned</span> }
                        </p>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">New Rank</label>
                        <select class="form-select" @bind="_newRankId" disabled="@(_rankDefs.Count == 0)">
                            <option value="0">— Select a rank —</option>
                            @foreach (var r in _rankDefs)
                            {
                                <option value="@r.Id">@r.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <button class="btn btn-primary" @onclick="SaveRank" disabled="@(_savingRank || _newRankId == 0)">
                            @if (_savingRank) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Set Rank
                        </button>
                        @if (_rankMsg is not null)
                        {
                            <span class="ms-3 @(_rankError ? "text-danger" : "text-success") small">@_rankMsg</span>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4 text-center py-4">
                <i class="ri-award-line fs-2 text-primary d-block mb-3"></i>
                <a href="/admin/config/ranks/dashboard?memberId=@MemberId" class="btn btn-outline-primary btn-sm">
                    <i class="ri-external-link-line me-1"></i>View Rank Dashboard
                </a>
            </div>
        </div>

        @* ── Rank Certificates ─────────────────────────────────────────────
           Certificate-eligible rank achievements for this member, served by
           RankEngine (https://localhost:7009). Admins can generate, view,
           regenerate or delete the PDF certificate per achievement. *@
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3 flex-wrap gap-2">
                    <h5 class="fw-semibold mb-0">
                        <i class="ri-medal-2-line text-primary me-2"></i>Rank Certificates
                    </h5>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadCertificatesAsync" disabled="@_certLoading">
                        <i class="ri-refresh-line me-1"></i>Refresh
                    </button>
                </div>

                @if (_certMsg is not null)
                {
                    <div class="alert @(_certError ? "alert-danger" : "alert-success") alert-dismissible">
                        @_certMsg
                        <button type="button" class="btn-close" @onclick="() => _certMsg = null"></button>
                    </div>
                }

                @if (_certLoading)
                {
                    <div class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                }
                else if (_certLoadError is not null)
                {
                    <div class="alert alert-danger mb-0">@_certLoadError</div>
                }
                else if (_certificates.Count == 0)
                {
                    <div class="text-center py-4 text-muted">
                        <i class="ri-medal-2-line fs-2 d-block mb-2"></i>
                        <p class="mb-0">This member has no certificate-eligible rank achievements yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Rank</th>
                                    <th>First Achieved</th>
                                    <th>Certificate</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cert in _certificates.OrderBy(c => c.SortOrder))
                                {
                                    <tr @key="cert.MemberRankHistoryId">
                                        <td class="fw-semibold">
                                            <span class="badge bg-info text-dark fs-13">@cert.RankName</span>
                                        </td>
                                        <td>@cert.FirstAchievedAt.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            @if (cert.HasCertificate)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="ri-check-line me-1"></i>Generated
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="ri-close-line me-1"></i>Not generated
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @{ var busy = _certBusyId == cert.MemberRankHistoryId; }
                                            @if (cert.HasCertificate)
                                            {
                                                @if (!string.IsNullOrWhiteSpace(cert.CertificateUrl))
                                                {
                                                    <a href="@cert.CertificateUrl" target="_blank" rel="noopener"
                                                       class="btn btn-outline-primary btn-sm me-1">
                                                        <i class="ri-file-pdf-2-line me-1"></i>View PDF
                                                    </a>
                                                }
                                                <button class="btn btn-outline-secondary btn-sm me-1"
                                                        @onclick="() => RegenerateCertificateAsync(cert.MemberRankHistoryId)"
                                                        disabled="@busy">
                                                    @if (busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                                    else { <i class="ri-refresh-line me-1"></i> }
                                                    Regenerate
                                                </button>
                                                <button class="btn btn-outline-danger btn-sm"
                                                        @onclick="() => DeleteCertificateAsync(cert.MemberRankHistoryId, cert.RankName)"
                                                        disabled="@busy">
                                                    <i class="ri-delete-bin-line me-1"></i>Delete
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-primary btn-sm"
                                                        @onclick="() => GenerateCertificateAsync(cert.MemberRankHistoryId)"
                                                        disabled="@busy">
                                                    @if (busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                                    else { <i class="ri-add-line me-1"></i> }
                                                    Generate
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
    else if (_activeTab == "membership")
    {
        @if (_membershipLoading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
        }
        else if (_membershipError is not null)
        {
            <div class="alert alert-danger">@_membershipError</div>
        }
        else if (_membership is null)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 text-center py-5">
                    <i class="ri-vip-crown-line fs-2 text-muted d-block mb-3"></i>
                    <p class="text-muted mb-0">No membership found.</p>
                </div>
            </div>
        }
        else
        {
            <!-- Membership summary card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between flex-wrap gap-3 align-items-start mb-4">
                        <div>
                            <h5 class="fw-semibold mb-2">
                                <i class="ri-vip-crown-line text-primary me-2"></i>
                                Membership Details
                            </h5>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <span class="badge bg-primary fs-13">@(_membership.MembershipLevelName ?? "—")</span>
                                <span class="badge @MembershipStatusBadge(_membership.Status) fs-13">@_membership.Status</span>
                                @if (_membership.IsFree)
                                {
                                    <span class="badge bg-info text-dark fs-13">
                                        <i class="ri-gift-line me-1"></i>Free
                                    </span>
                                }
                                @if (_membership.IsAutoRenew)
                                {
                                    <span class="badge bg-success fs-13">
                                        <i class="ri-refresh-line me-1"></i>Auto-Renew
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary fs-13">
                                        <i class="ri-close-circle-line me-1"></i>No Auto-Renew
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6 col-lg-4">
                            <div class="border rounded p-3 h-100">
                                <small class="text-muted d-block mb-1">Start Date</small>
                                <span class="fw-semibold">@_membership.StartDate.ToString("yyyy-MM-dd")</span>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-4">
                            <div class="border rounded p-3 h-100">
                                <small class="text-muted d-block mb-1">End Date</small>
                                <span class="fw-semibold">
                                    @(_membership.EndDate.HasValue ? _membership.EndDate.Value.ToString("yyyy-MM-dd") : "No expiry")
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-4">
                            <div class="border rounded p-3 h-100">
                                <small class="text-muted d-block mb-1">Renewal Date</small>
                                <span class="fw-semibold">
                                    @(_membership.RenewalDate.HasValue ? _membership.RenewalDate.Value.ToString("yyyy-MM-dd") : "—")
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-4">
                            <div class="border rounded p-3 h-100">
                                <small class="text-muted d-block mb-1">Change Reason</small>
                                <span class="fw-semibold">@(_membership.ChangeReason ?? "—")</span>
                            </div>
                        </div>
                        @if (_membership.HoldDate.HasValue)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="border rounded p-3 h-100">
                                    <small class="text-muted d-block mb-1">Hold Date</small>
                                    <span class="fw-semibold text-warning">@_membership.HoldDate.Value.ToString("yyyy-MM-dd")</span>
                                </div>
                            </div>
                        }
                        @if (_membership.CancellationDate.HasValue)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="border rounded p-3 h-100">
                                    <small class="text-muted d-block mb-1">Cancellation Date</small>
                                    <span class="fw-semibold text-danger">@_membership.CancellationDate.Value.ToString("yyyy-MM-dd")</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Related Orders -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="fw-semibold border-bottom pb-3 mb-3">
                        <i class="ri-shopping-bag-line text-primary me-2"></i>
                        Related Orders
                    </h5>
                    @if (_membership.Orders is null || _membership.Orders.Count == 0)
                    {
                        <p class="text-muted text-center py-4 mb-0">No related orders found.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Order No</th>
                                        <th>Date</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ord in _membership.Orders)
                                    {
                                        <tr>
                                            <td class="fw-semibold"><code>@ord.OrderNo</code></td>
                                            <td>@ord.OrderDate.ToString("yyyy-MM-dd")</td>
                                            <td class="fw-semibold text-success">$@ord.TotalAmount.ToString("F2")</td>
                                            <td><span class="badge @OrderStatusBadge(ord.Status)">@ord.Status</span></td>
                                            <td>@(string.IsNullOrWhiteSpace(ord.Notes) ? "—" : ord.Notes)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else if (_activeTab == "dualteam")
    {
        <!-- Dual Team sub-tabs -->
        <ul class="nav nav-pills profile-sub-tabs mb-4 d-flex flex-wrap gap-2" role="tablist">
            <li class="nav-item">
                <button class="nav-link @(_dualSub == "myteam" ? "active" : "")"
                        @onclick='() => _dualSub = "myteam"' type="button">
                    <i class="ri-group-line me-1"></i>My Team
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_dualSub == "visualizer" ? "active" : "")"
                        @onclick='() => _dualSub = "visualizer"' type="button">
                    <i class="ri-share-circle-line me-1"></i>Visualizer
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_dualSub == "residuals" ? "active" : "")"
                        @onclick='() => _dualSub = "residuals"' type="button">
                    <i class="ri-money-dollar-circle-line me-1"></i>Residuals
                </button>
            </li>
        </ul>

        @if (_dualSub == "myteam")
        {
            <DualTeamMyTeam MemberProfileId="@MemberId"
                            ApiBaseUrl="@($"api/v1/admin/members/{MemberId}/team")"
                            ShowBreadcrumb="false" />
        }
        else if (_dualSub == "visualizer")
        {
            <DualTeamBinaryTree MemberProfileId="@MemberId"
                                ApiBaseUrl="@($"api/v1/admin/members/{MemberId}/team")"
                                PlacementApiBaseUrl="api/v1/admin/placement"
                                AllowUnplacement="true"
                                ShowBreadcrumb="false" />
        }
        else if (_dualSub == "residuals")
        {
            <DualTeamResiduals MemberProfileId="@MemberId"
                               ApiBaseUrl="@($"api/v1/admin/members/{MemberId}")"
                               EnrollDate="@_member.EnrollDate"
                               ShowBreadcrumb="false" />
        }
    }
    else if (_activeTab == "orders")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 text-center py-5">
                <i class="ri-shopping-bag-line fs-2 text-primary d-block mb-3"></i>
                <p class="text-muted mb-3">View order history for this member.</p>
                <a href="/admin/billing/payments?memberId=@MemberId" class="btn btn-primary btn-sm">
                    <i class="ri-external-link-line me-1"></i>View Payment History
                </a>
            </div>
        </div>
    }
    else if (_activeTab == "tokens")
    {
        <TokensPage MemberProfileId="@MemberId"
                    ApiBaseUrl="@($"api/v1/admin/members/{MemberId}")" />
    }
    else if (_activeTab == "tickets")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 text-center py-5">
                <i class="ri-customer-service-2-line fs-2 text-primary d-block mb-3"></i>
                <p class="text-muted mb-3">View support tickets for this member.</p>
                <a href="/admin/tickets?memberId=@MemberId" class="btn btn-primary btn-sm">
                    <i class="ri-external-link-line me-1"></i>View Tickets
                </a>
            </div>
        </div>
    }
}

@code {
    [Parameter] public string MemberId { get; set; } = string.Empty;

    private MemberDetailDto? _member;
    private bool _loading = true;
    private string _activeTab = "profile";
    private string _newStatus = "Active";
    private string? _statusReason;
    private bool _savingStatus;
    private string? _statusMsg;
    private bool _statusError;

    // Rank state
    private List<RankDefItem> _rankDefs = new();
    private int    _newRankId  = 0;
    private bool   _savingRank = false;
    private string? _rankMsg;
    private bool    _rankError;

    private record TabItem(string Key, string Label, string Icon);

    private readonly List<TabItem> _tabs = new()
    {
        new("profile",    "Profile",         "ri-user-line"),
        new("status",     "Status",          "ri-toggle-line"),
        new("enrollment", "Enrollment Team", "ri-organization-chart"),
        new("dualteam",   "Dual Team",       "ri-share-circle-line"),
        new("commissions","Commissions",     "ri-money-dollar-circle-line"),
        new("ranks",      "Ranks",           "ri-award-line"),
        new("membership", "Membership",      "ri-vip-crown-line"),
        new("orders",     "Orders",          "ri-shopping-bag-line"),
        new("tokens",     "Tokens",          "ri-token-swap-line"),
        new("tickets",    "Tickets",         "ri-customer-service-2-line"),
    };

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            var resp = await Http.GetFromJsonAsync<ApiResp<MemberDetailDto>>($"api/v1/admin/members/{MemberId}");
            if (resp?.Success == true)
            {
                _member    = resp.Data;
                _newStatus = _member?.Status ?? "Active";
            }
        }
        catch { }
        finally { _loading = false; }

        try
        {
            var rankResp = await Http.GetFromJsonAsync<ApiResp<List<RankDefItem>>>("api/v1/admin/rank-definitions");
            if (rankResp?.Success == true && rankResp.Data is not null)
                _rankDefs = rankResp.Data;
        }
        catch { }
    }

    private async Task SaveRank()
    {
        if (_newRankId == 0) return;
        _savingRank = true; _rankMsg = null;
        try
        {
            var resp = await Http.PutAsJsonAsync(
                $"api/v1/admin/members/{MemberId}/ranks/lifetime",
                new { RankDefinitionId = _newRankId });

            if (resp.IsSuccessStatusCode)
            {
                var selected = _rankDefs.FirstOrDefault(r => r.Id == _newRankId);
                _rankMsg = $"Rank updated to '{selected?.Name}'."; _rankError = false;
                if (_member is not null)
                    _member = _member with { LifetimeRank = selected?.Name, LifetimeRankId = _newRankId };
                _newRankId = 0;
            }
            else { _rankMsg = $"Failed ({resp.StatusCode})."; _rankError = true; }
        }
        catch (Exception ex) { _rankMsg = ex.Message; _rankError = true; }
        finally { _savingRank = false; }
    }

    private async Task SaveStatus()
    {
        _savingStatus = true; _statusMsg = null;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/v1/admin/members/{MemberId}/status", new { Status = _newStatus, Reason = _statusReason });
            if (response.IsSuccessStatusCode)
            {
                _statusMsg = "Status updated."; _statusError = false;
                if (_member is not null)
                    _member = _member with { Status = _newStatus };
            }
            else { _statusMsg = $"Failed ({response.StatusCode})."; _statusError = true; }
        }
        catch (Exception ex) { _statusMsg = ex.Message; _statusError = true; }
        finally { _savingStatus = false; }
    }

    private void ToggleImpersonate()
        => Nav.NavigateTo($"/admin/impersonate/{MemberId}");

    private static string StatusBadge(string status) => status switch
    {
        "Active"    => "bg-success",
        "Suspended" => "bg-warning text-dark",
        _           => "bg-secondary"
    };

    // ── Enrollment Team state ──────────────────────────────────────────────
    private string _enrollSub = "myteam";

    // ── Dual Team state ────────────────────────────────────────────────────
    private string _dualSub = "myteam";

    // ── Commissions state ──────────────────────────────────────────────────
    private string _commSub = "overview";

    private async Task OnTabClick(string tabKey)
    {
        _activeTab = tabKey;

        // Lazy-load tab-specific data on first activation
        if (tabKey == "membership" && _membership is null && !_membershipLoaded)
        {
            await LoadMembershipAsync();
        }
        else if (tabKey == "ranks" && !_certLoaded)
        {
            await LoadCertificatesAsync();
        }
    }

    // ── Rank Certificates state ───────────────────────────────────────────
    private List<RankCertificateDto> _certificates = new();
    private bool    _certLoading;
    private bool    _certLoaded;
    private string? _certLoadError;
    private string? _certBusyId;
    private string? _certMsg;
    private bool    _certError;

    private HttpClient RankEngineClient => HttpClientFactory.CreateClient("RankEngineApi");

    private async Task LoadCertificatesAsync()
    {
        _certLoading   = true;
        _certLoadError = null;
        try
        {
            var resp = await RankEngineClient.GetFromJsonAsync<ApiResp<List<RankCertificateDto>>>(
                $"api/v1/ranks/certificates/{MemberId}");
            if (resp?.Success == true)
            {
                _certificates = resp.Data ?? new();
            }
            else
            {
                _certLoadError = FormatApiError(resp, "Unable to load rank certificates.");
            }
        }
        catch (Exception ex)
        {
            _certLoadError = ex.Message;
        }
        finally
        {
            _certLoading = false;
            _certLoaded  = true;
        }
    }

    private async Task GenerateCertificateAsync(string memberRankHistoryId)
        => await RunCertificateActionAsync(
            memberRankHistoryId,
            client => client.PostAsync($"api/v1/ranks/certificate/generate/{memberRankHistoryId}", null),
            "Certificate generated.");

    private async Task RegenerateCertificateAsync(string memberRankHistoryId)
        => await RunCertificateActionAsync(
            memberRankHistoryId,
            client => client.PostAsync($"api/v1/ranks/certificate/{memberRankHistoryId}/regenerate", null),
            "Certificate regenerated.");

    private async Task DeleteCertificateAsync(string memberRankHistoryId, string rankName)
    {
        var confirmed = await Js.InvokeAsync<bool>(
            "confirm", $"Delete the certificate for '{rankName}'? This cannot be undone.");
        if (!confirmed) return;

        await RunCertificateActionAsync(
            memberRankHistoryId,
            client => client.DeleteAsync($"api/v1/ranks/certificate/{memberRankHistoryId}"),
            "Certificate deleted.");
    }

    /// <summary>
    /// Runs a certificate POST/DELETE action, then reloads the list and surfaces
    /// a success / error alert using the page's existing alert pattern.
    /// </summary>
    private async Task RunCertificateActionAsync(
        string memberRankHistoryId,
        Func<HttpClient, Task<HttpResponseMessage>> action,
        string successMessage)
    {
        _certBusyId = memberRankHistoryId;
        _certMsg    = null;
        try
        {
            var client   = RankEngineClient;
            var response = await action(client);
            ApiResp<object>? body = null;
            try { body = await response.Content.ReadFromJsonAsync<ApiResp<object>>(); }
            catch { /* non-JSON body (e.g. 204 / error page) — fall back to status code */ }

            if (response.IsSuccessStatusCode && body?.Success != false)
            {
                _certMsg   = successMessage;
                _certError = false;
            }
            else
            {
                _certMsg   = FormatApiError(body, $"Action failed ({(int)response.StatusCode}).");
                _certError = true;
            }
        }
        catch (Exception ex)
        {
            _certMsg   = ex.Message;
            _certError = true;
        }
        finally
        {
            _certBusyId = null;
        }

        // Reload the list so status / URL reflect the result.
        await LoadCertificatesAsync();
    }

    /// <summary>Builds a human-readable error from a non-success ApiResponse envelope.</summary>
    private static string FormatApiError<T>(ApiResp<T>? resp, string fallback)
    {
        if (resp is null) return fallback;
        var parts = new List<string>();
        if (resp.Errors is not null)
            parts.AddRange(resp.Errors.Where(e => !string.IsNullOrWhiteSpace(e)));
        var detail = parts.Count > 0 ? string.Join(" ", parts) : null;
        var prefix = string.IsNullOrWhiteSpace(resp.ErrorCode) ? null : $"[{resp.ErrorCode}] ";
        return (prefix, detail) switch
        {
            (null,  null)   => fallback,
            (_,     null)   => $"{prefix}{fallback}",
            (null,  _)      => detail!,
            (_,     _)      => $"{prefix}{detail}"
        };
    }

    private record RankCertificateDto(
        string   MemberRankHistoryId,
        int      RankDefinitionId,
        string   RankName,
        int      SortOrder,
        DateTime FirstAchievedAt,
        string?  CertificateUrl,
        bool     HasCertificate);

    // ── Membership tab state ──────────────────────────────────────────────
    private MembershipDetailDto? _membership;
    private bool                 _membershipLoading = false;
    private bool                 _membershipLoaded  = false;
    private string?              _membershipError;
    private string               _memberId => MemberId;

    private async Task LoadMembershipAsync()
    {
        _membershipLoading = true;
        _membershipError   = null;
        try
        {
            var resp = await Http.GetFromJsonAsync<ApiResp<MembershipDetailDto>>(
                $"api/v1/admin/members/{_memberId}/membership");
            if (resp?.Success == true)
            {
                _membership = resp.Data;
            }
            else
            {
                _membershipError = resp?.Errors?.FirstOrDefault() ?? "Unable to load membership.";
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _membership = null; // no membership found -> empty state
        }
        catch (Exception ex)
        {
            _membershipError = ex.Message;
        }
        finally
        {
            _membershipLoading = false;
            _membershipLoaded  = true;
        }
    }

    private static string MembershipStatusBadge(string? status) => status switch
    {
        "Active"    => "bg-success",
        "Cancelled" => "bg-danger",
        "Expired"   => "bg-warning text-dark",
        "Pending"   => "bg-secondary",
        _           => "bg-secondary"
    };

    private static string OrderStatusBadge(string? status) => status switch
    {
        "Completed" => "bg-success",
        "Pending"   => "bg-warning text-dark",
        "Failed"    => "bg-danger",
        "Refunded"  => "bg-info text-dark",
        "Cancelled" => "bg-secondary",
        _           => "bg-secondary"
    };

    private record MembershipDetailDto(
        string    SubscriptionId,
        int       MembershipLevelId,
        string?   MembershipLevelName,
        string    Status,
        string?   ChangeReason,
        DateTime  StartDate,
        DateTime? EndDate,
        DateTime? RenewalDate,
        DateTime? HoldDate,
        DateTime? CancellationDate,
        bool      IsFree,
        bool      IsAutoRenew,
        List<MembershipOrderDto>? Orders);

    private record MembershipOrderDto(
        string    OrderId,
        string    OrderNo,
        DateTime  OrderDate,
        decimal   TotalAmount,
        string    Status,
        string?   Notes);

    private record MemberDetailDto(
        string MemberId, string FirstName, string LastName,
        string? Phone, string Country, string Status, string MemberType,
        DateTime EnrollDate,
        string? SponsorMemberId, string? SponsorFullName,
        string? DualTeamUplineMemberId, string? DualTeamUplineFullName,
        DateTime CreationDate,
        int DualTeamPoints, int EnrollmentPoints, int DualTeamSize, int EnrollmentTeamSize,
        decimal CurrentMonthIncome, decimal CurrentYearIncome,
        string? CurrentRank, int? CurrentRankId,
        string? LifetimeRank, int? LifetimeRankId);

    private record ApiResp<T>(bool Success, T? Data, IEnumerable<string>? Errors, string? ErrorCode = null);

    private class RankDefItem
    {
        public int    Id        { get; set; }
        public string Name      { get; set; } = string.Empty;
        public int    SortOrder { get; set; }
    }
}
