@page "/admin/tokens/codes"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HttpClient Http
@inject NavigationManager Nav
@using MLMConquerorGlobalEdition.SharedComponents.Components.Grid
@using Syncfusion.Blazor.Data

<PageTitle>Token Codes — Admin</PageTitle>

<BreadcrumbNav Items="@(new List<BreadcrumbNav.BreadcrumbItem> { new("Admin Dashboard", "/admin"), new("Tokens", "/admin/tokens/distribute"), new("Token Codes") })" />

@if (_alertMsg is not null)
{
    <div class="alert alert-danger alert-dismissible mb-3">
        @_alertMsg <button type="button" class="btn-close" @onclick="() => _alertMsg = null"></button>
    </div>
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-header py-3">
        <h6 class="card-title mb-0 fw-semibold">
            <i class="ri-key-2-line me-2 text-primary"></i>Token Code Lookup
        </h6>
    </div>
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-lg-4">
                <label class="form-label fw-semibold">Ambassador Member ID <span class="text-danger">*</span></label>
                <MemberPicker Value="@_memberId" ValueChanged="@OnMemberChanged" />
            </div>
            <div class="col-lg-3">
                <label class="form-label fw-semibold">Token Type</label>
                @if (_tokenTypesLoading)
                {
                    <div class="form-control text-muted small"><span class="spinner-border spinner-border-sm me-1"></span>Loading...</div>
                }
                else
                {
                    <select class="form-select" @bind="_filterTokenTypeId">
                        <option value="0">— All Types —</option>
                        @foreach (var tt in _tokenTypes)
                        {
                            <option value="@tt.Id">@tt.Name@(tt.IsGuestPass ? " (Guest Pass)" : "")</option>
                        }
                    </select>
                }
            </div>
            <div class="col-lg-2">
                <label class="form-label fw-semibold">Status</label>
                <select class="form-select" @bind="_filterIsUsed">
                    <option value="">All</option>
                    <option value="false">Available</option>
                    <option value="true">Used</option>
                </select>
            </div>
            <div class="col-lg-3">
                <button class="btn btn-primary w-100" @onclick="Search" disabled="@(string.IsNullOrWhiteSpace(_memberId) || _cargando)">
                    @if (_cargando) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    <i class="ri-search-line me-1"></i>Search Token Codes
                </button>
            </div>
        </div>
    </div>
</div>

@if (_searched)
{
    <div class="card border-0 shadow-sm">
        <div class="card-header py-3 d-flex align-items-center gap-2">
            <h6 class="card-title mb-0 fw-semibold flex-grow-1">
                <i class="ri-key-line me-2 text-primary"></i>Token Codes for <code>@_memberId</code>
            </h6>
            <span class="badge bg-secondary">@_totalCount total</span>
            <span class="badge bg-success">@_availableCount available</span>
            <span class="badge bg-secondary opacity-75">@(Math.Max(0, _totalCount - _availableCount)) used</span>
        </div>
        <div class="card-body p-0">
            @* Grid de servidor: filtros de columna, orden y página viajan al servidor por ServerGridAdaptor y abarcan  *@
            @* TODOS los códigos del miembro; antes se pedían 500 y se filtraba solo sobre ellos. Filtro de tipo Menu  *@
            @* (operador + valor) y no Excel, que pide la lista de valores de la columna. GridCargando tapa el grid     *@
            @* mientras lee.                                                                                         *@
            <GridCargando Visible="_cargando" Texto="Loading token codes…">
            <SfGrid TValue="TokenCodeRow" @ref="_grid"
                    AllowPaging="true" AllowFiltering="true" AllowSorting="true" AllowResizing="true"
                    GridLines="GridLine.Horizontal">
                <SfDataManager Adaptor="Adaptors.CustomAdaptor">
                    <ServerGridAdaptor TValue="TokenCodeRow"
                                       Http="Http"
                                       Endpoint="@GridEndpoint"
                                       QueryStringProvider="BuildQueryString"
                                       OnCount="OnTotalAsync"
                                       OnLoading="OnCargandoAsync" />
                </SfDataManager>
                <GridPageSettings PageSize="50" PageSizes="@(new[] { "25", "50", "100" })" />
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
                <GridColumns>
                    <GridColumn Field="@nameof(TokenCodeRow.TokenCode)" HeaderText="Token Code" Width="160">
                        <Template>
                            @{ var row = (TokenCodeRow)context; }
                            <span class="font-monospace fw-bold fs-6 @(row.IsUsed ? "text-muted text-decoration-line-through" : "text-primary")">
                                @row.TokenCode
                            </span>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(TokenCodeRow.TokenTypeName)" HeaderText="Token Type" Width="160">
                        <Template>
                            @{ var row = (TokenCodeRow)context; }
                            @row.TokenTypeName
                            @if (row.IsGuestPass)
                            {
                                <span class="badge bg-info text-dark ms-1 small">Guest Pass</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(TokenCodeRow.IsUsed)" HeaderText="Status" Width="110" TextAlign="TextAlign.Center" Type="ColumnType.Boolean">
                        <Template>
                            @{ var row = (TokenCodeRow)context; }
                            @if (row.IsUsed)
                            {
                                <span class="badge bg-secondary">Used</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Available</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(TokenCodeRow.TransactionType)" HeaderText="Type" Width="140">
                        <Template>
                            @{ var row = (TokenCodeRow)context; }
                            <span class="badge bg-primary bg-opacity-10 text-primary small">@row.TransactionType</span>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(TokenCodeRow.UsedByMemberId)" HeaderText="Used By" Width="150">
                        <Template>
                            @{ var row = (TokenCodeRow)context; }
                            @if (row.UsedByMemberId is not null)
                            {
                                <code class="small">@row.UsedByMemberId</code>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(TokenCodeRow.UsedAt)" HeaderText="Used At" Width="140" Type="ColumnType.DateTime">
                        <Template>
                            @{ var row = (TokenCodeRow)context; }
                            @if (row.UsedAt.HasValue)
                            {
                                <span class="small text-muted">@row.UsedAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(TokenCodeRow.CreatedDate)" HeaderText="Issued" Width="130" Type="ColumnType.DateTime">
                        <Template>
                            @{ var row = (TokenCodeRow)context; }
                            <span class="small text-muted">@row.CreatedDate.ToString("yyyy-MM-dd HH:mm")</span>
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
            </GridCargando>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "memberId")]
    public string? QueryMemberId { get; set; }

    private string _memberId = string.Empty;
    private int _filterTokenTypeId;
    private string _filterIsUsed = "";
    private bool _searched;
    private string? _alertMsg;
    private int _totalCount;
    private int _availableCount;

    private SfGrid<TokenCodeRow>? _grid;

    // Lectura del grid en curso (filtrar, ordenar, paginar): GridCargando tapa el grid mientras dura.
    private bool _cargando;

    // Filtros que se aplicaron con "Search Token Codes". El grid lee con estos y no con los desplegables en vivo:
    // si no, cambiar un desplegable sin pulsar el botón cambiaría lo que trae la siguiente página.
    private int? _appliedTokenTypeId;
    private bool? _appliedIsUsed;

    private List<TokenTypeDto> _tokenTypes = new();
    private bool _tokenTypesLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadTokenTypes();
        if (!string.IsNullOrWhiteSpace(QueryMemberId))
        {
            _memberId = QueryMemberId;
            await Search();
        }
    }

    private async Task LoadTokenTypes()
    {
        _tokenTypesLoading = true;
        try
        {
            var resp = await Http.GetFromJsonAsync<ApiResp<IEnumerable<TokenTypeDto>>>("api/v1/admin/token-types");
            if (resp?.Success == true && resp.Data is not null)
                _tokenTypes = resp.Data.Where(t => t.IsActive).ToList();
        }
        catch { }
        finally { _tokenTypesLoading = false; }
    }

    private void OnMemberChanged(string memberId)
    {
        // Otro miembro: se quita el grid (y con él su endpoint) hasta que se vuelva a buscar.
        _memberId = memberId;
        _searched = false;
        _totalCount = 0;
        _availableCount = 0;
    }

    private string GridEndpoint => $"api/v1/admin/tokens/{Uri.EscapeDataString(_memberId)}/codes/grid";

    /// <summary>
    /// Parámetros de página que ServerGridAdaptor añade a cada lectura: el tipo de token y "usado / disponible" que
    /// se aplicaron con el botón. Van como parámetros para que el servidor los aplique sobre la tabla.
    /// </summary>
    private string? BuildQueryString() => BuildQueryString(_appliedTokenTypeId, _appliedIsUsed);

    private static string? BuildQueryString(int? tokenTypeId, bool? isUsed)
    {
        var parts = new List<string>();
        if (tokenTypeId.HasValue) parts.Add($"tokenTypeId={tokenTypeId.Value}");
        if (isUsed.HasValue) parts.Add($"isUsed={isUsed.Value.ToString().ToLowerInvariant()}");
        return parts.Count == 0 ? null : string.Join("&", parts);
    }

    private async Task OnCargandoAsync(bool cargando)
    {
        _cargando = cargando;
        await InvokeAsync(StateHasChanged);
    }

    // El total del encabezado es el que da el servidor para los filtros aplicados (todas las páginas).
    private async Task OnTotalAsync(int total)
    {
        _totalCount = total;
        await InvokeAsync(StateHasChanged);
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(_memberId)) return;

        _appliedTokenTypeId = _filterTokenTypeId > 0 ? _filterTokenTypeId : null;
        _appliedIsUsed      = _filterIsUsed switch { "true" => true, "false" => false, _ => null };

        var available = LoadAvailableCountAsync();
        if (_searched && _grid is not null)
        {
            // El grid ya está pintado: vuelve a leer con los filtros nuevos.
            await _grid.Refresh();
        }
        else
        {
            // La primera vez el grid aparece y se carga solo a través del adaptador.
            _searched = true;
            StateHasChanged();
        }
        await available;
    }

    /// <summary>
    /// Disponibles para los filtros aplicados, sobre todos los códigos del miembro: antes se contaban entre los 500
    /// cargados. Se pide al mismo endpoint del grid con "disponible" y una sola fila, y se usa su total.
    /// </summary>
    private async Task LoadAvailableCountAsync()
    {
        if (_appliedIsUsed == true) { _availableCount = 0; return; }
        try
        {
            var qs   = BuildQueryString(_appliedTokenTypeId, isUsed: false);
            var url  = qs is null ? GridEndpoint : $"{GridEndpoint}?{qs}";
            var resp = await Http.PostAsJsonAsync(url, new { Page = 1, PageSize = 1 });
            if (!resp.IsSuccessStatusCode)
            {
                _alertMsg = $"Failed to load token codes ({(int)resp.StatusCode}).";
                return;
            }
            var body = await resp.Content.ReadFromJsonAsync<ApiResp<Paged<TokenCodeRow>>>();
            _availableCount = body?.Data?.TotalCount ?? 0;
        }
        catch (Exception ex) { _alertMsg = $"Error: {ex.Message}"; }
    }

    public record TokenCodeRow(long Id, string TokenCode, string TokenTypeName, bool IsGuestPass,
        string TransactionType, bool IsUsed, string? UsedByMemberId, DateTime? UsedAt, DateTime CreatedDate);
    private record TokenTypeDto(int Id, string Name, string? Description, bool IsGuestPass, string? TemplateUrl, bool IsActive);
    private record ApiResp<T>(bool Success, T? Data, IEnumerable<string>? Errors);
    private record Paged<T>(IEnumerable<T> Items, int TotalCount);
}
