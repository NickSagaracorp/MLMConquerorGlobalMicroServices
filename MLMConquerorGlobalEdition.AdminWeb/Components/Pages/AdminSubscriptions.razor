@page "/admin/billing/subscriptions"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HttpClient Http
@using MLMConquerorGlobalEdition.SharedComponents.Components.Grid
@using Syncfusion.Blazor.Data

<PageTitle>Membership Subscriptions — Admin</PageTitle>

<BreadcrumbNav Items="@(new List<BreadcrumbNav.BreadcrumbItem> { new("Admin Dashboard", "/admin"), new("Subscriptions") })" />

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="card-body">
                <i class="ri-vip-crown-line fs-2 text-primary d-block mb-2"></i>
                <p class="fw-semibold text-muted small text-uppercase mb-1">Active</p>
                <h3 class="fw-bold text-primary mb-0" title="@FormatStatFull(_stats?.Active)">@FormatStat(_stats?.Active)</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="card-body">
                <i class="ri-time-line fs-2 text-warning d-block mb-2"></i>
                <p class="fw-semibold text-muted small text-uppercase mb-1">Expiring ≤ 7 days</p>
                <h3 class="fw-bold text-warning mb-0" title="@FormatStatFull(_stats?.ExpiringIn7Days)">@FormatStat(_stats?.ExpiringIn7Days)</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="card-body">
                <i class="ri-close-circle-line fs-2 text-danger d-block mb-2"></i>
                <p class="fw-semibold text-muted small text-uppercase mb-1">Cancelled</p>
                <h3 class="fw-bold text-danger mb-0" title="@FormatStatFull(_stats?.Cancelled)">@FormatStat(_stats?.Cancelled)</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="card-body">
                <i class="ri-refresh-line fs-2 text-success d-block mb-2"></i>
                <p class="fw-semibold text-muted small text-uppercase mb-1">Auto-Renew</p>
                <h3 class="fw-bold text-success mb-0" title="@FormatStatFull(_stats?.AutoRenew)">@FormatStat(_stats?.AutoRenew)</h3>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header py-3 d-flex align-items-center gap-3 flex-wrap">
        <h6 class="card-title mb-0 fw-semibold flex-grow-1">
            <i class="ri-vip-diamond-line me-2 text-primary"></i>Subscriptions
        </h6>
        <select class="form-select form-select-sm w-auto" style="min-width:140px"
                @bind="_statusFilter" @bind:after="OnStatusChangedAsync">
            <option value="">All Statuses</option>
            <option value="Active">Active</option>
            <option value="Expired">Expired</option>
            <option value="Cancelled">Cancelled</option>
        </select>
        <button class="btn btn-outline-secondary btn-sm" title="Refresh from server" @onclick="RefreshAsync"><i class="ri-refresh-line"></i></button>
    </div>
    <div class="card-body p-0">
        @* Grid de servidor: filtros de columna, orden y pagina viajan al servidor por ServerGridAdaptor y abarcan  *@
        @* TODAS las suscripciones, no solo la pagina cargada. El estado del desplegable va en la query. Filtro de   *@
        @* tipo Menu (operador + valor): el de Excel pide la lista de valores de la columna, que con un millon de   *@
        @* filas tarda segundos. GridCargando tapa el grid mientras dura cada lectura.                             *@
        <GridCargando Visible="_cargando" Texto="Loading subscriptions…">
            <SfGrid TValue="SubscriptionDto" @ref="_grid"
                    AllowPaging="true" AllowFiltering="true" AllowSorting="true" AllowResizing="true" GridLines="GridLine.Horizontal">
                <SfDataManager Adaptor="Adaptors.CustomAdaptor">
                    <ServerGridAdaptor TValue="SubscriptionDto"
                                       Http="Http"
                                       Endpoint="api/v1/admin/subscriptions/grid"
                                       QueryStringProvider="BuildQueryString"
                                       OnLoading="OnCargandoAsync" />
                </SfDataManager>
                <GridPageSettings PageSize="50" PageSizes="@(new[] { "25", "50", "100" })" />
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
                <GridColumns>
                    <GridColumn Field="@nameof(SubscriptionDto.MemberId)" HeaderText="Member ID" Width="130" AllowFiltering="true">
                        <Template>
                            <a href="/admin/members/@(((SubscriptionDto)context).MemberId)" target="_blank" class="text-primary fw-semibold"><code>@(((SubscriptionDto)context).MemberId)</code></a>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(SubscriptionDto.MembershipLevelName)" HeaderText="Level" Width="160" AllowFiltering="true" />
                    <GridColumn Field="@nameof(SubscriptionDto.Status)" HeaderText="Status" Width="120" AllowFiltering="true">
                        <Template>
                            <span class="badge @StatusBadge(((SubscriptionDto)context).Status)">@(((SubscriptionDto)context).Status)</span>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(SubscriptionDto.StartDate)" HeaderText="Start" Width="120" Format="yyyy-MM-dd" Type="ColumnType.Date" AllowFiltering="true" />
                    <GridColumn Field="@nameof(SubscriptionDto.ExpirationDate)" HeaderText="Expires" Width="120" Format="yyyy-MM-dd" Type="ColumnType.Date" AllowFiltering="true" />
                    <GridColumn Field="@nameof(SubscriptionDto.IsAutoRenew)" HeaderText="Auto-Renew" Width="110" TextAlign="TextAlign.Center" AllowFiltering="true" DisplayAsCheckBox="false">
                        <Template>
                            <span class="badge @BoolBadge(((SubscriptionDto)context).IsAutoRenew)">
                                @(((SubscriptionDto)context).IsAutoRenew ? "Yes" : "No")
                            </span>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(SubscriptionDto.ChangeReason)" HeaderText="Reason" Width="130" AllowFiltering="true">
                        <Template>
                            <span class="text-muted small">@(((SubscriptionDto)context).ChangeReason)</span>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(SubscriptionDto.CreationDate)" HeaderText="Created" Width="120" Format="yyyy-MM-dd" Type="ColumnType.Date" />
                </GridColumns>
            </SfGrid>
        </GridCargando>
    </div>
</div>

@code {
    private SfGrid<SubscriptionDto>? _grid;
    private string _statusFilter = string.Empty;
    private SubscriptionStatsDto? _stats;
    private bool _cargando;

    // ServerGridAdaptor avisa al empezar y al terminar cada lectura; GridCargando tapa el grid mientras tanto.
    private async Task OnCargandoAsync(bool cargando)
    {
        _cargando = cargando;
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        // El grid se carga solo a traves del adaptador; aqui solo hacen falta los contadores.
        await LoadStatsAsync();
    }

    /// <summary>
    /// Query extra que ServerGridAdaptor anade al endpoint en cada lectura. Se evalua en cada lectura, asi que
    /// siempre lleva el estado actual del desplegable.
    /// </summary>
    private string? BuildQueryString() =>
        string.IsNullOrWhiteSpace(_statusFilter) ? null : $"status={Uri.EscapeDataString(_statusFilter)}";

    /// <summary>Cambio del desplegable de estado: el grid vuelve a leer (el estado viaja en la query).</summary>
    private async Task OnStatusChangedAsync()
    {
        if (_grid is not null) await _grid.Refresh();
    }

    /// <summary>Refresh: vuelve a leer el grid y los contadores, estos sin la cache del servidor.</summary>
    private async Task RefreshAsync()
    {
        var stats = LoadStatsAsync(bypassCache: true);
        if (_grid is not null) await _grid.Refresh();
        await stats;
    }

    private async Task LoadStatsAsync(bool bypassCache = false)
    {
        try
        {
            var url = "api/v1/admin/subscriptions/stats";
            if (bypassCache) url += "?bypassCache=true";
            var resp = await Http.GetFromJsonAsync<ApiResp<SubscriptionStatsDto>>(url);
            if (resp?.Success == true) _stats = resp.Data;
        }
        catch
        {
            // Los contadores son un extra: si fallan se ven como "—" y el grid sigue funcionando.
        }
        finally { StateHasChanged(); }
    }

    // Tarjetas de contadores: el valor completo si cabe en el ancho de la tarjeta; si no, abreviado (el completo va en el title).
    private const int AnchoDeTarjeta = 7;
    private static string FormatStat(int? value) => value is int v ? NumeroCorto.Cantidad(v, AnchoDeTarjeta) : "—";
    private static string FormatStatFull(int? value) => value is int v ? NumeroCorto.Cantidad(v) : "—";

    private static string BoolBadge(bool val) => val ? "bg-success" : "bg-secondary";

    private static string StatusBadge(string s) => s switch
    { "Active" => "bg-success", "Expired" => "bg-warning text-dark", "Cancelled" => "bg-danger", _ => "bg-secondary" };

    // Mismo contrato JSON que MLMConquerorGlobalEdition.AdminAPI.DTOs.Subscriptions (AdminWeb no referencia la API).
    public record SubscriptionDto(string Id, string MemberId, int MembershipLevelId, string MembershipLevelName,
        string Status, string ChangeReason, DateTime StartDate, DateTime? ExpirationDate,
        bool IsAutoRenew, bool IsFree, DateTime CreationDate);
    private record SubscriptionStatsDto(int Active, int ExpiringIn7Days, int Cancelled, int AutoRenew);
    private record ApiResp<T>(bool Success, T? Data, IEnumerable<string>? Errors);
}
