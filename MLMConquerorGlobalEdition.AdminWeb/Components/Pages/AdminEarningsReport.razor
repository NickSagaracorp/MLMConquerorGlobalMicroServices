@page "/admin/reports/earnings-lifetime"
@page "/admin/reports/earnings-window"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin,Admin")]
@using MLMConquerorGlobalEdition.SharedComponents.Components.Grid
@using MLMConquerorGlobalEdition.SharedComponents.Constants
@using MLMConquerorGlobalEdition.SharedComponents.Services
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IViewContextService ViewContext

<PageTitle>@Title</PageTitle>
<CambioDeRuta Rutas="@(new[] { "/admin/reports/earnings-lifetime", "/admin/reports/earnings-window" })" AlCambiar="AlCambiarDeRutaAsync" />

<h4 class="mb-1">@Title</h4>
<p class="text-muted mb-4">@Subtitle</p>

<div class="d-flex flex-wrap gap-2 align-items-end mb-3">
    <div class="flex-grow-1" style="min-width:240px">
        <input class="form-control" placeholder="Search name or email..." @bind="_search" @bind:event="oninput"
               @onkeyup="OnSearchKeyAsync" />
    </div>
    <div>
        <button class="btn btn-primary" @onclick="ApplySearchAsync"><i class="ri-search-line me-1"></i>Search</button>
    </div>
    @if (IsWindow)
    {
        <div>
            <label class="form-label small mb-1">Window</label>
            <select class="form-select" @bind="_days" @bind:after="RefreshAsync">
                @foreach (var d in Windows) { <option value="@d">Last @d days</option> }
            </select>
        </div>
    }
    <div>
        <label class="form-label small mb-1">Cutoff date</label>
        <input type="date" class="form-control" max="@Today.ToString("yyyy-MM-dd")" @bind="_cutoff" @bind:after="RefreshAsync" />
    </div>
    @if (ViewContext.HasPermission(Permissions.Reports.Export))
    {
        <button class="btn btn-outline-success" @onclick="ExportAsync" disabled="@_exporting">
            <i class="ri-file-download-line me-1"></i>Export CSV
        </button>
    }
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_total is not null)
{
    <div class="text-muted small mb-2">
        @NumeroCorto.Cantidad(_total.Value) results
        <span class="ms-2">
            @if (DesdeLaFoto)
            {
                <i class="ri-camera-line me-1"></i>@($"Weekly snapshot as of {Cutoff:MMM d, yyyy} · refreshed every Monday")
            }
            else
            {
                <i class="ri-flashlight-line me-1"></i>@("Calculated live for the selected date")
            }
        </span>
    </div>
}

@if (_listo)
{
<GridCargando Visible="_cargando" Texto="Loading…">
<SfGrid TValue="EarningsRow" @ref="_grid" @key="IsWindow" AllowPaging="true">
    <SfDataManager Adaptor="Adaptors.CustomAdaptor">
        <ServerGridAdaptor TValue="EarningsRow" Http="Http" Endpoint="api/v1/admin/reports/earnings/grid"
                           QueryStringProvider="Query" OnCount="OnCountAsync"
                           OnServerError="OnServerErrorAsync" OnLoading="OnCargandoAsync" />
    </SfDataManager>
    <GridPageSettings PageSize="20" PageSizes="@(new int[] { 20, 50, 100 })" />
    <GridColumns>
        <GridColumn Field="@nameof(EarningsRow.Rank)" HeaderText="Rank" Width="80">
            <Template>#@((context as EarningsRow)!.Rank)</Template>
        </GridColumn>
        <GridColumn Field="@nameof(EarningsRow.Username)" HeaderText="Username" />
        <GridColumn Field="@nameof(EarningsRow.MemberName)" HeaderText="Member Name" />
        <GridColumn Field="@nameof(EarningsRow.Email)" HeaderText="Email" />
        <GridColumn Field="@nameof(EarningsRow.Country)" HeaderText="Country" />
        <GridColumn Field="@nameof(EarningsRow.Total)" HeaderText="Total" TextAlign="TextAlign.Right">
            <Template>@NumeroCorto.Monto((context as EarningsRow)!.Total)</Template>
        </GridColumn>
    </GridColumns>
</SfGrid>
</GridCargando>
}

@code {
    // Pasar entre las rutas de esta página reutiliza la instancia: CambioDeRuta avisa y aquí se reinicia la vista.
    private Task AlCambiarDeRutaAsync()
    {
        OnParametersSet();
        StateHasChanged();
        return Task.CompletedTask;
    }

    // Lectura del grid en curso (filtrar, ordenar, paginar): GridCargando tapa el grid mientras dura, para que se vea
    // que el filtro se está aplicando. Con equipos y reportes de un millón de filas una lectura puede tardar.
    private bool _cargando;

    private async Task OnCargandoAsync(bool cargando)
    {
        _cargando = cargando;
        await InvokeAsync(StateHasChanged);
    }

    private static readonly int[] Windows = { 30, 90, 180, 365 };

    private SfGrid<EarningsRow>? _grid;
    private string   _search = string.Empty;
    private string   _appliedSearch = string.Empty;   // el termino que la rejilla ya aplico: el que usa la exportacion
    private int?     _total;
    private bool?    _lastIsWindow;
    private int      _days   = 180;
    private DateTime _cutoff = DateTime.Today.AddDays(-1);
    private bool     _exporting;
    private string?  _error;
    private DateTime? _foto;     // última foto semanal: el corte por defecto (null si todavía no hay)
    private bool     _listo;     // el grid espera a saber el corte por defecto, para no leer dos veces

    // La foto semanal guarda la ventana de 180 días y de por vida, con fecha de domingo; otro corte o ventana se
    // calcula al momento (tarda unos segundos con el volumen real).
    private bool DesdeLaFoto => _foto is { } f && Cutoff == f.Date && (!IsWindow || _days == 180);
    private DateTime CortePorDefecto => _foto?.Date ?? Today.AddDays(-1);

    private static DateTime Today => DateTime.Today;   // hora de servidor

    private bool   IsWindow => Nav.Uri.Contains("/earnings-window", StringComparison.OrdinalIgnoreCase);
    private string Title    => IsWindow ? $"Earnings {_days} Days" : "Earnings Lifetime";
    private string Subtitle => IsWindow ? $"Commissions earned in the last {_days} days up to the cutoff date."
                                        : "Lifetime commissions earned up to the cutoff date.";

    // Un corte futuro se trata como hoy (el servidor tambien lo acota).
    private DateTime Cutoff => _cutoff.Date > Today ? Today : _cutoff.Date;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var resp = await Http.GetFromJsonAsync<ApiResp<DateTime?>>("api/v1/admin/reports/earnings/snapshot");
            _foto = resp?.Data;
        }
        catch { /* sin la fecha de la foto, el corte por defecto es ayer y el servidor decide */ }
        _cutoff = CortePorDefecto;
        _listo  = true;
    }

    protected override void OnParametersSet()
    {
        var isWindow = IsWindow;
        if (_lastIsWindow is not null && _lastIsWindow != isWindow)
        {
            _search = _appliedSearch = string.Empty;
            _days   = 180;
            _cutoff = CortePorDefecto;
            _total  = null;
            _error  = null;
        }
        _lastIsWindow = isWindow;
    }

    private Task OnServerErrorAsync(string? errorCode)
    {
        _total = null;
        _error = errorCode is null ? "The report could not be loaded." : $"The report could not be loaded ({errorCode}).";
        return InvokeAsync(StateHasChanged);
    }

    private async Task OnCountAsync(int count)
    {
        _error = null;
        _total = count;
        await InvokeAsync(StateHasChanged);
    }

    private string Query()
    {
        var q = $"cutoff={Cutoff:yyyy-MM-dd}";
        return IsWindow ? $"{q}&days={_days}" : q;
    }

    private async Task RefreshAsync()
    {
        _cutoff = Cutoff;
        if (_grid is not null) await _grid.Refresh();
    }

    // Como Members: la busqueda se lanza con Enter o con el boton, no en cada tecla.
    private async Task OnSearchKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ApplySearchAsync();
    }

    private async Task ApplySearchAsync()
    {
        _appliedSearch = (_search ?? string.Empty).Trim();
        if (_grid is not null) await _grid.SearchAsync(_appliedSearch);
    }

    private async Task ExportAsync()
    {
        _exporting = true;
        _error = null;
        try
        {
            var url = $"api/v1/admin/reports/earnings/export?{Query()}&search={Uri.EscapeDataString(_appliedSearch)}";
            var bytes = await Http.GetByteArrayAsync(url);
            var file = IsWindow ? $"earnings-{_days}d-{Cutoff:yyyy-MM-dd}.csv" : $"earnings-lifetime-{Cutoff:yyyy-MM-dd}.csv";
            await Js.InvokeVoidAsync("mlmDownloadFile", file,
                "text/csv", Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            _error = $"Export failed: {ex.Message}";
        }
        finally { _exporting = false; }
    }

    private sealed record ApiResp<T>(bool Success, T? Data, IEnumerable<string>? Errors);

    private sealed class EarningsRow
    {
        public int     Rank       { get; set; }
        public string? Username   { get; set; }
        public string  MemberName { get; set; } = string.Empty;
        public string  Email      { get; set; } = string.Empty;
        public string  Country    { get; set; } = string.Empty;
        public decimal Total      { get; set; }
    }
}
