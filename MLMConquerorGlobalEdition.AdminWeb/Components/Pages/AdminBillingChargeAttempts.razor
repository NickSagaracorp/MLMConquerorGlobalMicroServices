@page "/admin/billing/charge-attempts"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin,Admin,BillingManager")]
@inject HttpClient Http
@using MLMConquerorGlobalEdition.SharedComponents.Components.Grid

<PageTitle>Charge Attempts — Admin</PageTitle>

<BreadcrumbNav Items="@(new List<BreadcrumbNav.BreadcrumbItem> { new("Admin Dashboard", "/admin"), new("Billing"), new("Charge Attempts") })" />

@if (_alertMsg is not null)
{
    <div class="alert alert-danger alert-dismissible mb-3">@_alertMsg <button type="button" class="btn-close" @onclick="() => _alertMsg = null"></button></div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header py-3">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold small mb-1">Outcome</label>
                <select class="form-select form-select-sm" @bind="_outcomeFilter">
                    <option value="">All</option>
                    <option value="Success">Success</option>
                    <option value="Failed">Failed</option>
                    <option value="Scheduled">Scheduled</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small mb-1">Processor</label>
                <select class="form-select form-select-sm" @bind="_processorFilter">
                    <option value="">All</option>
                    @foreach (var kv in ProcessorOptions)
                    {
                        <option value="@kv.Key">@kv.Value</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small mb-1">Member ID</label>
                <input class="form-control form-control-sm" @bind="_memberFilter" placeholder="optional" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary btn-sm w-100" @onclick="Search"><i class="ri-search-line me-1"></i>Search</button>
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        @* Grid de servidor: filtros de columna, orden y página viajan al servidor por ServerGridAdaptor y abarcan
           TODOS los intentos de cobro. Antes el procesador se filtraba en el navegador sobre la página cargada y el
           filtro y el orden del grid solo veían esas filas. Los controles de arriba van por query string. Filtro de
           tipo Menu y no Excel, que pediría al servidor la lista de valores de la columna sobre millones de filas.
           GridCargando tapa el grid mientras dura cada lectura. *@
        <GridCargando Visible="_cargando" Texto="Loading charge attempts…">
        <SfGrid TValue="ChargeAttemptDto" @ref="_grid"
                AllowPaging="true" AllowFiltering="true" AllowSorting="true" AllowResizing="true" GridLines="GridLine.Horizontal">
            <SfDataManager Adaptor="Adaptors.CustomAdaptor">
                <ServerGridAdaptor TValue="ChargeAttemptDto"
                                   Http="Http"
                                   Endpoint="api/v1/admin/billing/charge-attempts/grid"
                                   QueryStringProvider="BuildQueryString"
                                   OnLoading="OnCargandoAsync"
                                   OnServerError="OnServerErrorAsync" />
            </SfDataManager>
            <GridPageSettings PageSize="50" PageSizes="@(new[] { "25", "50", "100" })" />
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
            <GridColumns>
                <GridColumn Field="@nameof(ChargeAttemptDto.AttemptedAtUtc)" HeaderText="Attempted (UTC)" Width="150" Format="yyyy-MM-dd HH:mm" Type="ColumnType.DateTime" />
                <GridColumn Field="@nameof(ChargeAttemptDto.MemberId)" HeaderText="Member" Width="130">
                    <Template><a href="/admin/members/@(((ChargeAttemptDto)context).MemberId)" class="text-primary"><code class="small">@(((ChargeAttemptDto)context).MemberId)</code></a></Template>
                </GridColumn>
                <GridColumn Field="@nameof(ChargeAttemptDto.ProcessorName)" HeaderText="Processor" Width="160" />
                <GridColumn Field="@nameof(ChargeAttemptDto.FallbackStepIndex)" HeaderText="Step" Width="70" TextAlign="TextAlign.Center" />
                <GridColumn Field="@nameof(ChargeAttemptDto.PresentmentCurrency)" HeaderText="Currency" Width="90" TextAlign="TextAlign.Center" />
                <GridColumn Field="@nameof(ChargeAttemptDto.OriginalAmountUsd)" HeaderText="USD Amount" Width="110" TextAlign="TextAlign.Right">
                    <Template>$@(((ChargeAttemptDto)context).OriginalAmountUsd.ToString("F2"))</Template>
                </GridColumn>
                <GridColumn Field="@nameof(ChargeAttemptDto.ConvertedAmount)" HeaderText="Converted" Width="110" TextAlign="TextAlign.Right">
                    <Template>@(((ChargeAttemptDto)context).ConvertedAmount.ToString("F2"))</Template>
                </GridColumn>
                <GridColumn Field="@nameof(ChargeAttemptDto.Outcome)" HeaderText="Outcome" Width="110" TextAlign="TextAlign.Center">
                    <Template><span class="badge @OutcomeBadge(((ChargeAttemptDto)context).Outcome)">@(((ChargeAttemptDto)context).Outcome)</span></Template>
                </GridColumn>
                <GridColumn Field="@nameof(ChargeAttemptDto.GatewayTransactionId)" HeaderText="Gateway Txn" Width="160">
                    <Template><code class="small text-muted">@(((ChargeAttemptDto)context).GatewayTransactionId ?? "—")</code></Template>
                </GridColumn>
                <GridColumn Field="@nameof(ChargeAttemptDto.PaymentHistoryId)" HeaderText="Payment History" Width="160">
                    <Template><code class="small text-muted">@(((ChargeAttemptDto)context).PaymentHistoryId ?? "—")</code></Template>
                </GridColumn>
                <GridColumn Field="@nameof(ChargeAttemptDto.FailureReason)" HeaderText="Failure Reason" Width="220">
                    <Template><span class="small text-danger">@(((ChargeAttemptDto)context).FailureReason ?? "—")</span></Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
        </GridCargando>
    </div>
    <div class="card-footer bg-light small text-muted">
        Read-only chain-of-custody audit. Outcome, processor, member, column filters, sorting and paging all run server-side over every attempt.
    </div>
</div>

@code {
    // Keyed by the CardProcessor enum NAME (the API serializes the enum as its name via JsonStringEnumConverter).
    private static readonly Dictionary<string, string> ProcessorOptions = new()
    {
        ["NmiSpreedly"] = "NMI (Spreedly)", ["NmiDirect"] = "NMI Direct", ["CheckoutEUR"] = "Checkout.com EUR",
        ["CheckoutUS"] = "Checkout.com US", ["CheckoutUsLlc"] = "Checkout US LLC", ["Shift4"] = "Shift4", ["StripeEms"] = "Stripe EMS"
    };

    private SfGrid<ChargeAttemptDto>? _grid;
    private bool _cargando;
    private string? _alertMsg;
    private string _outcomeFilter = string.Empty;
    private string _processorFilter = string.Empty;
    private string _memberFilter = string.Empty;

    private async Task OnCargandoAsync(bool cargando)
    {
        _cargando = cargando;
        await InvokeAsync(StateHasChanged);
    }

    private Task OnServerErrorAsync(string? errorCode)
    {
        _alertMsg = errorCode is null ? "Failed to load charge attempts." : $"Failed to load charge attempts ({errorCode}).";
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Query string que ServerGridAdaptor añade al endpoint en cada lectura; se evalúa en cada lectura, así que siempre
    /// lleva lo que hay en los controles de arriba. El procesador viaja como nombre del enum, que el servidor compara con
    /// la columna de la tabla.
    /// </summary>
    private string? BuildQueryString()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(_outcomeFilter))   parts.Add($"outcome={Uri.EscapeDataString(_outcomeFilter)}");
        if (!string.IsNullOrWhiteSpace(_processorFilter)) parts.Add($"processor={Uri.EscapeDataString(_processorFilter)}");
        if (!string.IsNullOrWhiteSpace(_memberFilter))    parts.Add($"memberId={Uri.EscapeDataString(_memberFilter.Trim())}");
        return parts.Count == 0 ? null : string.Join("&", parts);
    }

    /// <summary>
    /// "Search": vuelve a leer el grid con los controles de arriba. Si el grid no está en la primera página vuelve a
    /// ella (eso ya lee): con el filtro nuevo la página en la que estaba puede no existir.
    /// </summary>
    private async Task Search()
    {
        _alertMsg = null;
        if (_grid is null) return;
        if (_grid.PageSettings?.CurrentPage > 1) await _grid.GoToPageAsync(1);
        else await _grid.Refresh();
    }

    private static string OutcomeBadge(string o) => o switch
    { "Success" => "bg-success", "Failed" => "bg-danger", "Scheduled" => "bg-warning text-dark", _ => "bg-secondary" };

    // CardProcessor comes back from the API as the enum name (JsonStringEnumConverter), e.g. "CheckoutUS".
    // Los nombres de las propiedades son los campos de filtro y orden que el grid manda al servidor.
    public record ChargeAttemptDto(long Id, string MemberId, string CardProcessor, string ProcessorName,
        int FallbackStepIndex, string PresentmentCurrency, decimal OriginalAmountUsd, decimal ConvertedAmount,
        string Outcome, string? GatewayTransactionId, string? PaymentHistoryId, string? FailureReason, DateTime AttemptedAtUtc);
}
