@page "/admin/security/audit"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HttpClient Http
@using MLMConquerorGlobalEdition.SharedComponents.Components.Grid
@using Syncfusion.Blazor.Data

<PageTitle>Security Audit — Admin</PageTitle>

<BreadcrumbNav Items="@(new List<BreadcrumbNav.BreadcrumbItem> { new("Admin Dashboard", "/admin"), new("Security"), new("Access Audit") })" />

<div class="d-flex gap-2 mb-3 flex-wrap">
    <a href="/admin/security/account-changes" class="btn btn-outline-secondary btn-sm">
        <i class="ri-user-settings-line me-1"></i>Account Changes
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header py-3 d-flex align-items-center gap-2">
        <h6 class="card-title mb-0 fw-semibold flex-grow-1">
            <i class="ri-shield-check-line me-2 text-primary"></i>Access Audit Log
        </h6>
        <button class="btn btn-outline-secondary btn-sm" title="Refresh from server" @onclick="RefreshAsync"><i class="ri-refresh-line"></i></button>
    </div>
    <div class="card-body p-0">
        @* Grid de servidor: filtros de columna, orden y paginación viajan a access-audit/grid por ServerGridAdaptor  *@
        @* y se aplican sobre TODO el registro, no solo sobre la página cargada. Filtro de tipo Menu (operador +     *@
        @* valor) y no Excel, que pide al servidor la lista de valores de la columna. Páginas de hasta 100, el tope   *@
        @* de la API. GridCargando tapa el grid mientras dura cada lectura.                                           *@
        <GridCargando Visible="_cargando" Texto="Loading audit log…">
        <SfGrid TValue="AuditEntryDto" @ref="_grid"
                AllowPaging="true" AllowFiltering="true" AllowSorting="true" AllowResizing="true" GridLines="GridLine.Horizontal">
            <SfDataManager Adaptor="Adaptors.CustomAdaptor">
                <ServerGridAdaptor TValue="AuditEntryDto"
                                   Http="Http"
                                   Endpoint="api/v1/admin/security/access-audit/grid"
                                   OnLoading="OnCargandoAsync" />
            </SfDataManager>
            <GridPageSettings PageSize="50" PageSizes="@(new[] { "25", "50", "100" })" />
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
            <GridColumns>
                <GridColumn Field="@nameof(AuditEntryDto.MemberId)" HeaderText="Member ID" Width="140">
                    <Template><code class="small">@(((AuditEntryDto)context).MemberId)</code></Template>
                </GridColumn>
                <GridColumn Field="@nameof(AuditEntryDto.OldStatus)" HeaderText="Old Status" Width="130">
                    <Template><span class="badge @StatusBadge(((AuditEntryDto)context).OldStatus)">@(((AuditEntryDto)context).OldStatus ?? "—")</span></Template>
                </GridColumn>
                <GridColumn Field="@nameof(AuditEntryDto.NewStatus)" HeaderText="New Status" Width="130">
                    <Template><span class="badge @StatusBadge(((AuditEntryDto)context).NewStatus)">@(((AuditEntryDto)context).NewStatus ?? "—")</span></Template>
                </GridColumn>
                <GridColumn Field="@nameof(AuditEntryDto.Reason)" HeaderText="Reason" Width="220">
                    <Template><span class="small text-muted">@(((AuditEntryDto)context).Reason ?? "—")</span></Template>
                </GridColumn>
                <GridColumn Field="@nameof(AuditEntryDto.ChangedBy)" HeaderText="Changed By" Width="150">
                    <Template><span class="small">@(string.IsNullOrWhiteSpace(((AuditEntryDto)context).ChangedBy) ? "—" : ((AuditEntryDto)context).ChangedBy)</span></Template>
                </GridColumn>
                <GridColumn Field="@nameof(AuditEntryDto.ChangedAt)" HeaderText="Date" Width="150" Format="yyyy-MM-dd HH:mm" Type="ColumnType.DateTime">
                    <Template><span class="small text-muted">@(((AuditEntryDto)context).ChangedAt.ToString("yyyy-MM-dd HH:mm"))</span></Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
        </GridCargando>
    </div>
</div>

@code {
    private SfGrid<AuditEntryDto>? _grid;

    // Lectura del grid en curso (filtrar, ordenar, paginar): GridCargando tapa el grid mientras dura.
    private bool _cargando;

    private async Task OnCargandoAsync(bool cargando)
    {
        _cargando = cargando;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>"Refresh": el grid vuelve a leer la página actual con sus filtros y orden.</summary>
    private async Task RefreshAsync()
    {
        if (_grid is not null) await _grid.Refresh();
    }

    private static string StatusBadge(string? s) => s switch
    {
        "Active" => "bg-success",
        "Suspended" => "bg-warning text-dark",
        "Inactive" => "bg-secondary",
        _ => "bg-light text-dark border"
    };

    // Público porque lo usan el grid y el adaptador genérico. Mismo contrato JSON que AccessAuditEntryDto de AdminAPI:
    // los nombres de las propiedades son los campos de filtro y orden que viajan al servidor. La fecha es ChangedAt
    // (con índice), que se escribe en el mismo instante que CreationDate.
    public record AuditEntryDto(long Id, string MemberId, string? OldStatus, string? NewStatus, string? Reason, string? ChangedBy, DateTime ChangedAt);
}
