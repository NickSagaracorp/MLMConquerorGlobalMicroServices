@page "/admin/billing/credentials"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin,Admin,BillingManager")]
@inject HttpClient Http

<PageTitle>API Credentials — Admin</PageTitle>

<BreadcrumbNav Items="@(new List<BreadcrumbNav.BreadcrumbItem> { new("Admin Dashboard", "/admin"), new("Billing"), new("API Credentials") })" />

@if (_alertMsg is not null)
{
    <div class="alert @(_alertIsError ? "alert-danger" : "alert-success") alert-dismissible mb-3">
        @_alertMsg <button type="button" class="btn-close" @onclick="() => _alertMsg = null"></button>
    </div>
}

<div class="row">
    <div class="col-lg-4 mb-3">
        <div class="card border-0 shadow-sm">
            <div class="card-header py-3">
                <h6 class="card-title mb-0 fw-semibold"><i class="ri-key-2-line me-2 text-primary"></i>Service Keys</h6>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var key in ServiceKeys)
                {
                    var k = key;
                    <button type="button" class="list-group-item list-group-item-action d-flex align-items-center @(k == _selectedKey ? "active" : "")"
                            @onclick="() => SelectKey(k)">
                        <span class="flex-grow-1"><code class="@(k == _selectedKey ? "text-white" : "text-primary")">@k</code></span>
                        <i class="ri-arrow-right-s-line"></i>
                    </button>
                }
            </div>
            <div class="card-footer bg-light small text-muted">
                Secret values are stored encrypted and are never displayed. Submit a new value only when you want to change it.
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header py-3 d-flex align-items-center gap-2">
                <h6 class="card-title mb-0 fw-semibold flex-grow-1"><i class="ri-shield-keyhole-line me-2 text-primary"></i>@_selectedKey</h6>
                <select class="form-select form-select-sm w-auto" value="@_selectedEnvironment" @onchange="SelectEnvironment">
                    @foreach (var env in Environments)
                    {
                        <option value="@env">@env</option>
                    }
                </select>
                @if (_metadata is not null)
                {
                    <span class="badge @(_metadata.IsActive ? "bg-success" : "bg-secondary")">@(_metadata.IsActive ? "Active" : "Inactive")</span>
                }
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => LoadMetadata(_selectedKey)"><i class="ri-refresh-line"></i></button>
            </div>
            @if (_loading)
            {
                <div class="card-body text-center py-5"><div class="spinner-border text-primary"></div></div>
            }
            else
            {
                <div class="card-body">
                    @if (_metadataMissing)
                    {
                        <div class="alert alert-info">No credential configured for <code>@_selectedKey</code> yet. Fill in the form below and save to create it.</div>
                    }

                    @if (_metadata is not null)
                    {
                        <div class="row g-2 mb-3 small">
                            <div class="col-md-6"><span class="text-muted">Environment:</span> <span class="fw-semibold">@_metadata.Environment</span></div>
                            <div class="col-md-6"><span class="text-muted">Base URL:</span> <span class="fw-semibold">@(_metadata.BaseUrl ?? "—")</span></div>
                            <div class="col-md-4"><span class="text-muted">API Key:</span> @SecretIndicator(_metadata.HasApiKey)</div>
                            <div class="col-md-4"><span class="text-muted">Secret Key:</span> @SecretIndicator(_metadata.HasSecretKey)</div>
                            <div class="col-md-4"><span class="text-muted">Merchant ID:</span> @SecretIndicator(_metadata.HasMerchantId)</div>
                        </div>
                        <hr />
                    }

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Environment</label>
                            <select class="form-select" @bind="_form.Environment">
                                <option value="Production">Production</option>
                                <option value="Sandbox">Sandbox</option>
                                <option value="Test">Test</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Base URL</label>
                            <input class="form-control" @bind="_form.BaseUrl" placeholder="https://api.example.com" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="credActive" @bind="_form.IsActive" />
                                <label class="form-check-label" for="credActive">Active</label>
                            </div>
                        </div>

                        <div class="col-12"><hr class="my-1" /><small class="text-muted">Leave a secret field blank to keep the current value. New values are encrypted before storage.</small></div>

                        @{ var labels = SecretLabels(); }
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">@labels.Api</label>
                            <input type="password" class="form-control" @bind="_form.ApiKey" placeholder="@(_metadata?.HasApiKey == true ? "•••• (unchanged)" : "not set")" autocomplete="new-password" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">@labels.Secret</label>
                            <input type="password" class="form-control" @bind="_form.SecretKey" placeholder="@(_metadata?.HasSecretKey == true ? "•••• (unchanged)" : "not set")" autocomplete="new-password" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">@labels.Merchant</label>
                            <input type="password" class="form-control" @bind="_form.MerchantId" placeholder="@(_metadata?.HasMerchantId == true ? "•••• (unchanged)" : "not set")" autocomplete="new-password" />
                        </div>
                        @if (labels.Additional is not null)
                        {
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">@labels.Additional</label>
                                <input type="password" class="form-control" @bind="_form.AdditionalSecret" placeholder="@(_metadata?.HasAdditionalSecret == true ? "•••• (unchanged)" : "not set")" autocomplete="new-password" />
                            </div>
                        }

                        <div class="col-12">
                            <hr class="my-1" />
                            <small class="text-muted fw-semibold">Provider admin portal</small>
                            <div class="small text-muted">Where a person signs in to review accounts and transactions. Separate from the API base URL above.</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Portal URL</label>
                            <div class="input-group">
                                <input class="form-control" @bind="_form.PortalUrl" placeholder="https://portal.provider.com/" />
                                @if (!string.IsNullOrWhiteSpace(_form.PortalUrl))
                                {
                                    <a class="btn btn-outline-secondary" href="@_form.PortalUrl" target="_blank" rel="noopener noreferrer"><i class="ri-external-link-line"></i></a>
                                }
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Portal username</label>
                            <input type="password" class="form-control" @bind="_form.PortalUsername" placeholder="@(_metadata?.HasPortalUsername == true ? "•••• (unchanged)" : "not set")" autocomplete="new-password" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Portal password</label>
                            <input type="password" class="form-control" @bind="_form.PortalPassword" placeholder="@(_metadata?.HasPortalPassword == true ? "•••• (unchanged)" : "not set")" autocomplete="new-password" />
                        </div>
                        <div class="col-12">
                            <div class="alert alert-warning small mb-0 py-2">
                                <i class="ri-alert-line me-1"></i>
                                These are shared human sign-in credentials: they leave no trace of who logged in,
                                and rotating them means telling everyone. If the provider supports individual
                                accounts or SSO, prefer storing only the URL and using those instead.
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-end gap-2 bg-light border-top">
                    <button class="btn btn-primary" @onclick="Save" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        <i class="ri-save-line me-1"></i>Save Credential
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private static readonly string[] ServiceKeys =
    {
        "NmiSpreedly", "NmiDirect", "CheckoutEUR", "CheckoutUS", "CheckoutUsLlc", "Shift4", "StripeEms", "CurrencyConverterApi",
        // Payout gateways. PayQuicker lleva una clave POR VERSIÓN: los scopes de v1
        // (useraccount_*) devuelven invalid_scope con credenciales v2, así que no son
        // intercambiables. La versión activa se elige en Payout Gateways.
        "PayQuickerV2", "PayQuickerV1", "EWallet", "Volet"
    };

    // Cada ServiceKey puede existir en varios ambientes; la clave real es el par
    // (ServiceKey, Environment). Sin esto el API no sabe cuál fila devolver o pisar.
    private static readonly string[] Environments = { "Sandbox", "Production", "Test" };
    private string _selectedEnvironment = "Sandbox";

    private string _selectedKey = "NmiSpreedly";
    private CredentialMetadataDto? _metadata;
    private bool _metadataMissing;
    private bool _loading = true;
    private bool _saving;
    private string? _alertMsg;
    private bool _alertIsError;
    private CredentialFormModel _form = new();

    protected override async Task OnInitializedAsync() => await LoadMetadata(_selectedKey);

    private async Task SelectKey(string key)
    {
        if (key == _selectedKey) return;
        _selectedKey = key;
        await LoadMetadata(key);
    }

    // Calificado a propósito: Syncfusion also ships a ChangeEventArgs y el _Imports trae ambos.
    private async Task SelectEnvironment(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _selectedEnvironment = e.Value?.ToString() ?? "Sandbox";
        await LoadMetadata(_selectedKey);
    }

    private async Task LoadMetadata(string key)
    {
        _loading = true; _metadata = null; _metadataMissing = false; StateHasChanged();
        try
        {
            var resp = await Http.GetAsync(
                $"api/v1/admin/billing/credentials/{Uri.EscapeDataString(key)}?environment={Uri.EscapeDataString(_selectedEnvironment)}");
            if (resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadFromJsonAsync<ApiResp<CredentialMetadataDto>>();
                if (body?.Success == true && body.Data is not null)
                {
                    _metadata = body.Data;
                    _form = new CredentialFormModel
                    {
                        Environment = _metadata.Environment,
                        BaseUrl     = _metadata.BaseUrl,
                        IsActive    = _metadata.IsActive,
                        PortalUrl   = _metadata.PortalUrl
                    };
                }
            }
            else if (resp.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _metadataMissing = true;
                _form = new CredentialFormModel { Environment = _selectedEnvironment, IsActive = true };
            }
            else { _alertMsg = $"Failed to load credential ({resp.StatusCode})."; _alertIsError = true; }
        }
        catch (Exception ex) { _alertMsg = $"Error: {ex.Message}"; _alertIsError = true; }
        finally { _loading = false; }
    }

    private async Task Save()
    {
        _saving = true;
        try
        {
            // Los secretos van EN CLARO sobre TLS y los cifra el AdminAPI, que es el unico
            // proceso con acceso al key ring. Antes esta pantalla concatenaba "ENC:" al texto
            // plano, lo que parecia cifrado pero guardaba el secreto legible en la base.
            // Campo vacio = null = "no cambiar ese secreto".
            var payload = new
            {
                _form.Environment,
                BaseUrl = string.IsNullOrWhiteSpace(_form.BaseUrl) ? null : _form.BaseUrl.Trim(),
                IsActive = (bool?)_form.IsActive,
                ApiKey           = Trimmed(_form.ApiKey),
                SecretKey        = Trimmed(_form.SecretKey),
                MerchantId       = Trimmed(_form.MerchantId),
                AdditionalSecret = Trimmed(_form.AdditionalSecret),
                PortalUrl        = string.IsNullOrWhiteSpace(_form.PortalUrl) ? null : _form.PortalUrl!.Trim(),
                PortalUsername   = Trimmed(_form.PortalUsername),
                PortalPassword   = Trimmed(_form.PortalPassword)
            };
            var response = await Http.PutAsJsonAsync($"api/v1/admin/billing/credentials/{Uri.EscapeDataString(_selectedKey)}", payload);
            if (response.IsSuccessStatusCode)
            {
                _alertMsg = "Credential saved.";
                _alertIsError = false;
                _form.ApiKey = _form.SecretKey = _form.MerchantId = string.Empty;
                _form.AdditionalSecret = _form.PortalUsername = _form.PortalPassword = string.Empty;
                await LoadMetadata(_selectedKey);
            }
            else
            {
                var body = await response.Content.ReadFromJsonAsync<ApiResp<object>>();
                _alertMsg = body?.Errors?.FirstOrDefault() ?? $"Save failed ({response.StatusCode}).";
                _alertIsError = true;
            }
        }
        catch (Exception ex) { _alertMsg = $"Error: {ex.Message}"; _alertIsError = true; }
        finally { _saving = false; }
    }

    private static string? Trimmed(string? raw) =>
        string.IsNullOrWhiteSpace(raw) ? null : raw.Trim();

    private static MarkupString SecretIndicator(bool isSet) =>
        isSet
            ? new MarkupString("<span class=\"badge bg-success\">•••• set</span>")
            : new MarkupString("<span class=\"badge bg-light text-dark border\">not set</span>");

    private class CredentialFormModel
    {
        public string Environment { get; set; } = "Production";
        public string? BaseUrl { get; set; }
        public bool IsActive { get; set; } = true;
        public string? ApiKey { get; set; }
        public string? SecretKey { get; set; }
        public string? MerchantId { get; set; }
        public string? AdditionalSecret { get; set; }
        public string? PortalUrl { get; set; }
        public string? PortalUsername { get; set; }
        public string? PortalPassword { get; set; }
    }

    private record CredentialMetadataDto(string Id, string ServiceKey, string Environment, string? BaseUrl,
        bool HasApiKey, bool HasSecretKey, bool HasMerchantId, bool IsActive, DateTime CreationDate,
        string? PortalUrl, bool HasPortalUsername, bool HasPortalPassword, bool HasAdditionalSecret);

    // Etiquetas por gateway: los cuatro slots de secreto significan cosas distintas según
    // el proveedor, y mostrarlos como "API Key / Secret Key / Merchant ID" a secas obliga
    // a adivinar qué va en cada uno.
    private (string Api, string Secret, string Merchant, string? Additional) SecretLabels() =>
        _selectedKey.StartsWith("PayQuicker", StringComparison.OrdinalIgnoreCase)
            ? ("Client ID", "Client Secret", "Funding account token (acct-…)", "Program token (prog-…)")
            : _selectedKey.Equals("EWallet", StringComparison.OrdinalIgnoreCase)
                ? ("Merchant GUID", "Merchant Password", "(unused)", null)
                // Volet firma cada llamada SOAP con un token derivado: la plantilla lleva un
                // ##datetime## que se reemplaza por yyyyMMdd:HH en UTC y se hashea con SHA-256.
                // Va la PLANTILLA, no un token ya calculado: uno fijo vence a la hora.
                : _selectedKey.Equals("Volet", StringComparison.OrdinalIgnoreCase)
                    ? ("API name", "Auth token template (con ##datetime##)", "Merchant account email", null)
                    : ("API Key", "Secret Key", "Merchant ID", null);
    private record ApiResp<T>(bool Success, T? Data, IEnumerable<string>? Errors);
}
