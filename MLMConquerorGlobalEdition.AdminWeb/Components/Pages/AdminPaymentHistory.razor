@page "/admin/billing/payments"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HttpClient Http
@using MLMConquerorGlobalEdition.SharedComponents.Components.Grid
@using Syncfusion.Blazor.Data

<PageTitle>Payment History — Admin</PageTitle>

<BreadcrumbNav Items="@(new List<BreadcrumbNav.BreadcrumbItem> { new("Admin Dashboard", "/admin"), new("Payment History") })" />

<div class="card border-0 shadow-sm">
    <div class="card-header py-3">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold small mb-1">From</label>
                <input type="date" class="form-control form-control-sm"
                       value="@_dateFrom.ToString("yyyy-MM-dd")"
                       @onchange="e => { if (DateTime.TryParse(e.Value?.ToString(), out var d)) _dateFrom = d; }" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small mb-1">To</label>
                <input type="date" class="form-control form-control-sm"
                       value="@_dateTo.ToString("yyyy-MM-dd")"
                       @onchange="e => { if (DateTime.TryParse(e.Value?.ToString(), out var d)) _dateTo = d; }" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small mb-1">Status</label>
                <select class="form-select form-select-sm" @bind="_statusFilter">
                    <option value="">All Statuses</option>
                    @* Valores = nombres del enum PaymentHistoryTransactionStatus. "Completed" no existia en el enum y no *@
                    @* encontraba nada: un pago cobrado es "Captured".                                                  *@
                    <option value="Captured">Captured</option>
                    <option value="Authorized">Authorized</option>
                    <option value="Pending">Pending</option>
                    <option value="Failed">Failed</option>
                    <option value="Refunded">Refunded</option>
                    <option value="Voided">Voided</option>
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary btn-sm w-100" @onclick="ApplyFiltersAsync">
                    <i class="ri-search-line me-1"></i>Search
                </button>
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        @if (_error is not null)
        {
            <div class="alert alert-danger m-3">@_error</div>
        }
        @* Grid de servidor: filtros de columna, orden y pagina viajan al servidor por ServerGridAdaptor y abarcan    *@
        @* TODOS los pagos, no solo la pagina cargada. Fechas y estado de la cabecera van en la query y se aplican al *@
        @* pulsar Search. Filtro de tipo Menu (operador + valor): el de Excel pide la lista de valores de la columna, *@
        @* que con un millon de filas tarda segundos. GridCargando tapa el grid mientras dura cada lectura.           *@
        <GridCargando Visible="_cargando" Texto="Loading payments…">
            <SfGrid TValue="PaymentDto" @ref="_grid"
                    AllowPaging="true" AllowFiltering="true" AllowSorting="true" AllowResizing="true" GridLines="GridLine.Horizontal">
                <SfDataManager Adaptor="Adaptors.CustomAdaptor">
                    <ServerGridAdaptor TValue="PaymentDto"
                                       Http="Http"
                                       Endpoint="api/v1/admin/payments/grid"
                                       QueryStringProvider="BuildQueryString"
                                       OnServerError="OnServerErrorAsync"
                                       OnLoading="OnCargandoAsync" />
                </SfDataManager>
                <GridPageSettings PageSize="50" PageSizes="@(new[] { "25", "50", "100" })" />
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
                <GridColumns>
                    <GridColumn Field="@nameof(PaymentDto.GatewayTransactionId)" HeaderText="Transaction ID" Width="160" AllowFiltering="true">
                        <Template>
                            @{ var tx = ((PaymentDto)context).GatewayTransactionId; }
                            @if (string.IsNullOrEmpty(tx))
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                <code class="text-primary small" title="@tx">@tx[..Math.Min(16, tx.Length)]</code>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(PaymentDto.MemberId)" HeaderText="Member ID" Width="130" AllowFiltering="true">
                        <Template>
                            <a href="/admin/members/@(((PaymentDto)context).MemberId)" class="text-primary"><code>@(((PaymentDto)context).MemberId)</code></a>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(PaymentDto.Amount)" HeaderText="Amount" Width="110" TextAlign="TextAlign.Right" Type="ColumnType.Decimal" AllowFiltering="true">
                        <Template>
                            <span class="fw-semibold">@NumeroCorto.Monto(((PaymentDto)context).Amount)</span>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(PaymentDto.GatewayName)" HeaderText="Gateway" Width="120" AllowFiltering="true" />
                    <GridColumn Field="@nameof(PaymentDto.Status)" HeaderText="Status" Width="110" AllowFiltering="true">
                        <Template>
                            <span class="badge @StatusBadge(((PaymentDto)context).Status)">@(((PaymentDto)context).Status)</span>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(PaymentDto.FailureReason)" HeaderText="Failure Reason" Width="200" AllowFiltering="true">
                        <Template>
                            <span class="text-muted small">@(((PaymentDto)context).FailureReason ?? "—")</span>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(PaymentDto.CreationDate)" HeaderText="Date" Width="150" Format="yyyy-MM-dd HH:mm" Type="ColumnType.DateTime" AllowFiltering="true" />
                </GridColumns>
            </SfGrid>
        </GridCargando>
    </div>
</div>

@code {
    private SfGrid<PaymentDto>? _grid;
    private string? _error;
    private bool _cargando;
    private DateTime _dateFrom = DateTime.Today.AddDays(-2);
    private DateTime _dateTo   = DateTime.Today;
    private string _statusFilter = string.Empty;

    // ServerGridAdaptor avisa al empezar y al terminar cada lectura; GridCargando tapa el grid mientras tanto.
    private async Task OnCargandoAsync(bool cargando)
    {
        _cargando = cargando;
        if (cargando) _error = null;
        await InvokeAsync(StateHasChanged);
    }

    // Un 400 del servidor (p. ej. un estado no valido) se explica arriba en vez de dejar el grid vacio sin motivo.
    private async Task OnServerErrorAsync(string? errorCode)
    {
        _error = errorCode is null ? "Failed to load payments." : $"Failed to load payments ({errorCode}).";
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Query extra que ServerGridAdaptor anade al endpoint en cada lectura: rango de fechas y estado de la cabecera.
    /// Se evalua en cada lectura, asi que la pagina siguiente o un filtro de columna conservan el rango elegido.
    /// </summary>
    private string? BuildQueryString()
    {
        var parts = new List<string>
        {
            $"from={_dateFrom:yyyy-MM-dd}",
            $"to={_dateTo:yyyy-MM-dd}",
        };
        if (!string.IsNullOrWhiteSpace(_statusFilter))
            parts.Add($"status={Uri.EscapeDataString(_statusFilter)}");
        return string.Join("&", parts);
    }

    /// <summary>Boton Search: el grid vuelve a leer con las fechas y el estado de la cabecera.</summary>
    private async Task ApplyFiltersAsync()
    {
        if (_grid is not null) await _grid.Refresh();
    }

    private static string StatusBadge(string s) => s switch
    { "Captured" => "bg-success", "Authorized" => "bg-primary", "Pending" => "bg-warning text-dark", "Failed" => "bg-danger",
      "Refunded" => "bg-info text-dark", _ => "bg-secondary" };

    // Mismo contrato JSON que MLMConquerorGlobalEdition.AdminAPI.DTOs.Payments.AdminPaymentDto (AdminWeb no referencia
    // la API). El record anterior pedia TransactionId, Currency, Gateway y Description, que la API no devuelve.
    public record PaymentDto(string Id, string MemberId, string OrderId, decimal Amount, string GatewayName,
        string? GatewayTransactionId, string Status, string? FailureReason, DateTime? ProcessedAt, DateTime CreationDate);
}
