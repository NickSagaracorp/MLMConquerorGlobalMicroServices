@page "/admin/members"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using MLMConquerorGlobalEdition.SharedComponents.Components.Grid
@using Syncfusion.Blazor.Data

<PageTitle>Members — Admin</PageTitle>

<BreadcrumbNav Items="@(new List<BreadcrumbNav.BreadcrumbItem> { new("Admin Dashboard", "/admin"), new("Members") })" />

@* Four headline counters above the grid. Cached server-side (~30s) so a   *@
@* "Refresh" click and a page back-and-forth don't re-run the four COUNT   *@
@* queries. Quietly degrades to "—" on error — never breaks the page.     *@
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="d-flex align-items-start gap-2">
                    <i class="ri-user-line fs-4 text-success"></i>
                    <div class="flex-grow-1">
                        <div class="fs-3 fw-bold lh-1">@FormatStat(_stats?.TotalActive)</div>
                        <small class="text-muted">Active Members</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="d-flex align-items-start gap-2">
                    <i class="ri-user-add-line fs-4 text-primary"></i>
                    <div class="flex-grow-1">
                        <div class="fs-3 fw-bold lh-1">@FormatStat(_stats?.NewSignupsLast24Hours)</div>
                        <small class="text-muted">New Signups (24h)</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="d-flex align-items-start gap-2">
                    <i class="ri-user-unfollow-line fs-4 text-danger"></i>
                    <div class="flex-grow-1">
                        <div class="fs-3 fw-bold lh-1">@FormatStat(_stats?.CancellationsLast24Hours)</div>
                        <small class="text-muted">Cancellations (24h)</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="d-flex align-items-start gap-2">
                    <i class="ri-share-forward-line fs-4 text-info"></i>
                    <div class="flex-grow-1">
                        <div class="fs-3 fw-bold lh-1">@FormatStat(_stats?.PlacementsLast24Hours)</div>
                        <small class="text-muted">Placements (24h)</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header py-3 d-flex align-items-center gap-3 flex-wrap">
        <h6 class="card-title mb-0 fw-semibold flex-grow-1">
            <i class="ri-group-line me-2 text-primary"></i>Member Management
        </h6>
        <input class="form-control form-control-sm" style="min-width:220px"
               placeholder="Search by name, ID..."
               @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKey" />
        <select class="form-select form-select-sm w-auto" style="min-width:140px"
                @bind="_statusFilter" @bind:after="OnStatusChangedAsync">
            <option value="">All Statuses</option>
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
            <option value="Suspended">Suspended</option>
            <option value="Pending">Pending</option>
        </select>
        <button class="btn btn-primary btn-sm" @onclick="ApplySearchAsync">
            <i class="ri-search-line me-1"></i>Search
        </button>
        <button type="button"
                class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1"
                title="Refresh from server"
                @onclick="RefreshAsync">
            <i class="ri-refresh-line"></i>
            <span>Refresh</span>
        </button>
    </div>
    @if (_retryMessage is not null)
    {
        <div class="alert @(_retryIsError ? "alert-danger" : "alert-success") alert-dismissible m-3">
            @_retryMessage
            <button type="button" class="btn-close" @onclick="() => _retryMessage = null"></button>
        </div>
    }
    <div class="card-body p-0">
        @* Server-side grid: search / column filters / sort / paging ALL travel to the     *@
        @* server via ServerGridAdaptor, so they span EVERY record — not just the current   *@
        @* page. PageSize options capped at 100 (server mirrors this cap). The Excel filter  *@
        @* menu also issues its own reads for distinct values; the same endpoint serves them.*@
        <SfGrid TValue="AdminMemberDto" @ref="_grid"
                AllowPaging="true" AllowSorting="true" AllowFiltering="true"
                AllowResizing="true" GridLines="GridLine.Horizontal">
            <SfDataManager Adaptor="Adaptors.CustomAdaptor">
                <ServerGridAdaptor TValue="AdminMemberDto"
                                   Http="Http"
                                   Endpoint="api/v1/admin/members/grid"
                                   QueryStringProvider="BuildQueryString"
                                   AccessTokenProvider="GetTokenAsync" />
            </SfDataManager>
            <GridPageSettings PageSize="50" PageSizes="@(new[] { "25", "50", "100" })" />
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
            <GridColumns>
                <GridColumn Field="@nameof(AdminMemberDto.MemberId)" HeaderText="Member ID" Width="130" AllowFiltering="true">
                    <Template>
                        @{ var m = (AdminMemberDto)context; }
                        <a href="/admin/members/@m.MemberId" target="_blank" class="text-decoration-none">
                            <code class="text-primary">@m.MemberId</code>
                        </a>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(AdminMemberDto.FirstName)" HeaderText="Name" Width="180" AllowFiltering="true">
                    <Template>
                        @{ var m = (AdminMemberDto)context; }
                        <a href="/admin/members/@m.MemberId" target="_blank" class="text-primary">
                            @m.FirstName @m.LastName
                        </a>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(AdminMemberDto.Email)" HeaderText="Email" Width="200" AllowFiltering="true">
                    <Template>
                        @(((AdminMemberDto)context).Email ?? "—")
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(AdminMemberDto.Phone)" HeaderText="Phone" Width="130" AllowFiltering="true">
                    <Template>
                        @(((AdminMemberDto)context).Phone ?? "—")
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(AdminMemberDto.Country)" HeaderText="Country" Width="110" AllowFiltering="true" />
                <GridColumn Field="@nameof(AdminMemberDto.ReplicateSiteSlug)" HeaderText="Website" Width="160" AllowFiltering="true">
                    <Template>
                        @(((AdminMemberDto)context).ReplicateSiteSlug ?? "—")
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(AdminMemberDto.MembershipLevelName)" HeaderText="Membership" Width="150" AllowFiltering="true">
                    <Template>
                        @{ var lvl = ((AdminMemberDto)context).MembershipLevelName; }
                        @if (!string.IsNullOrWhiteSpace(lvl))
                        {
                            <span class="badge bg-info text-dark">@lvl</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(AdminMemberDto.LifetimeRankName)" HeaderText="Lifetime Rank" Width="150" AllowFiltering="true">
                    <Template>
                        @{ var lr = ((AdminMemberDto)context).LifetimeRankName; }
                        @if (!string.IsNullOrWhiteSpace(lr))
                        {
                            <span class="badge bg-warning text-dark">@lr</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(AdminMemberDto.SponsorFullName)" HeaderText="Sponsor" Width="180" AllowFiltering="true">
                    <Template>
                        @{ var m = (AdminMemberDto)context; }
                        @if (!string.IsNullOrWhiteSpace(m.SponsorMemberId) && !string.IsNullOrWhiteSpace(m.SponsorFullName))
                        {
                            <a href="/admin/members/@m.SponsorMemberId" target="_blank" class="text-primary">@m.SponsorFullName</a>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(AdminMemberDto.DualTeamUplineFullName)" HeaderText="Upline" Width="180" AllowFiltering="true">
                    <Template>
                        @{ var m = (AdminMemberDto)context; }
                        @if (!string.IsNullOrWhiteSpace(m.DualTeamParentMemberId) && !string.IsNullOrWhiteSpace(m.DualTeamUplineFullName))
                        {
                            <a href="/admin/members/@m.DualTeamParentMemberId" target="_blank" class="text-primary">@m.DualTeamUplineFullName</a>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(AdminMemberDto.MemberType)" HeaderText="Type" Width="120" AllowFiltering="true">
                    <Template>
                        <span class="badge bg-secondary">@(((AdminMemberDto)context).MemberType)</span>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(AdminMemberDto.Status)" HeaderText="Status" Width="110" AllowFiltering="true">
                    <Template>
                        <span class="badge @StatusBadge(((AdminMemberDto)context).Status)">@(((AdminMemberDto)context).Status)</span>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(AdminMemberDto.EnrollDate)" HeaderText="Enrolled" Width="130" Format="yyyy-MM-dd" Type="ColumnType.Date" AllowFiltering="true" />
                <GridColumn Field="@nameof(AdminMemberDto.ExpirationDate)" HeaderText="Expiration Date" Width="140" Format="yyyy-MM-dd" Type="ColumnType.Date" AllowFiltering="true" />
                <GridColumn HeaderText="Actions" Width="170" TextAlign="TextAlign.Center" AllowFiltering="false">
                    <Template>
                        @{ var m = (AdminMemberDto)context; }
                        <a href="/admin/members/@m.MemberId" target="_blank" class="btn btn-sm btn-outline-primary py-0 px-2" title="View Profile">
                            <i class="ri-eye-line"></i>
                        </a>
                        <button class="btn btn-sm btn-outline-secondary py-0 px-2 ms-1" title="Binary Tree"
                            @onclick="@(() => Navigation.NavigateTo($"/admin/network/binary-tree?memberId={m.MemberId}"))">
                            <i class="ri-node-tree"></i>
                        </button>
                        @if (m.Status == "Pending")
                        {
                            <button class="btn btn-sm btn-outline-warning py-0 px-2 ms-1" title="Retry Complete Signup"
                                disabled="@_retryingMemberId.Equals(m.MemberId)"
                                @onclick="@(() => RetryCompleteAsync(m.MemberId))">
                                @if (_retryingMemberId == m.MemberId)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                }
                                else
                                {
                                    <i class="ri-refresh-line"></i>
                                }
                            </button>
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    </div>
</div>

@code {
    private SfGrid<AdminMemberDto>? _grid;

    // The JWT lives as an "access_token" claim on the ClaimsPrincipal. Resolved here from the
    // cascading AuthenticationState (reliable even inside Syncfusion's ReadAsync context) and
    // handed to the adaptor so it attaches Authorization: Bearer per request — sidestepping the
    // 401 seen when AdminApiAuthHandler's own provider fallback returns no token.
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private async Task<string?> GetTokenAsync()
    {
        if (AuthState is null) return null;
        var state = await AuthState;
        return state.User.FindFirstValue("access_token");
    }

    private string  _search            = string.Empty;
    private string  _statusFilter      = string.Empty;
    private string  _retryingMemberId  = string.Empty;
    private string? _retryMessage;
    private bool    _retryIsError;
    private MemberStatsDto? _stats;

    // When true, the NEXT ServerGridAdaptor read appends bypassCache=true so the admin
    // sees fresh data on a "Refresh" click. Reset to false after that single read.
    private bool _bypassCacheOnce;

    protected override async Task OnInitializedAsync()
    {
        // The grid loads itself through the adaptor; we only need the headline stats here.
        await LoadStatsAsync();
    }

    /// <summary>
    /// Builds the extra query string the <see cref="ServerGridAdaptor{T}"/> appends to its
    /// endpoint on each read. The closure is re-evaluated on every read, so it always reflects
    /// the current status filter and a one-shot cache bypass. Status is carried as a query param
    /// (matching the endpoint contract) rather than as a column filter so it survives the Excel
    /// filter menu's own value-list reads.
    /// </summary>
    private string? BuildQueryString()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(_statusFilter))
            parts.Add($"status={Uri.EscapeDataString(_statusFilter)}");
        if (_bypassCacheOnce)
        {
            parts.Add("bypassCache=true");
            _bypassCacheOnce = false; // consume — only the triggering refresh bypasses cache
        }
        return parts.Count == 0 ? null : string.Join("&", parts);
    }

    /// <summary>
    /// "Search" button + Enter key. Drives Syncfusion's built-in search, which fires a server
    /// read with the term in <c>dm.Search</c>; the adaptor maps it to <c>GridDataRequest.Search</c>.
    /// </summary>
    private async Task ApplySearchAsync()
    {
        if (_grid is not null)
            await _grid.SearchAsync(_search ?? string.Empty);
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ApplySearchAsync();
    }

    /// <summary>Status dropdown change → re-read the grid (status travels as a query param).</summary>
    private async Task OnStatusChangedAsync()
    {
        if (_grid is not null) await _grid.Refresh();
    }

    /// <summary>
    /// "Refresh" — forces a cache bypass on the next adaptor read and re-pulls the grid plus
    /// the headline counters so the admin sees fresh data on demand.
    /// </summary>
    private async Task RefreshAsync()
    {
        _bypassCacheOnce = true;
        var stats = LoadStatsAsync(bypassCache: true);
        if (_grid is not null) await _grid.Refresh();
        await stats;
    }

    private async Task LoadStatsAsync(bool bypassCache = false)
    {
        try
        {
            var url = "api/v1/admin/members/stats";
            if (bypassCache) url += "?bypassCache=true";
            var resp = await Http.GetFromJsonAsync<ApiResponse<MemberStatsDto>>(url);
            if (resp?.Success == true) _stats = resp.Data;
        }
        catch
        {
            // Silently degrade — the stat cards render "—" when _stats is null.
            // The grid below is the source of truth; the stat row is a nice-to-have.
        }
        finally { StateHasChanged(); }
    }

    private static string FormatStat(int? value) => value?.ToString("N0") ?? "—";

    private async Task RetryCompleteAsync(string memberId)
    {
        // Look up the pending order for this member via the pending-signups endpoint.
        _retryingMemberId = memberId;
        _retryMessage = null;
        StateHasChanged();
        try
        {
            var pending = await Http.GetFromJsonAsync<ApiResponse<List<PendingSignupDto>>>("api/v1/admin/signups/pending");
            var match = pending?.Data?.FirstOrDefault(p => p.MemberId == memberId);
            if (match is null)
            {
                _retryMessage = "No pending signup found for this member."; _retryIsError = true; return;
            }

            var resp = await Http.PostAsync($"api/v1/admin/signups/{match.OrderId}/retry-complete", null);
            if (resp.IsSuccessStatusCode)
            {
                _retryMessage = $"Signup completed for {memberId}. Reloading list…";
                _retryIsError = false;
                if (_grid is not null) await _grid.Refresh();
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                _retryMessage = $"Retry failed ({(int)resp.StatusCode}): {body}";
                _retryIsError = true;
            }
        }
        catch (Exception ex) { _retryMessage = $"Retry error: {ex.Message}"; _retryIsError = true; }
        finally { _retryingMemberId = string.Empty; StateHasChanged(); }
    }

    private static string StatusBadge(string status) => status switch
    { "Active" => "bg-success", "Inactive" => "bg-secondary", "Suspended" => "bg-danger", _ => "bg-secondary" };

    private record PendingSignupDto(string MemberId, string FullName, string Email,
        string Country, string? SponsorMemberId, DateTime EnrollDate, string OrderId, decimal OrderTotal);

    public record AdminMemberDto(string MemberId, string FirstName, string LastName,
        string? Phone, string? Email, string Country, string Status, string MemberType,
        DateTime EnrollDate, DateTime? ExpirationDate,
        string? SponsorMemberId, string? SponsorFullName,
        string? DualTeamParentMemberId, string? DualTeamUplineFullName,
        string? ReplicateSiteSlug, string? MembershipLevelName,
        string? LifetimeRankName,
        DateTime CreationDate);
    private record ApiResponse<T>(bool Success, T? Data, IEnumerable<string>? Errors);

    // Mirrors MLMConquerorGlobalEdition.AdminAPI.DTOs.Members.MemberStatsDto.
    // AdminWeb intentionally doesn't reference the AdminAPI project (it talks to
    // it over HTTP), so the contract is duplicated by JSON shape — same naming
    // convention the page already uses for AdminMemberDto / PendingSignupDto.
    private record MemberStatsDto(
        int TotalActive,
        int NewSignupsLast24Hours,
        int CancellationsLast24Hours,
        int PlacementsLast24Hours);
}
