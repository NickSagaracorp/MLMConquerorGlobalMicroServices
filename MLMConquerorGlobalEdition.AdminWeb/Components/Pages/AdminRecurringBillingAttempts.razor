@page "/admin/billing/recurring-attempts"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin,Admin,BillingManager")]
@inject HttpClient Http

<PageTitle>Recurring Billing Attempts — Admin</PageTitle>

<BreadcrumbNav Items="@(new List<BreadcrumbNav.BreadcrumbItem> { new("Admin Dashboard", "/admin"), new("Billing"), new("Recurring Attempts") })" />

@if (_alertMsg is not null)
{
    <div class="alert alert-danger alert-dismissible mb-3">@_alertMsg <button type="button" class="btn-close" @onclick="() => _alertMsg = null"></button></div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header py-3">
        <div class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="form-label fw-semibold small mb-1">Outcome</label>
                <select class="form-select form-select-sm" @bind="_outcomeFilter">
                    <option value="">All</option>
                    <option value="Success">Success</option>
                    <option value="Failed">Failed</option>
                    <option value="Scheduled">Scheduled</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold small mb-1">Funding Source</label>
                <select class="form-select form-select-sm" @bind="_fundingFilter">
                    <option value="">All</option>
                    <option value="CommissionBalance">Commission Balance</option>
                    <option value="CreditCard">Credit Card</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold small mb-1">Member ID</label>
                <input class="form-control form-control-sm" @bind="_memberFilter" placeholder="optional" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold small mb-1">From (UTC)</label>
                <input type="date" class="form-control form-control-sm" @bind="_fromDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold small mb-1">To (UTC)</label>
                <input type="date" class="form-control form-control-sm" @bind="_toDate" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary btn-sm w-100" @onclick="Search"><i class="ri-search-line me-1"></i>Search</button>
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        @if (_loading)
        {
            <div class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div></div>
        }
        else
        {
            <SfGrid TValue="AttemptDto" DataSource="@_items"
                    AllowFiltering="true" AllowSorting="true" AllowResizing="true" GridLines="GridLine.Horizontal">
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
                <GridColumns>
                    <GridColumn Field="@nameof(AttemptDto.AttemptedAt)" HeaderText="Attempted (UTC)" Width="150" Format="yyyy-MM-dd HH:mm" Type="ColumnType.DateTime" />
                    <GridColumn HeaderText="Member" Width="130">
                        <Template><a href="/admin/members/@(((AttemptDto)context).MemberId)" class="text-primary"><code class="small">@(((AttemptDto)context).MemberId)</code></a></Template>
                    </GridColumn>
                    <GridColumn HeaderText="Product" Width="150">
                        <Template><code class="small text-muted">@(((AttemptDto)context).ProductId)</code></Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(AttemptDto.AttemptIndex)" HeaderText="Attempt #" Width="90" TextAlign="TextAlign.Center" />
                    <GridColumn HeaderText="Amount" Width="110" TextAlign="TextAlign.Right">
                        <Template>$@(((AttemptDto)context).Amount.ToString("F2"))</Template>
                    </GridColumn>
                    <GridColumn HeaderText="Funding Source" Width="140" TextAlign="TextAlign.Center">
                        <Template><span class="badge @FundingBadge(((AttemptDto)context).FundingSource)">@FundingLabel(((AttemptDto)context).FundingSource)</span></Template>
                    </GridColumn>
                    <GridColumn HeaderText="Outcome" Width="110" TextAlign="TextAlign.Center">
                        <Template><span class="badge @OutcomeBadge(((AttemptDto)context).Outcome)">@(((AttemptDto)context).Outcome)</span></Template>
                    </GridColumn>
                    <GridColumn HeaderText="Payment History" Width="150">
                        <Template><code class="small text-muted">@(((AttemptDto)context).PaymentHistoryId ?? "—")</code></Template>
                    </GridColumn>
                    <GridColumn HeaderText="Order" Width="140">
                        <Template><code class="small text-muted">@(((AttemptDto)context).OrderId ?? "—")</code></Template>
                    </GridColumn>
                    <GridColumn HeaderText="Token Txn" Width="100" TextAlign="TextAlign.Center">
                        <Template>@(((AttemptDto)context).TokenTransactionId?.ToString() ?? "—")</Template>
                    </GridColumn>
                    <GridColumn HeaderText="Comm. Deduction" Width="150">
                        <Template><code class="small text-muted">@(((AttemptDto)context).CommissionDeductionEarningId ?? "—")</code></Template>
                    </GridColumn>
                    <GridColumn HeaderText="Gateway Attempt" Width="120" TextAlign="TextAlign.Center">
                        <Template>@(((AttemptDto)context).GatewayChargeAttemptId?.ToString() ?? "—")</Template>
                    </GridColumn>
                    <GridColumn HeaderText="Failure Reason" Width="220">
                        <Template><span class="small text-danger">@(((AttemptDto)context).FailureReason ?? "—")</span></Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>

            @if (_totalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top bg-light">
                    <small class="text-muted">@_totalCount attempts — Page @_page of @_totalPages</small>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(_page == 1 ? "disabled" : "")"><button class="page-link" @onclick="() => ChangePage(_page - 1)">‹</button></li>
                            @for (int i = Math.Max(1, _page - 2); i <= Math.Min(_totalPages, _page + 2); i++)
                            { var pg = i; <li class="page-item @(_page == pg ? "active" : "")"><button class="page-link" @onclick="() => ChangePage(pg)">@pg</button></li> }
                            <li class="page-item @(_page == _totalPages ? "disabled" : "")"><button class="page-link" @onclick="() => ChangePage(_page + 1)">›</button></li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
    <div class="card-footer bg-light small text-muted">
        Read-only chain-of-custody audit of every recurring billing attempt. Outcome, funding source, member and date range are filtered server-side.
    </div>
</div>

@code {
    private List<AttemptDto> _items = new();
    private bool _loading = true;
    private string? _alertMsg;
    private string _outcomeFilter = string.Empty;
    private string _fundingFilter = string.Empty;
    private string _memberFilter = string.Empty;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private int _page = 1;
    private const int PageSize = 25;
    private int _totalCount;
    private int _totalPages = 1;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; _alertMsg = null; StateHasChanged();
        try
        {
            var url = $"api/v1/admin/billing/recurring-attempts?page={_page}&pageSize={PageSize}";
            if (!string.IsNullOrWhiteSpace(_outcomeFilter)) url += $"&outcome={Uri.EscapeDataString(_outcomeFilter)}";
            if (!string.IsNullOrWhiteSpace(_fundingFilter)) url += $"&fundingSource={Uri.EscapeDataString(_fundingFilter)}";
            if (!string.IsNullOrWhiteSpace(_memberFilter)) url += $"&memberId={Uri.EscapeDataString(_memberFilter.Trim())}";
            if (_fromDate.HasValue) url += $"&fromDate={_fromDate.Value:yyyy-MM-dd}";
            if (_toDate.HasValue) url += $"&toDate={_toDate.Value:yyyy-MM-dd}";
            var resp = await Http.GetFromJsonAsync<ApiResp<Paged<AttemptDto>>>(url);
            if (resp?.Success == true && resp.Data is not null)
            {
                _items = resp.Data.Items.ToList();
                _totalCount = resp.Data.TotalCount;
                _totalPages = resp.Data.TotalPages;
            }
            else { _alertMsg = resp?.Errors?.FirstOrDefault() ?? "Failed to load billing attempts."; }
        }
        catch (Exception ex) { _alertMsg = $"Error: {ex.Message}"; }
        finally { _loading = false; }
    }

    private async Task Search() { _page = 1; await LoadAsync(); }
    private async Task ChangePage(int p) { if (p < 1 || p > _totalPages) return; _page = p; await LoadAsync(); }

    private static string OutcomeBadge(string o) => o switch
    { "Success" => "bg-success", "Failed" => "bg-danger", "Scheduled" => "bg-warning text-dark", _ => "bg-secondary" };
    private static string FundingLabel(string f) => f switch
    { "CommissionBalance" => "Commission Balance", "CreditCard" => "Credit Card", _ => f };
    private static string FundingBadge(string f) => f switch
    { "CommissionBalance" => "bg-info text-dark", "CreditCard" => "bg-primary", _ => "bg-secondary" };

    // Enum-typed fields (FundingSource, Outcome) arrive as enum NAMES from the API (JsonStringEnumConverter).
    private record AttemptDto(long Id, string SubscriptionBillingStateId, string MemberId, string ProductId,
        int AttemptIndex, DateTime AttemptedAt, decimal Amount, string FundingSource, string Outcome,
        string? PaymentHistoryId, string? OrderId, long? TokenTransactionId, string? CommissionDeductionEarningId,
        long? GatewayChargeAttemptId, string? FailureReason);
    private record ApiResp<T>(bool Success, T? Data, IEnumerable<string>? Errors);
    private record Paged<T>(IEnumerable<T> Items, int TotalCount, int Page, int PageSize, int TotalPages);
}
