@page "/admin/billing/recurring-attempts"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin,Admin,BillingManager")]
@inject HttpClient Http
@using MLMConquerorGlobalEdition.SharedComponents.Components.Grid

<PageTitle>Recurring Billing Attempts — Admin</PageTitle>

<BreadcrumbNav Items="@(new List<BreadcrumbNav.BreadcrumbItem> { new("Admin Dashboard", "/admin"), new("Billing"), new("Recurring Attempts") })" />

@if (_alertMsg is not null)
{
    <div class="alert alert-danger alert-dismissible mb-3">@_alertMsg <button type="button" class="btn-close" @onclick="() => _alertMsg = null"></button></div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header py-3">
        <div class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="form-label fw-semibold small mb-1">Outcome</label>
                <select class="form-select form-select-sm" @bind="_outcomeFilter">
                    <option value="">All</option>
                    <option value="Success">Success</option>
                    <option value="Failed">Failed</option>
                    <option value="Scheduled">Scheduled</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold small mb-1">Funding Source</label>
                <select class="form-select form-select-sm" @bind="_fundingFilter">
                    <option value="">All</option>
                    <option value="CommissionBalance">Commission Balance</option>
                    <option value="CreditCard">Credit Card</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold small mb-1">Member ID</label>
                <input class="form-control form-control-sm" @bind="_memberFilter" placeholder="optional" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold small mb-1">From (UTC)</label>
                <input type="date" class="form-control form-control-sm" @bind="_fromDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold small mb-1">To (UTC)</label>
                <input type="date" class="form-control form-control-sm" @bind="_toDate" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary btn-sm w-100" @onclick="Search"><i class="ri-search-line me-1"></i>Search</button>
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        @* Grid de servidor: filtros de columna, orden y página viajan al servidor por ServerGridAdaptor y abarcan
           TODOS los intentos, no solo la página cargada (antes el filtro y el orden del grid trabajaban solo sobre
           las 25 filas traídas). Los controles de arriba van por query string. Filtro de tipo Menu (operador y
           valor) y no Excel, que pediría al servidor la lista de valores de la columna sobre millones de filas.
           GridCargando tapa el grid mientras dura cada lectura. *@
        <GridCargando Visible="_cargando" Texto="Loading attempts…">
        <SfGrid TValue="AttemptDto" @ref="_grid"
                AllowPaging="true" AllowFiltering="true" AllowSorting="true" AllowResizing="true" GridLines="GridLine.Horizontal">
            <SfDataManager Adaptor="Adaptors.CustomAdaptor">
                <ServerGridAdaptor TValue="AttemptDto"
                                   Http="Http"
                                   Endpoint="api/v1/admin/billing/recurring-attempts/grid"
                                   QueryStringProvider="BuildQueryString"
                                   OnLoading="OnCargandoAsync"
                                   OnServerError="OnServerErrorAsync" />
            </SfDataManager>
            <GridPageSettings PageSize="50" PageSizes="@(new[] { "25", "50", "100" })" />
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
            <GridColumns>
                <GridColumn Field="@nameof(AttemptDto.AttemptedAt)" HeaderText="Attempted (UTC)" Width="150" Format="yyyy-MM-dd HH:mm" Type="ColumnType.DateTime" />
                <GridColumn Field="@nameof(AttemptDto.MemberId)" HeaderText="Member" Width="130">
                    <Template><a href="/admin/members/@(((AttemptDto)context).MemberId)" class="text-primary"><code class="small">@(((AttemptDto)context).MemberId)</code></a></Template>
                </GridColumn>
                <GridColumn Field="@nameof(AttemptDto.ProductId)" HeaderText="Product" Width="150">
                    <Template><code class="small text-muted">@(((AttemptDto)context).ProductId)</code></Template>
                </GridColumn>
                <GridColumn Field="@nameof(AttemptDto.AttemptIndex)" HeaderText="Attempt #" Width="90" TextAlign="TextAlign.Center" />
                <GridColumn Field="@nameof(AttemptDto.Amount)" HeaderText="Amount" Width="110" TextAlign="TextAlign.Right">
                    <Template>@NumeroCorto.Monto(((AttemptDto)context).Amount)</Template>
                </GridColumn>
                @* Fuente y resultado se filtran con los desplegables de arriba (el servidor los compara por el nombre
                   exacto del enum); en la columna solo se ordena. *@
                <GridColumn Field="@nameof(AttemptDto.FundingSource)" HeaderText="Funding Source" Width="140" TextAlign="TextAlign.Center" AllowFiltering="false">
                    <Template><span class="badge @FundingBadge(((AttemptDto)context).FundingSource)">@FundingLabel(((AttemptDto)context).FundingSource)</span></Template>
                </GridColumn>
                <GridColumn Field="@nameof(AttemptDto.Outcome)" HeaderText="Outcome" Width="110" TextAlign="TextAlign.Center" AllowFiltering="false">
                    <Template><span class="badge @OutcomeBadge(((AttemptDto)context).Outcome)">@(((AttemptDto)context).Outcome)</span></Template>
                </GridColumn>
                <GridColumn Field="@nameof(AttemptDto.PaymentHistoryId)" HeaderText="Payment History" Width="150">
                    <Template><code class="small text-muted">@(((AttemptDto)context).PaymentHistoryId ?? "—")</code></Template>
                </GridColumn>
                <GridColumn Field="@nameof(AttemptDto.OrderId)" HeaderText="Order" Width="140">
                    <Template><code class="small text-muted">@(((AttemptDto)context).OrderId ?? "—")</code></Template>
                </GridColumn>
                <GridColumn Field="@nameof(AttemptDto.TokenTransactionId)" HeaderText="Token Txn" Width="100" TextAlign="TextAlign.Center">
                    <Template>@(((AttemptDto)context).TokenTransactionId?.ToString() ?? "—")</Template>
                </GridColumn>
                <GridColumn Field="@nameof(AttemptDto.CommissionDeductionEarningId)" HeaderText="Comm. Deduction" Width="150">
                    <Template><code class="small text-muted">@(((AttemptDto)context).CommissionDeductionEarningId ?? "—")</code></Template>
                </GridColumn>
                <GridColumn Field="@nameof(AttemptDto.GatewayChargeAttemptId)" HeaderText="Gateway Attempt" Width="120" TextAlign="TextAlign.Center">
                    <Template>@(((AttemptDto)context).GatewayChargeAttemptId?.ToString() ?? "—")</Template>
                </GridColumn>
                <GridColumn Field="@nameof(AttemptDto.FailureReason)" HeaderText="Failure Reason" Width="220">
                    <Template><span class="small text-danger">@(((AttemptDto)context).FailureReason ?? "—")</span></Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
        </GridCargando>
    </div>
    <div class="card-footer bg-light small text-muted">
        Read-only chain-of-custody audit of every recurring billing attempt. Filters, sorting and paging run server-side over every attempt.
    </div>
</div>

@code {
    private SfGrid<AttemptDto>? _grid;
    private bool _cargando;
    private string? _alertMsg;
    private string _outcomeFilter = string.Empty;
    private string _fundingFilter = string.Empty;
    private string _memberFilter = string.Empty;
    private DateTime? _fromDate;
    private DateTime? _toDate;

    private async Task OnCargandoAsync(bool cargando)
    {
        _cargando = cargando;
        await InvokeAsync(StateHasChanged);
    }

    private Task OnServerErrorAsync(string? errorCode)
    {
        _alertMsg = errorCode is null ? "Failed to load billing attempts." : $"Failed to load billing attempts ({errorCode}).";
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Query string que ServerGridAdaptor añade al endpoint en cada lectura. Se evalúa en cada lectura, así que siempre
    /// lleva lo que hay en los controles de arriba; viajan como query params (el contrato del endpoint) y no como filtros
    /// de columna, para que se apliquen sobre la tabla antes de proyectar.
    /// </summary>
    private string? BuildQueryString()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(_outcomeFilter)) parts.Add($"outcome={Uri.EscapeDataString(_outcomeFilter)}");
        if (!string.IsNullOrWhiteSpace(_fundingFilter)) parts.Add($"fundingSource={Uri.EscapeDataString(_fundingFilter)}");
        if (!string.IsNullOrWhiteSpace(_memberFilter))  parts.Add($"memberId={Uri.EscapeDataString(_memberFilter.Trim())}");
        if (_fromDate.HasValue) parts.Add($"fromDate={_fromDate.Value:yyyy-MM-dd}");
        if (_toDate.HasValue)   parts.Add($"toDate={_toDate.Value:yyyy-MM-dd}");
        return parts.Count == 0 ? null : string.Join("&", parts);
    }

    /// <summary>
    /// "Search": vuelve a leer el grid con los controles de arriba. Si el grid no está en la primera página vuelve a
    /// ella (eso ya lee): con el filtro nuevo la página en la que estaba puede no existir.
    /// </summary>
    private async Task Search()
    {
        _alertMsg = null;
        if (_grid is null) return;
        if (_grid.PageSettings?.CurrentPage > 1) await _grid.GoToPageAsync(1);
        else await _grid.Refresh();
    }

    private static string OutcomeBadge(string o) => o switch
    { "Success" => "bg-success", "Failed" => "bg-danger", "Scheduled" => "bg-warning text-dark", _ => "bg-secondary" };
    private static string FundingLabel(string f) => f switch
    { "CommissionBalance" => "Commission Balance", "CreditCard" => "Credit Card", _ => f };
    private static string FundingBadge(string f) => f switch
    { "CommissionBalance" => "bg-info text-dark", "CreditCard" => "bg-primary", _ => "bg-secondary" };

    // Enum-typed fields (FundingSource, Outcome) arrive as enum NAMES from the API (JsonStringEnumConverter).
    // Los nombres de las propiedades son los campos de filtro y orden que el grid manda al servidor.
    public record AttemptDto(long Id, string SubscriptionBillingStateId, string MemberId, string ProductId,
        int AttemptIndex, DateTime AttemptedAt, decimal Amount, string FundingSource, string Outcome,
        string? PaymentHistoryId, string? OrderId, long? TokenTransactionId, string? CommissionDeductionEarningId,
        long? GatewayChargeAttemptId, string? FailureReason);
}
