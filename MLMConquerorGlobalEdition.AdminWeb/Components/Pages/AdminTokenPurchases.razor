@page "/admin/billing/token-purchases"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = AppRoles.CryptoPaymentApprovers)]
@inject HttpClient Http

@*
    Compras de tokens que necesitan a una persona (Plan F). Arriba, las pagadas en cripto: los cuatro
    roles de aprobación las confirman (emite) o las rechazan (libera el cupo). Abajo, las que quedaron
    a conciliar porque no se supo si el cobro salió: solo tesorería las cierra.

    El atributo y el AuthorizeView solo esconden: AdminAPI y, detrás, Billing vuelven a comprobar el
    rol con el Bearer de quien pulsa.
*@

<PageTitle>Token Purchases — Admin</PageTitle>

<BreadcrumbNav Items="@(new List<BreadcrumbNav.BreadcrumbItem> {
    new("Admin Dashboard", "/admin"), new("Billing"), new("Token Purchases") })" />

@if (_alertMsg is not null)
{
    <div class="alert @(_alertIsError ? "alert-danger" : "alert-success") alert-dismissible mb-3">
        @_alertMsg <button type="button" class="btn-close" @onclick="() => _alertMsg = null"></button>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0 fw-bold">Crypto — awaiting payment confirmation</h5>
            <small class="text-muted">
                No tokens are issued until the transfer is confirmed. The amount is in USD: check the equivalent
                received in the currency shown. Purchases are non-refundable. Unpaid purchases expire after a few days.
            </small>
        </div>
        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync" disabled="@_loading">
            <i class="ri-refresh-line"></i> Refresh
        </button>
    </div>
    <div class="card-body p-0">
        @if (_loading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
        }
        else if (_crypto.Count == 0)
        {
            <div class="text-center py-4 text-muted">
                <i class="ri-bit-coin-line" style="font-size:2.5rem;opacity:.4"></i>
                <p class="mt-2 mb-0">No crypto token purchases are waiting for confirmation.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Requested</th><th>Order</th><th>Member</th><th>Token type</th>
                            <th class="text-end">Qty</th><th>Currency</th><th class="text-end">Amount due (USD)</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dto in _crypto)
                        {
                            <tr>
                                <td class="small text-muted">@dto.RequestedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@(dto.OrderNo ?? dto.OrderId)</td>
                                <td>@dto.FullName <span class="text-muted small">(@dto.MemberId)</span></td>
                                <td>@dto.TokenTypeName</td>
                                <td class="text-end">@dto.Quantity</td>
                                <td><span class="badge bg-warning text-dark">@dto.CryptoCurrency</span></td>
                                <td class="text-end">@dto.AmountDue.ToString("C", Usd)</td>
                                <td class="text-nowrap text-end">
                                    <button class="btn btn-sm btn-outline-success py-0 me-1" @onclick="() => OpenConfirm(dto)">
                                        <i class="ri-check-line me-1"></i>Confirm payment
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger py-0" @onclick="() => OpenReject(dto)">
                                        <i class="ri-close-line me-1"></i>Reject
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<AuthorizeView Roles="@TreasuryRoles">
    <Authorized>
        <div class="card border-0 shadow-sm">
            <div class="card-header py-3">
                <h5 class="mb-0 fw-bold">To review — charge outcome unknown</h5>
                <small class="text-muted">
                    We could not tell whether the money was taken (eWallet processing or pending, no answer from
                    the gateway, or the purchase stopped half-way). Before closing it, check the gateway — the
                    member's i-Payout account, using the purchase id as merchant reference, or the card gateway.
                    No tokens are issued until you mark it as charged.
                </small>
            </div>
            <div class="card-body p-0">
                @if (_loading)
                {
                    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
                }
                else if (_review.Count == 0)
                {
                    <div class="text-center py-4 text-muted"><p class="mb-0">Nothing to review.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Requested</th><th>Purchase id</th><th>Member</th><th>Token type</th>
                                    <th class="text-end">Qty</th><th class="text-end">Total</th><th>Method</th><th>Reason</th><th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dto in _review)
                                {
                                    <tr>
                                        <td class="small text-muted">@dto.RequestedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="font-monospace small">@dto.PurchaseId</td>
                                        <td>@dto.FullName <span class="text-muted small">(@dto.MemberId)</span></td>
                                        <td>@dto.TokenTypeName</td>
                                        <td class="text-end">@dto.Quantity</td>
                                        <td class="text-end">@dto.TotalAmount.ToString("C", Usd)</td>
                                        <td><span class="badge bg-light text-dark">@dto.PaymentMethod</span></td>
                                        <td class="small" title="@dto.Notes">@(dto.Reason ?? "—")</td>
                                        <td class="text-nowrap text-end">
                                            <button class="btn btn-sm btn-outline-success py-0 me-1" @onclick="() => OpenReconcile(dto, true)">Charged</button>
                                            <button class="btn btn-sm btn-outline-danger py-0" @onclick="() => OpenReconcile(dto, false)">Not charged</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </Authorized>
</AuthorizeView>

@if (_confirmTarget is not null || _rejectTarget is not null || _reconcileTarget is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.45)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-3 shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">@ModalTitle</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal" disabled="@_saving"></button>
                </div>
                <div class="modal-body">
                    @if (_modalError is not null)
                    {
                        <div class="alert alert-danger py-2 small">@_modalError</div>
                    }
                    @if (_confirmTarget is not null)
                    {
                        <p class="mb-2"><strong>@_confirmTarget.FullName</strong> — @_confirmTarget.Quantity × @_confirmTarget.TokenTypeName, @_confirmTarget.AmountDue.ToString("C", Usd) in @_confirmTarget.CryptoCurrency</p>
                        <div class="alert alert-warning py-2 small">Confirming issues the tokens. Only do this once the transfer is verified on-chain.</div>
                        <label class="form-label small fw-semibold" for="tp-ref">Transaction id <span class="text-danger">*</span></label>
                        <input id="tp-ref" class="form-control form-control-sm mb-3" @bind="_reference" @bind:event="oninput" maxlength="128" />
                        <label class="form-label small fw-semibold" for="tp-notes">Notes (optional)</label>
                    }
                    else if (_rejectTarget is not null)
                    {
                        <p class="mb-2"><strong>@_rejectTarget.FullName</strong> — @_rejectTarget.Quantity × @_rejectTarget.TokenTypeName, @_rejectTarget.AmountDue.ToString("C", Usd) in @_rejectTarget.CryptoCurrency</p>
                        <div class="alert alert-warning py-2 small">No tokens are issued and the member's monthly quota is released. The order can no longer be confirmed.</div>
                        <label class="form-label small fw-semibold" for="tp-notes">Reason <span class="text-danger">*</span></label>
                    }
                    else
                    {
                        <p class="mb-2"><strong>@_reconcileTarget!.FullName</strong> — @_reconcileTarget.Quantity × @_reconcileTarget.TokenTypeName, @_reconcileTarget.TotalAmount.ToString("C", Usd) (@_reconcileTarget.PaymentMethod)</p>
                        <div class="alert alert-warning py-2 small">
                            @(_charged
                                ? "The money was taken: the tokens will be issued to the member."
                                : "The money was not taken: the purchase is closed and the monthly quota released. No tokens are issued.")
                        </div>
                        <label class="form-label small fw-semibold" for="tp-ref">Gateway reference
                            @if (_charged) { <span class="text-danger">*</span> } else { <span>(optional)</span> }
                        </label>
                        <input id="tp-ref" class="form-control form-control-sm mb-3" @bind="_reference" @bind:event="oninput" maxlength="128" />
                        <label class="form-label small fw-semibold" for="tp-notes">Notes (optional)</label>
                    }
                    <textarea id="tp-notes" class="form-control form-control-sm" rows="3" @bind="_notes" @bind:event="oninput" maxlength="400"></textarea>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal" disabled="@_saving">Cancel</button>
                    <button class="btn @(_rejectTarget is not null || (_reconcileTarget is not null && !_charged) ? "btn-danger" : "btn-success")"
                            disabled="@(!CanSubmit)" @onclick="SubmitAsync">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        @SubmitText
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // Mismo conjunto que AdminTokenPurchasesController y Billing para conciliar.
    private const string TreasuryRoles = "SuperAdmin,Admin,BillingManager";

    // Los importes de la compra son USD (D16): no dependen de la cultura del servidor.
    private static readonly System.Globalization.CultureInfo Usd = System.Globalization.CultureInfo.GetCultureInfo("en-US");

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<CryptoDto> _crypto = new();
    private List<ReviewDto> _review = new();
    private bool _loading = true, _saving, _alertIsError, _charged, _isTreasury;
    private string? _alertMsg, _notes, _modalError;
    private string _reference = string.Empty;
    private CryptoDto? _confirmTarget;
    private CryptoDto? _rejectTarget;
    private ReviewDto? _reconcileTarget;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _isTreasury = TreasuryRoles.Split(',').Any(user.IsInRole);
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _crypto = (await Http.GetFromJsonAsync<ApiResp<List<CryptoDto>>>("api/v1/admin/token-purchases/crypto-pending"))?.Data ?? new();
            // SupportLevel3 aprueba cripto pero no concilia: ni se le pide la lista (la API la negaría).
            _review = _isTreasury
                ? (await Http.GetFromJsonAsync<ApiResp<List<ReviewDto>>>("api/v1/admin/token-purchases/review"))?.Data ?? new()
                : new();
        }
        catch (Exception ex) { _alertMsg = $"Error: {ex.Message}"; _alertIsError = true; }
        finally { _loading = false; }
    }

    private string ModalTitle =>
        _confirmTarget is not null ? "Confirm crypto payment"
        : _rejectTarget is not null ? "Reject crypto payment"
        : _charged ? "Mark as charged" : "Mark as not charged";

    private string SubmitText =>
        _confirmTarget is not null ? "Confirm payment"
        : _rejectTarget is not null ? "Reject"
        : _charged ? "Mark as charged" : "Mark as not charged";

    private bool CanSubmit =>
        !_saving
        && (_confirmTarget is null || !string.IsNullOrWhiteSpace(_reference))
        && (_rejectTarget is null || !string.IsNullOrWhiteSpace(_notes))
        // Marcar como cobrada emite los tokens: tiene que quedar a qué movimiento del gateway responde.
        && (_reconcileTarget is null || !_charged || !string.IsNullOrWhiteSpace(_reference));

    private void OpenConfirm(CryptoDto dto) { Reset(); _confirmTarget = dto; }
    private void OpenReject(CryptoDto dto) { Reset(); _rejectTarget = dto; }
    private void OpenReconcile(ReviewDto dto, bool charged) { Reset(); _reconcileTarget = dto; _charged = charged; }
    private void CloseModal() => Reset();

    private void Reset()
    {
        _confirmTarget = null; _rejectTarget = null; _reconcileTarget = null;
        _reference = string.Empty; _notes = null; _modalError = null;
    }

    private async Task SubmitAsync()
    {
        if (!CanSubmit) return;
        _saving = true;
        _modalError = null;
        try
        {
            var notes     = string.IsNullOrWhiteSpace(_notes) ? null : _notes!.Trim();
            var reference = string.IsNullOrWhiteSpace(_reference) ? null : _reference.Trim();

            HttpResponseMessage resp;
            string done;
            if (_confirmTarget is not null)
            {
                resp = await Http.PostAsJsonAsync(
                    $"api/v1/admin/token-purchases/crypto/{Uri.EscapeDataString(_confirmTarget.OrderId)}/confirm",
                    new { CryptoTransactionId = reference, Notes = notes });
                done = $"Payment confirmed. The tokens were issued to {_confirmTarget.FullName}.";
            }
            else if (_rejectTarget is not null)
            {
                resp = await Http.PostAsJsonAsync(
                    $"api/v1/admin/token-purchases/crypto/{Uri.EscapeDataString(_rejectTarget.OrderId)}/reject",
                    new { Reason = notes });
                done = $"Purchase rejected. {_rejectTarget.FullName}'s monthly quota was released.";
            }
            else
            {
                resp = await Http.PostAsJsonAsync(
                    $"api/v1/admin/token-purchases/{Uri.EscapeDataString(_reconcileTarget!.PurchaseId)}/reconcile",
                    new { Charged = _charged, GatewayReference = reference, Notes = notes });
                done = _charged
                    ? $"Marked as charged. The tokens were issued to {_reconcileTarget.FullName}."
                    : $"Marked as not charged. {_reconcileTarget.FullName}'s monthly quota was released.";
            }

            if (resp.IsSuccessStatusCode)
            {
                _alertMsg = done; _alertIsError = false;
                Reset();
                await LoadAsync();
            }
            else
            {
                var (code, text) = await ErrorTextAsync(resp);
                if (code == "TOKEN_ISSUE_FAILED")
                {
                    // No se guardó nada y se puede reintentar: el modal sigue abierto con lo que se
                    // escribió (referencia, notas) y solo se refresca la lista de detrás.
                    _modalError = text;
                    await LoadAsync();
                }
                else
                {
                    _alertMsg = text;
                    _alertIsError = true;
                    // Si otra persona ya la cerró, la lista que se ve está vieja.
                    if ((int)resp.StatusCode is 404 or 409) { Reset(); await LoadAsync(); }
                }
            }
        }
        catch (Exception ex) { _alertMsg = $"Error: {ex.Message}"; _alertIsError = true; }
        finally { _saving = false; }
    }

    /// <summary>
    /// Los códigos que piden algo distinto de leer el mensaje tienen su texto; el resto, el mensaje de
    /// Billing o AdminAPI tal cual.
    /// </summary>
    private static async Task<(string? Code, string Text)> ErrorTextAsync(HttpResponseMessage resp)
    {
        ApiResp<object>? payload = null;
        try { payload = await resp.Content.ReadFromJsonAsync<ApiResp<object>>(); } catch { /* cuerpo no JSON */ }

        return (payload?.ErrorCode, payload?.ErrorCode switch
        {
            "TOKEN_ISSUE_FAILED"               => "The tokens could not be issued this time and nothing was saved. Please try again.",
            "CRYPTO_PAYMENT_ALREADY_CONFIRMED" => "This payment was already confirmed by someone else.",
            "TOKEN_PURCHASE_NOT_AWAITING_CRYPTO" => "This purchase is no longer waiting for payment (cancelled, rejected or expired).",
            "TOKEN_PURCHASE_NOT_UNDER_REVIEW"  => "This purchase is no longer awaiting reconciliation. Refresh to see its current state.",
            "BILLING_UNAVAILABLE"              => "Billing did not respond. Refresh the list and try again.",
            _ => payload?.Errors?.FirstOrDefault() ?? payload?.Message ?? $"The action failed ({(int)resp.StatusCode})."
        });
    }

    // AdminWeb no referencia AdminAPI a propósito —habla con él por HTTP—, así que el contrato se
    // duplica por forma del JSON, como en AdminCryptoSignups.razor.
    private record ApiResp<T>(bool Success, T? Data, string? Message, string? ErrorCode, IEnumerable<string>? Errors);

    private record CryptoDto(string OrderId, string PurchaseId, string? OrderNo, string MemberId, string FullName, string Email,
        string TokenTypeName, int Quantity, string CryptoCurrency, decimal AmountDue, DateTime RequestedAt);

    private record ReviewDto(string PurchaseId, string? OrderNo, string MemberId, string FullName, string Email, string TokenTypeName,
        int Quantity, decimal TotalAmount, string PaymentMethod, string? Reason, string? Notes, DateTime RequestedAt);
}
