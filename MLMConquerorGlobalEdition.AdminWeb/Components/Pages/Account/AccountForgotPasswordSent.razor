@page "/admin/forgot-password/sent"
@layout MLMConquerorGlobalEdition.SharedComponents.Components.Layout.BlankLayout
@using MLMConquerorGlobalEdition.SharedComponents.Components.Account
@using Microsoft.Extensions.Localization
@using MLMConquerorGlobalEdition.SharedComponents.Resources
@inject IStringLocalizer<SharedResources> L

@* Aterrizaje tras pedir el correo de recuperación. Enseña el mismo mensaje ambiguo exista o no
   la cuenta, que es lo que impide usar aquel formulario para averiguar qué direcciones están
   registradas. No recibe la dirección por la URL a propósito: es un dato de más en una pantalla
   que no tiene que confirmar nada sobre esa cuenta. *@

<PageTitle>@L["ForgotPasswordConfirmation.Title"]</PageTitle>

<div class="login-wrapper-admin">
    <div class="login-card-admin">
        <div class="login-logo">
            <h2 class="text-white">MLM Conqueror</h2>
            <p class="text-muted">Administration Portal</p>
        </div>

        <ForgotPasswordConfirmation LoginUrl="/admin/login" />
    </div>
</div>
