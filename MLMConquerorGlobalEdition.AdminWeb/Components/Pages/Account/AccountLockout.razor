@page "/admin/lockout"
@layout MLMConquerorGlobalEdition.SharedComponents.Components.Layout.BlankLayout
@using MLMConquerorGlobalEdition.SharedComponents.Components.Account
@using Microsoft.Extensions.Localization
@using MLMConquerorGlobalEdition.SharedComponents.Resources
@inject IStringLocalizer<SharedResources> L

@* Cuenta bloqueada temporalmente por intentos fallidos. Deliberadamente vaga en cuánto falta
   para desbloquear: decirlo es decirle a quien está probando contraseñas cuánto tiene que
   esperar para seguir probando. *@

<PageTitle>@L["Lockout.Title"]</PageTitle>

<div class="login-wrapper-admin">
    <div class="login-card-admin">
        <div class="login-logo">
            <h2 class="text-white">MLM Conqueror</h2>
            <p class="text-muted">Administration Portal</p>
        </div>

        <Lockout LoginUrl="/admin/login" />
    </div>
</div>
