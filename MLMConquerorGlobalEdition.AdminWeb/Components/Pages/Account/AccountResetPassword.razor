@page "/admin/reset-password"
@page "/auth/reset-password"
@layout MLMConquerorGlobalEdition.SharedComponents.Components.Layout.BlankLayout
@using MLMConquerorGlobalEdition.SharedComponents.Components.Account
@using Microsoft.Extensions.Localization
@using MLMConquerorGlobalEdition.SharedComponents.Resources
@inject IStringLocalizer<SharedResources> L

@* Cambio de contraseña con el enlace del correo.

   Dos rutas: /auth/reset-password es la que escribe ForgotPasswordHandler en el enlace del
   correo, y /admin/reset-password la conserva por si algo enlaza a la forma vieja. Mismo patrón
   que AccountConfirmEmail.

   Se aceptan DOS nombres para el identificador de la query: `userId`, que es el que trae el
   enlace, y `email`, que aceptaba la forma anterior. ResetPasswordRequest admite ambos y prefiere
   userId, así que esta página reenvía el que venga.

   Sin @@rendermode: SSR estático, igual que el resto de las pantallas anónimas de cuenta. *@

<PageTitle>@L["PageTitle.ResetPassword"]</PageTitle>

<div class="login-wrapper-admin">
    <div class="login-card-admin">
        <div class="login-logo">
            <h2 class="text-white">MLM Conqueror</h2>
            <p class="text-muted">Administration Portal</p>
        </div>

        <ResetPassword UserId="@(string.IsNullOrWhiteSpace(UserId) ? Email : UserId)"
                       Token="@Token"
                       FormAction="/account/reset-password"
                       ErrorCode="@Error"
                       RequestNewLinkUrl="/admin/forgot-password"
                       CancelUrl="/admin/login" />
    </div>
</div>

@code {
    /// <summary>Identificador tal cual viene en el enlace del correo.</summary>
    [SupplyParameterFromQuery]
    public string? UserId { get; set; }

    /// <inheritdoc cref="UserId"/>
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    [SupplyParameterFromQuery]
    public string? Error { get; set; }
}
