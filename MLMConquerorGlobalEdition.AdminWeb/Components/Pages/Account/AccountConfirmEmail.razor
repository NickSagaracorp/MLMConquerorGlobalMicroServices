@page "/admin/auth/confirm-email"
@page "/auth/confirm-email"
@layout MLMConquerorGlobalEdition.SharedComponents.Components.Layout.BlankLayout
@using MLMConquerorGlobalEdition.SharedComponents.Components.Account
@using Microsoft.Extensions.Localization
@using MLMConquerorGlobalEdition.SharedComponents.Resources
@inject AccountPageData PageData
@inject IStringLocalizer<SharedResources> L

@* Destino del enlace del correo de confirmación de dirección.

   DOS RUTAS, A PROPÓSITO. `SendEmailConfirmationHandler` construye el enlace como
   {Auth:AdminPortalBaseUrl}/auth/confirm-email?userId=…&token=…, y ese ajuste vale hoy
   "https://localhost:7001" — la raíz de este portal, sin /admin. Con solo /admin/auth/confirm-email
   registrada, todo correo de confirmación de personal interno llevaría a un 404. Se registran las
   dos: la de /admin porque es la que pide el inventario de rutas del portal, y la de la raíz
   porque es la que de verdad va escrita dentro de los correos ya emitidos.

   La confirmación se ejecuta AQUÍ, durante el render, y no en un endpoint: es un GET —el usuario
   llega pinchando un enlace, no enviando un formulario— y lo que hay que enseñar es el resultado
   de esa llamada, no una redirección a otra pantalla que lo repita.

   No se ofrece reenviar: POST /api/v1/auth/email/send-confirmation necesita el correo de la
   cuenta y el enlace solo trae el userId, así que no hay forma de rellenar esa llamada desde
   aquí. Queda reportado. *@

<PageTitle>@Title</PageTitle>

<div class="login-wrapper-admin">
    <div class="login-card-admin">
        <div class="login-logo">
            <h2 class="text-white">MLM Conqueror</h2>
            <p class="text-muted">Administration Portal</p>
        </div>

        @if (_status is null)
        {
            <div class="alert alert-info" role="status">@L["Common.Loading"]</div>
        }
        else
        {
            <ConfirmEmail Status="@_status" LoginUrl="/admin/login" />
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private string? _status;

    protected override async Task OnInitializedAsync() =>
        _status = await PageData.ConfirmEmailAsync(UserId, Token);

    /// <summary>
    /// El título sigue al resultado: una pestaña que dice "correo confirmado" sobre una pantalla
    /// que dice que el enlace caducó es exactamente la clase de contradicción que hace dudar al
    /// usuario de cuál de las dos cosas es verdad.
    /// </summary>
    private string Title =>
        AccountMessages.IsConfirmEmailSuccess(_status) ? L["ConfirmEmail.SuccessTitle"]
        : AccountMessages.IsConfirmEmailExpired(_status) ? L["ConfirmEmail.ExpiredTitle"]
        :                                                  L["ConfirmEmail.InvalidTitle"];
}
