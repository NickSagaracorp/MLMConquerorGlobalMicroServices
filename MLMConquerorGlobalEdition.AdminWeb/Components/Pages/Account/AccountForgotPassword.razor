@page "/admin/forgot-password"
@layout MLMConquerorGlobalEdition.SharedComponents.Components.Layout.BlankLayout
@using MLMConquerorGlobalEdition.SharedComponents.Components.Account
@using Microsoft.Extensions.Localization
@using MLMConquerorGlobalEdition.SharedComponents.Resources
@inject IStringLocalizer<SharedResources> L

@* "He olvidado mi contraseña" del portal de administración.

   Sin @@rendermode, igual que Login.razor: SSR estático. El formulario postea a un endpoint
   mínimo y no hay nada en la pantalla que necesite un circuito interactivo.

   Las clases .login-wrapper-admin / .login-card-admin / .login-logo viven en wwwroot/app.css y
   las comparten esta página, /admin/login y las demás pantallas anónimas de cuenta. *@

<PageTitle>@L["PageTitle.ForgotPassword"]</PageTitle>

<div class="login-wrapper-admin">
    <div class="login-card-admin">
        <div class="login-logo">
            <h2 class="text-white">MLM Conqueror</h2>
            <p class="text-muted">Administration Portal</p>
        </div>

        <ForgotPassword FormAction="/account/forgot-password"
                        ErrorCode="@Error"
                        CancelUrl="/admin/login" />
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }
}
