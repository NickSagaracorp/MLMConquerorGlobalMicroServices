    // ── DTOs ─────────────────────────────────────────────────────────────────
    private record CountryDto(
        int Id, string Iso2, string Iso3, string NameEn, string NameNative,
        string DefaultLanguageCode, string FlagEmoji, string? PhoneCode,
        bool IsActive, int SortOrder, int? RegionId, string? RegionName);

    private record RegionOption(int Id, string Name, string Code);

    private record CountryProductDto(int MappingId, string ProductId, string ProductName, bool IsActive);

    private record ProductDto(string Id, string Name, bool IsActive, bool JoinPageMembership, bool CorporateFee);

    private record ApiResp<T>(bool Success, T? Data, IEnumerable<string>? Errors);

    private record PagedResult<T>(IEnumerable<T> Items, int TotalCount, int Page, int PageSize);

    // ── Default Payout Gateway state ─────────────────────────────────────────
    private bool                _showPayoutDefault;
    private bool                _loadingPayoutDefault;
    private bool                _savingPayoutDefault;
    private CountryDto?         _payoutCountry;
    private int?                _payoutExistingId;
    private PayoutDefaultForm   _payoutForm = new();

    // Snapshot of the WalletType as opened, used to detect a change at save time.
    // Null when creating a new row (no existing wallets to migrate either way).
    private string?             _payoutOriginalWalletType;

    // Retroactive confirmation modal — only shown on edit when the WalletType changed.
    private bool                _showRetroactiveConfirm;
    private bool                _loadingRetroactivePreview;
    private int                 _retroactivePreviewCount;
    private bool                _applyRetroactively;

    // Esto elige el gateway por defecto de un país, así que sólo lista gateways que se
    // pueden dar de alta HOY. Dwolla está retirado y no aparece a propósito; Advancash
    // se fusionó en Volet.
    private static readonly string[] _walletTypeOptions = new[]
    {
        "Propay",  "WireTransferCanada", "eWallet",   "Paypal",
        "Volet",   "Yestransfer",        "Crypto",    "PayQuicker"
    };

    private async Task OpenPayoutDefault(CountryDto c)
    {
        _payoutCountry            = c;
        _showPayoutDefault        = true;
        _loadingPayoutDefault     = true;
        _payoutExistingId         = null;
        _payoutOriginalWalletType = null;
        _payoutForm               = new PayoutDefaultForm();
        try
        {
            // Pull the full list once (same endpoint the dedicated payout
            // page uses) and pick the row matching this country. The list is
            // small (<= 250 countries) so this is cheaper than adding a
            // dedicated GET /{iso2} just for the modal.
            var resp = await Http.GetFromJsonAsync<ApiResp<List<CountryPayoutDefaultDto>>>(
                "api/v1/admin/payout-defaults");
            var existing = resp?.Success == true && resp.Data is not null
                ? resp.Data.FirstOrDefault(r => string.Equals(r.CountryIso2, c.Iso2, StringComparison.OrdinalIgnoreCase))
                : null;
            if (existing is not null)
            {
                _payoutExistingId         = existing.Id;
                _payoutOriginalWalletType = existing.WalletType;
                _payoutForm = new PayoutDefaultForm
                {
                    WalletType = existing.WalletType,
                    IsActive   = existing.IsActive,
                    Notes      = existing.Notes
                };
            }
        }
        catch (Exception ex) { ShowAlert($"Error loading payout default: {ex.Message}", isError: true); }
        finally { _loadingPayoutDefault = false; }
    }

    private void ClosePayoutDefault()
    {
        _showPayoutDefault         = false;
        _payoutCountry             = null;
        _payoutExistingId          = null;
        _payoutForm                = new();
        _payoutOriginalWalletType  = null;
        _showRetroactiveConfirm    = false;
        _retroactivePreviewCount   = 0;
        _applyRetroactively        = false;
    }

    private async Task SavePayoutDefault()
    {
        if (_payoutCountry is null) return;

        // Edit + WalletType actually changed → fork into the confirmation flow.
        // The retroactive question is meaningless on create (no existing wallets).
        var walletTypeChanged =
            _payoutExistingId.HasValue
            && _payoutOriginalWalletType is not null
            && !string.Equals(_payoutForm.WalletType, _payoutOriginalWalletType, StringComparison.OrdinalIgnoreCase);

        if (walletTypeChanged)
        {
            await OpenRetroactiveConfirmAsync();
            return;
        }

        // Plain path: create OR edit without a wallet-type change.
        await PerformSavePayoutDefaultAsync(applyRetroactively: false);
    }

    private async Task OpenRetroactiveConfirmAsync()
    {
        // Default to the safer option until the admin opts in.
        _applyRetroactively        = false;
        _retroactivePreviewCount   = 0;
        _showRetroactiveConfirm    = true;
        _loadingRetroactivePreview = true;
        StateHasChanged();

        try
        {
            var url = $"api/v1/admin/payout-defaults/{_payoutExistingId!.Value}/retroactive-preview" +
                      $"?newWalletType={Uri.EscapeDataString(_payoutForm.WalletType)}";
            var resp = await Http.GetFromJsonAsync<ApiResp<RetroactivePreviewDto>>(url);
            if (resp?.Success == true && resp.Data is not null)
                _retroactivePreviewCount = resp.Data.AffectedWalletCount;
        }
        catch (Exception ex)
        {
            // Preview is informational — keep the modal open with count = 0
            // so the admin can still confirm. Surface the issue in the page alert.
            ShowAlert($"Could not load retroactive preview: {ex.Message}", isError: true);
        }
        finally { _loadingRetroactivePreview = false; }
    }

    private void CancelRetroactiveConfirm()
    {
        // Closes JUST the confirmation modal; the underlying Save modal stays
        // open so the admin can still tweak the form.
        _showRetroactiveConfirm  = false;
        _applyRetroactively      = false;
        _retroactivePreviewCount = 0;
    }

    private Task ConfirmRetroactiveSave()
        => PerformSavePayoutDefaultAsync(applyRetroactively: _applyRetroactively);

    private async Task PerformSavePayoutDefaultAsync(bool applyRetroactively)
    {
        if (_payoutCountry is null) return;
        _savingPayoutDefault = true;
        try
        {
            var payload = new
            {
                CountryIso2        = _payoutCountry.Iso2,
                WalletType         = _payoutForm.WalletType,
                IsActive           = _payoutForm.IsActive,
                Notes              = _payoutForm.Notes,
                ApplyRetroactively = applyRetroactively
            };

            HttpResponseMessage resp = _payoutExistingId.HasValue
                ? await Http.PutAsJsonAsync($"api/v1/admin/payout-defaults/{_payoutExistingId.Value}", payload)
                : await Http.PostAsJsonAsync("api/v1/admin/payout-defaults", payload);

            if (resp.IsSuccessStatusCode)
            {
                // Read the migrated-count from the PUT response so we can show it.
                var migrated = 0;
                if (applyRetroactively && _payoutExistingId.HasValue)
                {
                    try
                    {
                        var body = await resp.Content.ReadFromJsonAsync<ApiResp<UpdateResultDto>>();
                        migrated = body?.Data?.RetroactiveWalletsUpdated ?? 0;
                    }
                    catch { /* shape mismatch is non-fatal — just skip the count */ }
                }

                var msg = $"Default gateway saved for {_payoutCountry.NameEn}.";
                if (applyRetroactively && migrated > 0)
                    msg += $" Migrated {migrated} existing wallet{(migrated == 1 ? "" : "s")}.";

                ShowAlert(msg, isError: false);
                ClosePayoutDefault();
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                ShowAlert($"Save failed ({(int)resp.StatusCode}): {body}", isError: true);
            }
        }
        catch (Exception ex) { ShowAlert($"Error saving payout default: {ex.Message}", isError: true); }
        finally { _savingPayoutDefault = false; }
    }

    private async Task RemovePayoutDefault()
    {
        if (_payoutExistingId is null) return;
        _savingPayoutDefault = true;
        try
        {
            var resp = await Http.DeleteAsync($"api/v1/admin/payout-defaults/{_payoutExistingId.Value}");
            if (resp.IsSuccessStatusCode)
            {
                ShowAlert($"Default gateway cleared for {_payoutCountry?.NameEn ?? "country"}.", isError: false);
                ClosePayoutDefault();
            }
            else
            {
                ShowAlert($"Remove failed ({(int)resp.StatusCode}).", isError: true);
            }
        }
        catch (Exception ex) { ShowAlert($"Error removing payout default: {ex.Message}", isError: true); }
        finally { _savingPayoutDefault = false; }
    }

    private class PayoutDefaultForm
    {
        public string  WalletType { get; set; } = "eWallet";
        public bool    IsActive   { get; set; } = true;
        public string? Notes      { get; set; }
    }

    private class CountryPayoutDefaultDto
    {
        public int     Id          { get; set; }
        public string  CountryIso2 { get; set; } = string.Empty;
        public string  CountryName { get; set; } = string.Empty;
        public string  WalletType  { get; set; } = string.Empty;
        public bool    IsActive    { get; set; }
        public string? Notes       { get; set; }
    }

    private class RetroactivePreviewDto
    {
        public string CountryIso2         { get; set; } = string.Empty;
        public string OldWalletType       { get; set; } = string.Empty;
        public string NewWalletType       { get; set; } = string.Empty;
        public int    AffectedWalletCount { get; set; }
    }

    private class UpdateResultDto
    {
        public int Id                          { get; set; }
        public int RetroactiveWalletsUpdated   { get; set; }
    }
}
