{
  // Cifrado de las CREDENCIALES DE GATEWAY (PayQuicker, i-Payout, ...).
  //
  // El key ring vive en la tabla DataProtectionKeys de la misma base que AdminAPI y Billing
  // ya comparten, y esas llaves están envueltas con este certificado X.509. Son dos factores
  // separados: un backup de la base NO alcanza para descifrar sin la clave privada.
  //
  // Ambos servicios deben usar EL MISMO certificado. En producción se prefiere Thumbprint
  // (almacén de Windows, la clave privada nunca toca el disco de la app); Path es la
  // alternativa por archivo PFX. En Development, si el PFX no existe se genera uno solo.
  //
  // Documentación para IT: artículo de KB "gateway-credential-encryption".
  "DataProtection": {
    "Certificate": {
      "Thumbprint": "",
      "Path": "%LOCALAPPDATA%/MLMConqueror/DataProtection/gateway-credentials-dev.pfx",
      "Password": ""
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=MLMConquerorGlobalEditionDb;integrated security=true;TrustServerCertificate=True;MultipleActiveResultSets=true;Encrypt=True;",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "PrivateKeyBase64": "",
    "PublicKeyBase64": "",
    "Issuer": "MLMConquerorGlobalEdition",
    "Audience": "MLMConquerorGlobalEdition.Clients",
    "AccessTokenExpiryMinutes": 120,
    "RefreshTokenExpiryDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7002",
      "https://localhost:7004"
    ]
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "//": "Aquí ya no hay reglas para /api/v1/auth/*: AdminAPI no tiene puerta de entrada. La autenticación entera —login, segundo factor, refresco, recuperación— vive en SignupAPI, y sus límites por IP están en el appsettings de SignupAPI. Dejarlas aquí haría pensar que este servicio sigue teniendo login.",
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1s",
        "Limit": 20
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "Notifications": {
    "Email": { "Provider": "Null", "Ses": { "Region": "us-east-1", "FromAddress": "", "FromName": "MLM Conqueror" } },
    "Sms":   { "Provider": "Null", "Twilio": { "AccountSid": "", "AuthToken": "", "FromNumber": "" } }
  },
  "Services": {
    "BizCenter": "https://localhost:7003",
    "CommissionEngine": "https://localhost:7008",
    "RankEngine": "https://localhost:7009",
    "SignupAPI": "https://localhost:7005",
    "TicketManagementSystem": "https://localhost:7010",
    "Billing": "https://localhost:7007",
    "SharedAPICenter": "https://localhost:7011"
  }
}