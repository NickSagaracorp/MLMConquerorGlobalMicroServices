{
  // Cifrado de las CREDENCIALES DE GATEWAY. BizCenter da de alta la cuenta del ambassador
  // en el proveedor cuando elige su metodo de cobro, asi que lee las mismas credenciales
  // que AdminAPI escribe y Billing usa. Los TRES hosts deben apuntar al MISMO certificado.
  // Documentacion para IT: articulo de KB "gateway-credential-encryption".
  "DataProtection": {
    "Certificate": {
      "Thumbprint": "",
      "Path": "%LOCALAPPDATA%/MLMConqueror/DataProtection/gateway-credentials-dev.pfx",
      "Password": ""
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=MLMConquerorGlobalEditionDb;integrated security=true;TrustServerCertificate=True;MultipleActiveResultSets=true;Encrypt=True;",
    "HangFire": "Server=.;Database=MLMConquerorGlobalEditionDb;integrated security=true;TrustServerCertificate=True;MultipleActiveResultSets=true;Encrypt=True;",
    "Redis": "localhost:6379"
  },
  "Hangfire": {
    "WorkerCount": 5
  },
  "Firebase": {
    "CredentialsFilePath": "",
    "ProjectId": "REPLACE_WITH_FIREBASE_PROJECT_ID"
  },
  "Tokens": {
    "ValidityDays": 365
  },
  "Jwt": {
    "PublicKeyBase64": "",
    "Issuer": "MLMConquerorGlobalEdition",
    "Audience": "MLMConquerorGlobalEdition.Clients",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7004",
      "https://localhost:7002"
    ]
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "POST:/api/v1/auth/login",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "POST:/api/v1/auth/refresh-token",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "POST:/api/v1/auth/forgot-password",
        "Period": "1h",
        "Limit": 3
      },
      {
        "Endpoint": "*",
        "Period": "1s",
        "Limit": 20
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost"
}